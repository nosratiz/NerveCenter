@* src/Plugins/SbConsole.Plugins.Sqlite/Pages/Backups.razor -- mockups 1e (Backups) and 1f (restore
   dialog), design spec §11.7. Everything goes through the Backups handlers: Back up now, Verify and
   Download are Safe; Schedule… is Mutating; Prune and Restore are Destructive and confirm first
   (typed on prod; IsProd from the picker's server-side ConnectionInfo). Restore also needs a
   read-write connection, which the operations re-check from the secret. *@
@page "/p/sqlite/backups"
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using SbConsole.Plugins.Sqlite.Backups
@using SbConsole.Plugins.Sqlite.Client
@inject GetBackupsQueryHandler GetBackups
@inject RunBackupCommandHandler RunBackup
@inject VerifyBackupCommandHandler VerifyBackup
@inject PruneBackupsCommandHandler PruneBackups
@inject DownloadBackupCommandHandler DownloadBackup
@inject RestoreBackupCommandHandler RestoreBackup
@inject SaveBackupPolicyCommandHandler SavePolicy
@inject IConnectionProvider Connections
@inject IConfirmationService Confirmation
@inject TimeProvider Clock
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>SQLite backups</PageTitle>

<div class="sql-page">
    <SqlitePageHeader Title="Backups">
        <Chips>
            <SqliteConnectionPicker Loading="@(_loading || _running != BusyAction.None)" SelectionChanged="OnSelectionChangedAsync" />
        </Chips>
        <Meta>
            @if (_overview is { BackupDir: { } dir } meta)
            {
                <span class="sqlite-backups-meta">target @dir · @meta.Kept kept · @SqliteFormat.Bytes(meta.TotalBytes)</span>
            }
        </Meta>
        <Actions>
            @if (_connection is not null)
            {
                <span class="sql-btn-wrap" title="@(Enabled ? null : SqliteOperations.BackupsNotEnabled)">
                    <button type="button" class="sql-btn sqlite-backups-schedule" disabled="@(!Enabled || Busy)" @onclick="OpenSchedule">Schedule…</button>
                </span>
                <span class="sql-btn-wrap" title="@(Enabled ? null : SqliteOperations.BackupsNotEnabled)">
                    <button type="button" class="sql-btn sql-btn-primary sqlite-backups-now" disabled="@(!Enabled || Busy)" @onclick="OpenBackupNow">
                        @(_running == BusyAction.Backup ? "Backing up…" : "Back up now")
                    </button>
                </span>
            }
        </Actions>
    </SqlitePageHeader>

    @if (_notice is not null)
    {
        <div class="sql-body sql-body-tight">
            <div class="sql-notice sqlite-backups-notice" role="status">@_notice</div>
        </div>
    }

    @if (_actionError is not null)
    {
        <div class="sql-body sql-body-tight">
            <MudAlert Severity="Severity.Warning" Dense="true" Class="sqlite-backups-action-error">@_actionError</MudAlert>
        </div>
    }

    @if (_dialog != BackupDialog.None && _connection is { } dialogConnection)
    {
        <div class="sql-body sql-body-tight">
            @switch (_dialog)
            {
                case BackupDialog.BackupNow:
                    <div class="sql-dialog sqlite-backup-now-dialog" role="dialog" aria-label="Back up now">
                        <div class="sql-dialog-title">Back up now</div>
                        <div class="sql-footnote">
                            <span class="sql-mono">VACUUM INTO</span> a new file in <span class="sql-mono">@_overview?.BackupDir</span> on a read-only
                            connection — writers keep going — then verified. Audited (<span class="sql-mono">@RunBackupCommandHandler.Action</span>).
                        </div>
                        <input class="sql-input sqlite-backup-note" aria-label="Note (optional)" placeholder="Note (optional), e.g. before migration 0039"
                               maxlength="200" value="@_note" @oninput="e => _note = e.Value?.ToString() ?? string.Empty" />
                        @if (_dialogError is not null)
                        {
                            <MudAlert Severity="Severity.Error" Dense="true" Class="sqlite-dialog-error">@_dialogError</MudAlert>
                        }
                        <div class="sql-actions">
                            <button type="button" class="sql-btn sqlite-dialog-cancel" disabled="@Busy" @onclick="CloseDialog">Cancel</button>
                            <button type="button" class="sql-btn sql-btn-primary sqlite-backup-now-submit" disabled="@Busy" @onclick="BackUpNowAsync">
                                @(_running == BusyAction.Backup ? "Backing up…" : "Back up now")
                            </button>
                        </div>
                    </div>
                    break;

                case BackupDialog.Schedule:
                    <div class="sql-dialog sqlite-schedule-dialog" role="dialog" aria-label="Backup schedule">
                        <div class="sql-dialog-title">Schedule and retention</div>
                        <label class="sql-check">
                            <input type="checkbox" class="sqlite-schedule-enabled" checked="@_scheduleEnabled" @onchange="e => _scheduleEnabled = e.Value is true" />
                            <span>Back up daily at</span>
                            <input class="sql-input sql-input-short sqlite-schedule-time" aria-label="Daily at (HH:mm, UTC)" maxlength="5" spellcheck="false"
                                   value="@_scheduleTime" @oninput="e => _scheduleTime = e.Value?.ToString() ?? string.Empty" />
                            <span class="sql-muted">UTC</span>
                        </label>
                        <div class="sql-schedule-keep">
                            <span>Keep</span>
                            <input class="sql-input sql-input-short sqlite-schedule-daily" aria-label="Daily backups to keep" inputmode="numeric"
                                   value="@_keepDaily" @oninput="e => _keepDaily = e.Value?.ToString() ?? string.Empty" />
                            <span class="sql-muted">daily ·</span>
                            <input class="sql-input sql-input-short sqlite-schedule-weekly" aria-label="Weekly backups to keep" inputmode="numeric"
                                   value="@_keepWeekly" @oninput="e => _keepWeekly = e.Value?.ToString() ?? string.Empty" />
                            <span class="sql-muted">weekly ·</span>
                            <input class="sql-input sql-input-short sqlite-schedule-monthly" aria-label="Monthly backups to keep" inputmode="numeric"
                                   value="@_keepMonthly" @oninput="e => _keepMonthly = e.Value?.ToString() ?? string.Empty" />
                            <span class="sql-muted">monthly</span>
                        </div>
                        <div class="sql-footnote">
                            The scheduler takes one backup a day after the slot, verifies it and prunes by these counts (the newest per day,
                            ISO week and month; the newest successful backup is always kept). It runs inside SbConsole — no backups while
                            the app is down. Audited (<span class="sql-mono">@SaveBackupPolicyCommandHandler.Action</span>).
                        </div>
                        @if (_dialogError is not null)
                        {
                            <MudAlert Severity="Severity.Error" Dense="true" Class="sqlite-dialog-error">@_dialogError</MudAlert>
                        }
                        <div class="sql-actions">
                            <button type="button" class="sql-btn sqlite-dialog-cancel" disabled="@Busy" @onclick="CloseDialog">Cancel</button>
                            <button type="button" class="sql-btn sql-btn-primary sqlite-schedule-save" disabled="@Busy" @onclick="SavePolicyAsync">
                                @(_running == BusyAction.Policy ? "Saving…" : "Save")
                            </button>
                        </div>
                    </div>
                    break;

                case BackupDialog.Restore when Selected is { FileName: { } restoreFile } restoring:
                    <div class="sql-dialog sql-dialog-danger sqlite-restore-dialog" role="dialog" aria-label="Restore backup">
                        <div class="sql-dialog-title">Restore backup</div>
                        <div>
                            Replace <span class="sql-mono">@(_livePath ?? LiveFileName)</span> with <span class="sql-mono">@restoreFile</span>.
                            The backup is verified first; writers are blocked for the copy (about @SqliteFormat.Duration(TimeSpan.FromMilliseconds(restoring.DurationMs))).
                            The current file is kept next to it as <span class="sql-mono">@($"{LiveFileName}.pre-restore-{Clock.GetUtcNow().UtcDateTime.ToString("yyyyMMdd-HHmmss", Inv)}")</span>.
                        </div>
                        <div class="sql-warn sqlite-restore-loss">@LossText(restoring)</div>
                        <div class="sql-report-row"><span class="sql-report-label">Target</span><span class="sql-mono">@dialogConnection.Name</span></div>
                        @if (dialogConnection.IsProd)
                        {
                            <div class="sql-footnote">This is a <span class="sql-prod">prod</span> file: you'll be asked to type the connection's name.</div>
                        }
                        @if (_dialogError is not null)
                        {
                            <MudAlert Severity="Severity.Error" Dense="true" Class="sqlite-dialog-error">@_dialogError</MudAlert>
                        }
                        <div class="sql-actions">
                            <button type="button" class="sql-btn sqlite-dialog-cancel" disabled="@Busy" @onclick="CloseDialog">Cancel</button>
                            <button type="button" class="sql-btn sql-btn-danger sqlite-restore-submit" disabled="@Busy" @onclick="RestoreAsync">
                                @(_running == BusyAction.Restore ? "Restoring…" : "Continue…")
                            </button>
                        </div>
                    </div>
                    break;
            }
        </div>
    }

    @if (_error is not null)
    {
        <div class="sql-body">
            <div class="sql-banner sql-banner-danger sqlite-backups-error">
                <span class="sqlite-backups-error-text" role="alert">@_error</span>
                <span class="sql-spacer"></span>
                <a class="sql-link" href="/connections">Connection settings</a>
                <button type="button" class="sql-btn sqlite-backups-retry" @onclick="() => LoadAsync()">Retry</button>
            </div>
        </div>
    }
    else if (_overview is { BackupDir: null })
    {
        <div class="sql-empty sqlite-backups-disabled">
            <div class="sql-empty-title">Backups aren't enabled for @_connection?.Name</div>
            <div class="sql-muted">
                Set <strong>Enable backups to</strong> on the connection (Connections) to a directory the SbConsole container can write to.
                It must be under <span class="sql-mono">SBC_SQLITE_ROOTS</span> (inside a root, not a root itself) and may be the live file's own
                directory. Copies are named <span class="sql-mono">&lt;file&gt;-&lt;yyyyMMdd-HHmmss&gt;.db</span>.
            </div>
            <div class="sql-actions sql-actions-center">
                <a class="sql-btn" href="/connections">Connections</a>
            </div>
        </div>
    }
    else if (_overview is { } o)
    {
        <div class="sql-tiles sql-bk-tiles">
            <SqliteStatTile Label="Last successful" Class="sqlite-backups-last" ValueClass="sqlite-backups-last-age">
                <Value>@(o.Schedule.LastSuccess is { } last ? $"{SqliteFormat.Age(Clock.GetUtcNow() - last.TakenAt)} ago" : "none yet")</Value>
                <Caption>
                    @if (o.PolicySaved && o.Policy.Enabled)
                    {
                        <span>policy: daily @o.Policy.DailyAtUtc UTC</span>
                        @if (o.Schedule.MissedSlots > 0)
                        {
                            <span class="sql-warn"> · missed @o.Schedule.MissedSlots</span>
                        }
                        @if (o.Schedule.Overdue)
                        {
                            <span class="sql-warn"> · overdue</span>
                        }
                    }
                    else
                    {
                        <span>no schedule — Schedule… to enable</span>
                    }
                </Caption>
            </SqliteStatTile>

            <SqliteStatTile Label="Method" Class="sqlite-backups-method">
                <Value><span class="sql-mono sql-tile-mono">VACUUM INTO</span></Value>
                <Caption>online · compacts on the way out</Caption>
            </SqliteStatTile>

            <SqliteStatTile Label="Verified" Class="sqlite-backups-verified" ValueClass="sqlite-backups-verified-count">
                <Value>@o.VerifiedOk / @o.Kept</Value>
                <Caption><span class="sql-mono">integrity_check</span> on each copy</Caption>
            </SqliteStatTile>

            <SqliteStatTile Label="Retention" Class="sqlite-backups-retention" ValueClass="sqlite-backups-retention-value">
                <Value>@o.Policy.KeepDaily.ToString(Inv)d · @o.Policy.KeepWeekly.ToString(Inv)w · @o.Policy.KeepMonthly.ToString(Inv)m</Value>
                <Caption>
                    next prune removes @o.PrunePreview.Count@(o.PruneBytes > 0 ? $" ({SqliteFormat.Bytes(o.PruneBytes)})" : "")
                    · <button type="button" class="sql-link sqlite-backups-prune" disabled="@(o.PrunePreview.Count == 0 || Busy)" @onclick="PruneAsync">
                        @(_running == BusyAction.Prune ? "pruning…" : "Prune")
                    </button>
                </Caption>
            </SqliteStatTile>
        </div>

        <div class="sql-body">
            @if (Newest(o) is { Succeeded: false } failed)
            {
                <div class="sql-banner sql-banner-danger sqlite-backups-failed" role="alert">
                    <span>
                        <strong>Last backup failed</strong> (@failed.TakenAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm", Inv) UTC, @failed.Trigger): @failed.Error
                        @if (OffersPruneRetry(o, failed))
                        {
                            <text> Pruning the @o.PrunePreview.Count expired @(o.PrunePreview.Count == 1 ? "copy" : "copies") frees @SqliteFormat.Bytes(o.PruneBytes); then retry.</text>
                        }
                    </span>
                    <span class="sql-spacer"></span>
                    @if (OffersPruneRetry(o, failed))
                    {
                        <button type="button" class="sql-btn sqlite-backups-prune-retry" disabled="@Busy" @onclick="PruneAndRetryAsync">Prune @o.PrunePreview.Count and retry</button>
                    }
                </div>
            }

            @if (_restored is { } restored)
            {
                <div class="sql-report @(restored.Outcome.IntegrityOk ? "sql-report-ok" : "sql-report-warn") sqlite-restore-result" role="status">
                    <div class="sql-overline">Restored</div>
                    <div class="sql-report-row"><span class="sql-report-label">From</span><span class="sql-mono">@restored.FileName</span></div>
                    <div class="sql-report-row"><span class="sql-report-label">Previous file</span><span class="sql-mono">kept as @restored.Outcome.PreRestoreFileName</span></div>
                    <div class="sql-report-row">
                        <span class="sql-report-label">Live file now</span>
                        <span class="sql-mono">@RestoredText(restored.Outcome)</span>
                    </div>
                </div>
            }

            @if (o.History.Count == 0)
            {
                <div class="sql-footnote sqlite-backups-empty">No backups yet — <strong>Back up now</strong> takes the first one; Schedule… makes it daily.</div>
            }
            else
            {
                <div class="sql-bk-split @(Selected is null ? "sql-bk-split-single" : null)">
                    <div class="sql-grid-wrap">
                        <table class="sql-table sqlite-backups-history">
                            <thead><tr><th>Taken (UTC)</th><th class="sql-num">Size</th><th class="sql-num">Took</th><th>Verify</th><th>Trigger</th></tr></thead>
                            <tbody>
                                @foreach (var record in o.History)
                                {
                                    <tr class="sql-row-click sqlite-backup-row @(record.Id == _selectedId ? "sql-is-selected" : null)" data-id="@record.Id"
                                        aria-selected="@(record.Id == _selectedId ? "true" : "false")" @onclick="() => SelectRecord(record)">
                                        <td class="sql-mono sqlite-backup-taken">@record.TakenAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm", Inv)</td>
                                        <td class="sql-num sql-mono sqlite-backup-size">@(record.Succeeded ? SqliteFormat.Bytes(record.Bytes) : "—")</td>
                                        <td class="sql-num sql-mono sqlite-backup-took">@(record.Succeeded ? SqliteFormat.Duration(TimeSpan.FromMilliseconds(record.DurationMs)) : "—")</td>
                                        <td><span class="sql-badge @VerifyBadgeClass(record) sqlite-backup-verify">@VerifyLabel(record)</span></td>
                                        <td>
                                            <span class="sqlite-backup-trigger">@TriggerText(record)</span>
                                            @if (!record.Succeeded && record.Error is not null)
                                            {
                                                <small class="sql-danger sql-hint sqlite-backup-error">@record.Error</small>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <div class="sql-footnote">Backups are copies made by this console, so their history is the one this page can vouch for. Files copied into the directory by hand aren't listed.</div>
                    </div>

                    @if (Selected is { } s)
                    {
                        <aside class="sql-report @(s.Succeeded && s.Verify == BackupRecord.VerifyOk ? "sql-report-ok" : s.Succeeded && s.Verify == BackupRecord.VerifyUnverified ? null : "sql-report-warn") sqlite-backup-detail">
                            <div class="sql-detail-head">
                                <span class="sql-mono sql-ellipsis sqlite-backup-detail-file">@(s.FileName ?? "no file written")</span>
                                <span class="sql-badge @VerifyBadgeClass(s)">@VerifyLabel(s)</span>
                            </div>
                            @if (!s.Succeeded)
                            {
                                <div class="sql-danger">@s.Error</div>
                                <div class="sql-footnote">Taken @s.TakenAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss", Inv) UTC · @TriggerText(s). Nothing was written; the record stays so the failure is visible.</div>
                            }
                            else
                            {
                                <div class="sql-footnote sqlite-backup-detail-facts">@FactsText(s)</div>
                                @if (s.Verify == BackupRecord.VerifyFailed && s.VerifyDetail is not null)
                                {
                                    <div class="sql-danger sqlite-backup-verify-detail">@s.VerifyDetail</div>
                                }
                                <div class="sql-report-row sqlite-backup-compare">
                                    <span class="sql-report-label">vs. live file</span>
                                    @if (o.Live is { } live)
                                    {
                                        <span class="sql-mono">@SqliteFormat.SignedBytes(s.Bytes - live.Bytes)@(s.RowsApprox is { } rows && live.RowsApprox is { } liveRows ? $" · {SqliteFormat.SignedApprox(rows - liveRows)} rows ≈" : "")</span>
                                    }
                                    else
                                    {
                                        <span class="sql-muted">live file unavailable@(o.LiveError is null ? "" : $": {o.LiveError}")</span>
                                    }
                                </div>
                                <div class="sql-report-row">
                                    <span class="sql-report-label">schema</span>
                                    <span class="sqlite-backup-schema">@SchemaText(o, s)</span>
                                </div>
                                @if (_detailMessage is not null)
                                {
                                    <div class="sql-footnote sqlite-backup-message" aria-live="polite">@_detailMessage</div>
                                }
                                <div class="sql-actions">
                                    <button type="button" class="sql-btn sqlite-backup-download" disabled="@Busy" @onclick="() => DownloadAsync(s)">
                                        @(_running == BusyAction.Download ? "Downloading…" : "Download")
                                    </button>
                                    <a class="sql-btn sqlite-backup-open" href="@OpenHref(s)">Open read-only</a>
                                    <button type="button" class="sql-btn sqlite-backup-verify-again" disabled="@Busy" @onclick="() => VerifyAsync(s)">
                                        @(_running == BusyAction.Verify ? "Verifying…" : "Verify again")
                                    </button>
                                    <span class="sql-btn-wrap sqlite-backup-restore-wrap" title="@(CanWrite ? null : ReadOnlyReason)">
                                        <button type="button" class="sql-btn sql-btn-danger sqlite-backup-restore" disabled="@(!CanWrite || Busy)" @onclick="OpenRestore">Restore…</button>
                                    </span>
                                </div>
                                @if (s.Bytes > DownloadNoteBytes)
                                {
                                    <div class="sql-footnote sqlite-backup-download-note">
                                        Download streams the file through this browser session — for copies over 1 GB, fetching it from the volume
                                        directly is faster.
                                    </div>
                                }
                            }
                        </aside>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private enum BackupDialog
    {
        None,
        BackupNow,
        Schedule,
        Restore,
    }

    private enum BusyAction
    {
        None,
        Backup,
        Policy,
        Prune,
        Verify,
        Download,
        Restore,
    }

    private sealed record Restored(string FileName, RestoreOutcome Outcome);

    private const string ReadOnlyReason = "This connection is read-only — set Default mode to Read-write in Connections to restore.";
    private const long DownloadNoteBytes = 1L << 30;
    private const string SqliteContentType = "application/vnd.sqlite3";
    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private CancellationTokenSource _connectionCts = new();
    private IJSObjectReference? _module;

    private ConnectionInfo? _connection;
    private string? _livePath;
    private BackupsOverview? _overview;
    private string? _error;
    private bool _loading;
    private int _loadGeneration;

    private Guid? _selectedId;
    // Fresh verifications carry the backup's schema objects, so "N objects differ" can be counted.
    private readonly Dictionary<Guid, BackupVerification> _verifications = [];
    private string? _detailMessage;

    private BackupDialog _dialog;
    private string? _dialogError;
    private string _note = "";
    private bool _scheduleEnabled;
    private string _scheduleTime = BackupPolicy.DefaultDailyAtUtc;
    private string _keepDaily = "7";
    private string _keepWeekly = "4";
    private string _keepMonthly = "3";

    private BusyAction _running;
    private string? _notice;
    private string? _actionError;
    private Restored? _restored;

    private bool Enabled => _overview is { BackupDir: not null };

    private bool Busy => _running != BusyAction.None;

    private bool CanWrite => _connection?.Summary.GetValueOrDefault("Mode") == "read-write";

    private string LiveFileName => _livePath is { } path ? System.IO.Path.GetFileName(path) : _connection?.Summary.GetValueOrDefault("File") ?? "the live file";

    private BackupRecord? Selected => _selectedId is { } id ? _overview?.History.FirstOrDefault(r => r.Id == id) : null;

    private async Task OnSelectionChangedAsync(ConnectionInfo connection)
    {
        // Everything below belongs to the previous connection: cancel it, never dispose (a resumed
        // continuation may still read .Token), and never let a late response land under the new name.
        _connectionCts.Cancel();
        _connectionCts = new CancellationTokenSource();
        _connection = connection;
        _overview = null;
        _livePath = null;
        _selectedId = null;
        _verifications.Clear();
        _detailMessage = null;
        _dialog = BackupDialog.None;
        _dialogError = null;
        _running = BusyAction.None;
        _notice = null;
        _actionError = null;
        _restored = null;

        var token = _connectionCts.Token;
        try
        {
            // The restore dialog names the live path; only the secret has it (the summary is the basename).
            var secret = await Connections.GetSecretAsync(connection.Id, token);
            if (!token.IsCancellationRequested && secret is not null)
            {
                _livePath = SqliteConnectionSettings.Parse(secret).Path;
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            return;
        }
        catch (FormatException)
        {
            // Unparsable secret: the load below reports it properly.
        }

        if (ReferenceEquals(_connection, connection))
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync(Guid? select = null)
    {
        if (_connection is not { } connection)
        {
            return;
        }

        var generation = ++_loadGeneration;
        var token = _connectionCts.Token;
        _loading = true;
        _error = null;
        try
        {
            var result = await GetBackups.HandleAsync(connection.Id, token);
            if (token.IsCancellationRequested || generation != _loadGeneration)
            {
                return;
            }

            if (!result.IsSuccess)
            {
                _overview = null;
                _error = result.Error;
                return;
            }

            _overview = result.Value!;
            var wanted = select ?? _selectedId;
            _selectedId = wanted is { } id && _overview.History.Any(r => r.Id == id) ? id : null;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            // Connection switched or page disposed mid-load.
        }
        finally
        {
            // A superseded load must not clear the busy flag of the load that replaced it.
            if (generation == _loadGeneration)
            {
                _loading = false;
            }
        }
    }

    private void SelectRecord(BackupRecord record)
    {
        _selectedId = record.Id == _selectedId ? null : record.Id;
        _detailMessage = null;
        if (_dialog == BackupDialog.Restore)
        {
            CloseDialog();
        }
    }

    private void ClearMessages()
    {
        _notice = null;
        _actionError = null;
        _detailMessage = null;
    }

    private void OpenDialog(BackupDialog dialog)
    {
        _dialog = dialog;
        _dialogError = null;
        ClearMessages();
    }

    private void CloseDialog()
    {
        if (Busy)
        {
            return;
        }

        _dialog = BackupDialog.None;
        _dialogError = null;
    }

    private async Task<string> ActorAsync() =>
        AuthState is null ? "admin" : (await AuthState).User.Identity?.Name ?? "admin";

    /// <summary>Runs one command with the page busy. Null when cancelled or the connection changed under it.</summary>
    private async Task<T?> RunAsync<T>(BusyAction action, ConnectionInfo connection, Func<CancellationToken, Task<T>> run) where T : class
    {
        var token = _connectionCts.Token;
        _running = action;
        try
        {
            var result = await run(token);
            return token.IsCancellationRequested || !ReferenceEquals(_connection, connection) ? null : result;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            return null;
        }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                _running = BusyAction.None;
            }
        }
    }

    // ---- Back up now ----

    private void OpenBackupNow()
    {
        if (!Enabled || Busy)
        {
            return;
        }

        OpenDialog(BackupDialog.BackupNow);
        _note = "";
    }

    private async Task BackUpNowAsync()
    {
        if (_dialog != BackupDialog.BackupNow || Busy || _connection is not { } connection)
        {
            return;
        }

        var note = string.IsNullOrWhiteSpace(_note) ? null : _note.Trim();
        var actor = await ActorAsync();
        _dialogError = null;
        var result = await RunAsync(BusyAction.Backup, connection, ct =>
            RunBackup.HandleAsync(new RunBackupCommand(connection.Id, connection.Name, actor, BackupRecord.TriggerManual, note), ct));
        if (result is null)
        {
            return;
        }

        if (!result.IsSuccess)
        {
            _dialogError = result.Error;
            await LoadAsync(); // the failed record is in the history now
            return;
        }

        _dialog = BackupDialog.None;
        await LoadAsync(result.Value!.Id);
        _notice = BackupNotice(result.Value!);
    }

    private static string BackupNotice(BackupRecord record) =>
        $"Backed up to {record.FileName} ({SqliteFormat.Bytes(record.Bytes)}, {SqliteFormat.Duration(TimeSpan.FromMilliseconds(record.DurationMs))}) · " + record.Verify switch
        {
            BackupRecord.VerifyOk => "verified ok.",
            BackupRecord.VerifyFailed => $"verify failed: {record.VerifyDetail}",
            _ => "not verified yet.",
        };

    // ---- Schedule… ----

    private void OpenSchedule()
    {
        if (!Enabled || Busy || _overview is not { } overview)
        {
            return;
        }

        OpenDialog(BackupDialog.Schedule);
        var policy = overview.Policy;
        _scheduleEnabled = policy.Enabled;
        _scheduleTime = policy.DailyAtUtc;
        _keepDaily = policy.KeepDaily.ToString(Inv);
        _keepWeekly = policy.KeepWeekly.ToString(Inv);
        _keepMonthly = policy.KeepMonthly.ToString(Inv);
    }

    private async Task SavePolicyAsync()
    {
        if (_dialog != BackupDialog.Schedule || Busy || _connection is not { } connection)
        {
            return;
        }

        if (!int.TryParse(_keepDaily.Trim(), NumberStyles.Integer, Inv, out var daily)
            || !int.TryParse(_keepWeekly.Trim(), NumberStyles.Integer, Inv, out var weekly)
            || !int.TryParse(_keepMonthly.Trim(), NumberStyles.Integer, Inv, out var monthly))
        {
            _dialogError = "Keep counts must be whole numbers.";
            return;
        }

        var policy = new BackupPolicy(_scheduleEnabled, _scheduleTime.Trim(), daily, weekly, monthly);
        if (policy.Validate() is { } problem)
        {
            _dialogError = problem;
            return;
        }

        _dialogError = null;
        var result = await RunAsync(BusyAction.Policy, connection, ct =>
            SavePolicy.HandleAsync(new SaveBackupPolicyCommand(connection.Id, connection.Name, policy), ct));
        if (result is null)
        {
            return;
        }

        if (!result.IsSuccess)
        {
            _dialogError = result.Error;
            return;
        }

        _dialog = BackupDialog.None;
        await LoadAsync();
        _notice = $"Saved: {policy.Describe()}.";
    }

    // ---- Prune ----

    private async Task PruneAsync() => await PruneCoreAsync(retry: false);

    private async Task PruneAndRetryAsync() => await PruneCoreAsync(retry: true);

    private async Task PruneCoreAsync(bool retry)
    {
        if (Busy || _connection is not { } connection || _overview is not { PrunePreview.Count: > 0 } overview)
        {
            return;
        }

        ClearMessages();
        // IsProd comes from the picker's server-side ConnectionInfo, never from the client.
        if (!await Confirmation.ConfirmAsync("Delete backups of", connection.Name, connection.IsProd, overview.PrunePreview.Count, _connectionCts.Token))
        {
            return;
        }

        if (!ReferenceEquals(_connection, connection))
        {
            return;
        }

        var result = await RunAsync(BusyAction.Prune, connection, ct =>
            PruneBackups.HandleAsync(new PruneBackupsCommand(connection.Id, connection.Name), ct));
        if (result is null)
        {
            return;
        }

        if (!result.IsSuccess)
        {
            _actionError = result.Error;
            return;
        }

        var pruned = result.Value!;
        var notice = $"Pruned {pruned.Deleted} {(pruned.Deleted == 1 ? "backup" : "backups")} · freed {SqliteFormat.Bytes(pruned.BytesFreed)}"
            + (pruned.Failed > 0 ? $" · {pruned.Failed} couldn't be deleted (see the audit log)." : ".");
        if (!retry)
        {
            await LoadAsync();
            _notice = notice;
            return;
        }

        var actor = await ActorAsync();
        var backup = await RunAsync(BusyAction.Backup, connection, ct =>
            RunBackup.HandleAsync(new RunBackupCommand(connection.Id, connection.Name, actor, BackupRecord.TriggerManual, "retry after prune"), ct));
        if (backup is null)
        {
            return;
        }

        await LoadAsync(backup.Value?.Id);
        if (backup.IsSuccess)
        {
            _notice = $"{notice} {BackupNotice(backup.Value!)}";
        }
        else
        {
            _notice = notice;
            _actionError = $"The retry failed too: {backup.Error}";
        }
    }

    private static bool OffersPruneRetry(BackupsOverview overview, BackupRecord failed) =>
        failed.Error == FriendlySqliteError.DiskFull && overview.PrunePreview.Count > 0;

    // ---- detail actions ----

    private async Task VerifyAsync(BackupRecord record)
    {
        if (Busy || _connection is not { } connection || record.FileName is null)
        {
            return;
        }

        ClearMessages();
        var result = await RunAsync(BusyAction.Verify, connection, ct =>
            VerifyBackup.HandleAsync(new VerifyBackupCommand(connection.Id, connection.Name, record.Id), ct));
        if (result is null)
        {
            return;
        }

        if (result.IsSuccess && result.Value!.Verification is { } verification)
        {
            _verifications[record.Id] = verification;
        }

        await LoadAsync(record.Id);
        _detailMessage = result.IsSuccess
            ? result.Value!.Verification is { IntegrityOk: true } ? "Verified: integrity_check ok." : $"Verify found problems: {result.Value.Record.VerifyDetail}"
            : result.Error;
    }

    private async Task DownloadAsync(BackupRecord record)
    {
        if (Busy || _connection is not { } connection || record.FileName is null)
        {
            return;
        }

        ClearMessages();
        var token = _connectionCts.Token;
        var result = await RunAsync(BusyAction.Download, connection, async ct =>
        {
            var opened = await DownloadBackup.HandleAsync(new DownloadBackupCommand(connection.Id, connection.Name, record.Id), ct);
            if (!opened.IsSuccess)
            {
                return opened.Error ?? "The download failed.";
            }

            var download = opened.Value!;
            await using (download.Content)
            {
                try
                {
                    _module ??= await JS.InvokeAsync<IJSObjectReference>("import", ct, "./_content/SbConsole.Plugins.Sqlite/sqlite.js");
                    using var streamRef = new DotNetStreamReference(download.Content, leaveOpen: true);
                    await _module.InvokeVoidAsync("downloadFromStream", ct, download.FileName, streamRef, SqliteContentType);
                }
                catch (JSException)
                {
                    return "The browser couldn't save the file.";
                }
            }

            return $"Downloaded {download.FileName}.";
        });
        if (result is not null && !token.IsCancellationRequested)
        {
            _detailMessage = result;
        }
    }

    private void OpenRestore()
    {
        if (!CanWrite || Busy || Selected is not { Succeeded: true, FileName: not null })
        {
            return;
        }

        OpenDialog(BackupDialog.Restore);
    }

    private async Task RestoreAsync()
    {
        if (_dialog != BackupDialog.Restore || Busy || !CanWrite || _connection is not { } connection || Selected is not { FileName: { } file } record)
        {
            return;
        }

        if (!await Confirmation.ConfirmAsync("Restore backup over", connection.Name, connection.IsProd, ct: _connectionCts.Token))
        {
            return;
        }

        if (!ReferenceEquals(_connection, connection) || _dialog != BackupDialog.Restore || _selectedId != record.Id)
        {
            return;
        }

        _dialogError = null;
        var result = await RunAsync(BusyAction.Restore, connection, ct =>
            RestoreBackup.HandleAsync(new RestoreBackupCommand(connection.Id, connection.Name, record.Id), ct));
        if (result is null)
        {
            return;
        }

        if (!result.IsSuccess)
        {
            _dialogError = result.Error;
            return;
        }

        _dialog = BackupDialog.None;
        _restored = new Restored(file, result.Value!);
        await LoadAsync(record.Id);
    }

    // ---- rendering helpers ----

    private static string RestoredText(RestoreOutcome outcome)
    {
        var n = outcome.Messages.Count;
        var integrity = outcome.IntegrityOk
            ? "integrity_check ok"
            : $"integrity_check: {n} {(n == 1 ? "problem" : "problems")} — {string.Join("; ", outcome.Messages.Take(3))}";
        return $"{integrity} · took {SqliteFormat.Duration(outcome.Duration)}";
    }

    private static BackupRecord? Newest(BackupsOverview overview) => overview.History.MaxBy(r => r.TakenAt);

    private static string VerifyLabel(BackupRecord record) => record.Succeeded ? record.Verify : BackupRecord.StatusFailed;

    private static string VerifyBadgeClass(BackupRecord record) => !record.Succeeded || record.Verify == BackupRecord.VerifyFailed
        ? "sql-badge-failed"
        : record.Verify == BackupRecord.VerifyOk ? "sql-badge-ok" : "sql-badge-unverified";

    private static string TriggerText(BackupRecord record)
    {
        if (record.Trigger == BackupRecord.TriggerSchedule)
        {
            return string.IsNullOrWhiteSpace(record.Note) ? "schedule" : $"schedule · {record.Note}";
        }

        return string.IsNullOrWhiteSpace(record.Note) ? $"{record.Trigger} · {record.Actor}" : $"{record.Trigger} · {record.Actor} · {record.Note}";
    }

    private static string FactsText(BackupRecord record)
    {
        var parts = new List<string> { SqliteFormat.Bytes(record.Bytes) };
        if (record.Sha256 is { Length: >= 8 } sha)
        {
            parts.Add($"sha256 {sha[..4]}…{sha[^4..]}");
        }

        if (record.Tables is { } tables)
        {
            parts.Add(tables == 1 ? "1 table" : $"{SqliteFormat.Count(tables)} tables");
        }

        if (record.RowsApprox is { } rows)
        {
            parts.Add($"{SqliteFormat.Approx(rows)} rows ≈");
        }

        parts.Add(record.Verify switch
        {
            BackupRecord.VerifyOk => "integrity_check ok",
            BackupRecord.VerifyFailed => "integrity_check failed",
            _ => "not verified",
        });
        if (record.VerifiedAt is { } at)
        {
            parts.Add($"checked {at.UtcDateTime.ToString("yyyy-MM-dd HH:mm", Inv)} UTC");
        }

        return string.Join(" · ", parts);
    }

    private string SchemaText(BackupsOverview overview, BackupRecord record)
    {
        if (overview.Live is not { } live)
        {
            return "unknown — the live file couldn't be read";
        }

        if (_verifications.TryGetValue(record.Id, out var verification))
        {
            var differ = SqliteFileFingerprint.CountSchemaDifferences(verification.File, live);
            return differ switch
            {
                0 => "schema identical",
                1 => "1 object differs",
                _ => $"{differ} objects differ",
            };
        }

        if (record.SchemaFingerprint is not { } fingerprint)
        {
            return "unknown — Verify again to compare";
        }

        return fingerprint == live.SchemaFingerprint ? "schema identical" : "schema differs — Verify again counts the objects";
    }

    private string LossText(BackupRecord record)
    {
        var hours = (int)Math.Floor((Clock.GetUtcNow() - record.TakenAt).TotalHours);
        var span = hours < 1 ? "less than an hour of writes" : hours == 1 ? "1 hour of writes" : $"{SqliteFormat.Count(hours)} hours of writes";
        var rows = _overview?.Live?.RowsApprox is { } liveRows && record.RowsApprox is { } backupRows && liveRows > backupRows
            ? $" ≈ {SqliteFormat.Approx(liveRows - backupRows)} rows"
            : "";
        return $"You will lose {span}{rows} since the backup was taken.";
    }

    private string OpenHref(BackupRecord record) =>
        $"{SqlitePlugin.QueryHref}?connectionId={_connection?.Id}&backup={Uri.EscapeDataString(record.FileName ?? "")}";

    public async ValueTask DisposeAsync()
    {
        // Cancel but never dispose (same rule as Tables): a continuation resuming after dispose may
        // still read .Token, which throws ObjectDisposedException on a disposed source.
        _connectionCts.Cancel();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone.
            }
        }
    }
}
