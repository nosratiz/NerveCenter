@* src/Plugins/SbConsole.Plugins.Sqlite/Pages/Overview.razor -- mockups 1a / 1g, design spec §5, §11.6
   (REINDEX and Recover into new file on a failed integrity check, read-write connections only) and
   §11.8 (Last backup tile, Growth — 30 days card; both load after the tiles, like table sizes). *@
@page "/p/sqlite/overview"
@using System.Globalization
@using SbConsole.Plugins.Sqlite.Backups
@using SbConsole.Plugins.Sqlite.Client
@using SbConsole.Plugins.Sqlite.Overview
@inject GetOverviewQueryHandler GetOverview
@inject GetTableSizesQueryHandler GetTableSizes
@inject RunIntegrityCheckCommandHandler RunIntegrityCheck
@inject GetLastIntegrityResultQueryHandler GetLastIntegrity
@inject ReindexCommandHandler Reindex
@inject RecoverCommandHandler Recover
@inject GetBackupsQueryHandler GetBackups
@inject GetGrowthQueryHandler GetGrowth
@inject IConnectionProvider Connections
@inject IConfirmationService Confirmation
@inject TimeProvider Clock
@implements IDisposable

<PageTitle>SQLite overview</PageTitle>

<div class="sql-page">
    <SqlitePageHeader Title="Overview">
        <Chips>
            <SqliteConnectionPicker Loading="_loading" SelectionChanged="OnSelectionChangedAsync" />
        </Chips>
        <Meta>
            @if (_overview is { } meta)
            {
                <span class="sqlite-overview-meta">@meta.Path · @meta.SqliteVersion · @meta.JournalMode</span>
            }
        </Meta>
        <Actions>
            @if (_loadedAt is { } at)
            {
                <span class="sql-meta sqlite-overview-loaded">PRAGMA @at.ToString("HH:mm:ss", Inv) UTC</span>
            }
            @if (_connection is not null)
            {
                <button type="button" class="sql-btn sqlite-overview-refresh" disabled="@_loading" @onclick="LoadAsync">Refresh</button>
            }
        </Actions>
    </SqlitePageHeader>

    @if (_error is not null)
    {
        <div class="sql-body">
            <div class="sql-banner sql-banner-danger sqlite-overview-error">
                <span class="sqlite-overview-error-text" role="alert">@_error</span>
                <span class="sql-spacer"></span>
                <a class="sql-link" href="/connections">Connection settings</a>
                <button type="button" class="sql-btn sqlite-overview-retry" @onclick="LoadAsync">Retry</button>
            </div>
        </div>
    }
    else if (_overview is { } o)
    {
        <div class="sql-tiles sql-ov-tiles">
            <SqliteStatTile Label="File" Class="sqlite-overview-file" ValueClass="sqlite-overview-file-size"
                            Aside="@($"page {SqliteFormat.Bytes(o.PageSize)} · {SqliteFormat.Count(o.PageCount)} pages")">
                <Value>
                    @SqliteFormat.Bytes(o.FileBytes)
                    @if (o.WalBytes is { } wal && wal > 0)
                    {
                        <small class="sql-muted sqlite-overview-wal">+ @SqliteFormat.Bytes(wal) -wal</small>
                    }
                </Value>
                <ChildContent>
                    @* Free pages are drawn inside the file bar, so the size reads as "reclaimable vs. real" (mockup 1a note). *@
                    <div class="sql-bar" title="free pages, drawn inside the file">
                        <span style="width: @Pct(100 - o.FreePercent)%"></span>
                        <i style="width: @Pct(o.FreePercent)%"></i>
                    </div>
                </ChildContent>
                <Caption>
                    <span class="sqlite-overview-free">
                        @if (o.FreelistCount > 0)
                        {
                            <text>@o.FreePercent.ToString("0", Inv)% free pages (@SqliteFormat.Bytes(o.FreeBytes)) — <span class="sql-mono">VACUUM</span> would reclaim them</text>
                        }
                        else
                        {
                            <text>no free pages</text>
                        }
                    </span>
                    · last modified @o.LastModified.ToString("yyyy-MM-dd HH:mm:ss", Inv) UTC
                </Caption>
            </SqliteStatTile>

            <SqliteStatTile Label="Journal" Class="sqlite-overview-journal" ValueClass="sqlite-overview-journal-mode">
                <Value>@o.JournalMode</Value>
                <Caption>
                    synchronous <span class="sql-mono">@o.Synchronous</span>@(o.JournalMode == "WAL" ? $" · checkpoint every {SqliteFormat.Count(o.WalAutoCheckpoint)} pages" : "") · per-connection
                </Caption>
            </SqliteStatTile>

            <SqliteStatTile Label="Page cache" Class="sqlite-overview-cache" ValueClass="sqlite-overview-cache-pages">
                <Value>@SqliteFormat.Count(o.CachePages) p</Value>
                <Caption>@SqliteFormat.Bytes(o.CacheBytes) · per-connection default</Caption>
            </SqliteStatTile>

            <SqliteStatTile Label="Last backup" Class="sqlite-overview-backup" ValueClass="sqlite-overview-backup-age">
                <Value>@BackupAgeText</Value>
                <Caption>
                    <span class="sqlite-overview-backup-policy">@BackupPolicyText</span>
                    @if (_backupsError is not null)
                    {
                        <span class="sql-warn sqlite-overview-backup-error" title="@_backupsError"> · unavailable</span>
                    }
                    · <a class="sql-link sqlite-overview-backup-now" href="@($"{SqlitePlugin.BackupsHref}?connectionId={_connection?.Id}")">@(_backups is { BackupDir: null } ? "How to enable →" : "Back up now →")</a>
                </Caption>
            </SqliteStatTile>
        </div>

        <div class="sql-body">
            @* Integrity is a status strip, not a tile: it is either ok or the only thing that matters (mockup 1a note). *@
            <div class="sql-strip sqlite-overview-integrity @IntegrityStripClass">
                <span class="sql-mono">PRAGMA integrity_check</span>
                <span class="sql-muted">→</span>
                @if (_integrityRunning)
                {
                    <span class="sql-muted sqlite-overview-integrity-status" role="status">running…</span>
                }
                else if (_integrity is null)
                {
                    <span class="sql-muted sqlite-overview-integrity-status" role="status">never run</span>
                }
                else if (_integrity.IntegrityOk)
                {
                    <span class="sql-ok sqlite-overview-integrity-status" role="status">ok</span>
                }
                else
                {
                    <span class="sql-danger sqlite-overview-integrity-status" role="status">@ErrorCount(_integrity)</span>
                }
                @if (_integrity is { } last && !_integrityRunning)
                {
                    <span class="sql-muted sqlite-overview-integrity-meta">· started @last.RanAt.ToString("yyyy-MM-dd HH:mm", Inv) UTC, took @SqliteFormat.Duration(last.Duration) · foreign_key_check @ViolationCount(last)</span>
                }
                <span class="sql-spacer"></span>
                <button type="button" class="sql-btn sqlite-overview-run-integrity" disabled="@_integrityRunning" @onclick="RunIntegrityAsync">Run now</button>
            </div>

            @if (_integrity is { IntegrityOk: false } failed && !_integrityRunning)
            {
                <pre class="sql-error-list sqlite-overview-integrity-errors">@string.Join("\n", failed.Messages)</pre>
                @if (CanWrite)
                {
                    <div class="sql-footnote sqlite-overview-repair-note">
                        Treat this file as suspect and copy it before changing anything. <span class="sql-mono">REINDEX</span> can fix
                        index-only errors and runs a fresh check; page errors need a salvage — <strong>Recover into new file</strong> copies
                        every row it can still read into a new file in the backup directory and never changes this one.
                    </div>
                    <div class="sql-actions sqlite-overview-repair">
                        <span class="sql-btn-wrap sqlite-overview-recover-wrap" title="@(_hasBackupDir ? null : SqliteOperations.BackupsNotEnabled)">
                            <button type="button" class="sql-btn sqlite-overview-recover" disabled="@(!_hasBackupDir || Repairing)" @onclick="RecoverAsync">
                                @(_recovering ? "Recovering…" : "Recover into new file")
                            </button>
                        </span>
                        <button type="button" class="sql-btn sqlite-overview-reindex" disabled="@Repairing" @onclick="ReindexAsync">
                            @(_reindexing ? "Reindexing…" : "REINDEX")
                        </button>
                    </div>
                }
                else
                {
                    <div class="sql-footnote sqlite-overview-repair-readonly">
                        Treat this file as suspect and copy it before changing anything. <span class="sql-mono">REINDEX</span> can fix
                        index-only errors; page errors need <strong>Recover into new file</strong>. Both need Default mode Read-write on
                        the connection (Connections).
                    </div>
                }
            }

            @if (_reindexNotice is not null)
            {
                <div class="sql-footnote sqlite-overview-reindex-result" role="status">@_reindexNotice</div>
            }

            @if (_recovered is { } recovered)
            {
                <div class="sql-report @(recovered.Failures.Count == 0 ? "sql-report-ok" : "sql-report-warn") sqlite-overview-recover-result" role="status">
                    <div class="sql-overline">Recovered into new file</div>
                    <div class="sql-report-row"><span class="sql-report-label">File</span><span class="sql-mono sqlite-overview-recover-file">@recovered.FileName</span></div>
                    <div class="sql-report-row sqlite-overview-recover-counts">
                        <span class="sql-report-label">Copied</span>
                        <span>@recovered.TablesCopied tables · @SqliteFormat.Count(recovered.RowsCopied) rows@(recovered.RowsSkipped > 0 ? $" · {SqliteFormat.Count(recovered.RowsSkipped)} rows skipped" : "") · @recovered.OtherObjectsCopied indexes, views and triggers</span>
                    </div>
                    @foreach (var failure in recovered.Failures)
                    {
                        <div class="sql-report-row sqlite-overview-recover-failure">
                            <span class="sql-report-label">Failed @failure.Type</span>
                            <span><span class="sql-mono">@failure.Name</span> — @failure.Reason</span>
                        </div>
                    }
                    <div class="sql-footnote">The live file was only read. Check the copy, then swap it in yourself (or restore it from Backups).</div>
                </div>
            }

            @if (_repairError is not null)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="sqlite-overview-repair-error">@_repairError</MudAlert>
            }

            @if (_integrityError is not null)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="sqlite-overview-integrity-error">@_integrityError</MudAlert>
            }

            <div class="sql-cards">
                <div class="sql-card sqlite-overview-sizes">
                    <div class="sql-card-head">
                        <span class="sql-card-title">@(_sizes is { SizesAvailable: false } ? "Largest tables" : "Size by table")</span>
                        <span class="sql-spacer"></span>
                        @if (_sizes is { } head)
                        {
                            <span class="sql-card-sub">@(head.SizesAvailable ? "dbstat" : "sqlite_stat1") · @head.TableCount tables, @head.IndexCount indexes</span>
                        }
                    </div>
                    @if (_sizesError is not null)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="sqlite-overview-sizes-error">@_sizesError</MudAlert>
                    }
                    else if (_sizes is null)
                    {
                        <div class="sql-footnote">Reading sizes…</div>
                    }
                    else if (_sizes.Entries.Count == 0)
                    {
                        <div class="sql-footnote">No tables yet.</div>
                    }
                    else
                    {
                        var max = BarMax(_sizes);
                        foreach (var entry in _sizes.Entries.Take(TopRows))
                        {
                            <div class="sql-size-row sqlite-overview-size-row">
                                <span class="sql-mono sql-size-name">@entry.Name</span>
                                <div class="sql-bar sql-bar-thin"><span style="width: @Pct(Share(_sizes, entry, max))%"></span></div>
                                @if (_sizes.SizesAvailable)
                                {
                                    <span class="sql-num sql-size-bytes">@(entry.Bytes is { } bytes ? SqliteFormat.Bytes(bytes) : "—")</span>
                                }
                                <span class="sql-num sql-muted sql-size-rows">@RowsLabel(entry)</span>
                            </div>
                        }
                        var rest = _sizes.Entries.Skip(TopRows).ToList();
                        if (rest.Count > 0)
                        {
                            <div class="sql-size-row sql-muted sqlite-overview-size-more">
                                <span class="sql-size-name">@rest.Count more</span>
                                @if (_sizes.SizesAvailable)
                                {
                                    <span class="sql-num sql-size-bytes">@SqliteFormat.Bytes(rest.Sum(e => e.Bytes ?? 0))</span>
                                }
                            </div>
                        }
                        if (!_sizes.SizesAvailable)
                        {
                            <div class="sql-footnote sqlite-overview-no-dbstat">
                                Sizes need <span class="sql-mono">dbstat</span>, which this SQLite build doesn't include — tables are ranked by
                                <span class="sql-mono">sqlite_stat1</span> row estimates (≈). Run <span class="sql-mono">ANALYZE</span> to refresh them.
                            </div>
                        }
                    }
                </div>

                <div class="sql-card sql-card-wide sqlite-overview-growth">
                    <div class="sql-card-head">
                        <span class="sql-card-title">Growth — 30 days</span>
                        <span class="sql-spacer"></span>
                        @if (_growth?.Summary is { Collecting: false } growthHead)
                        {
                            <span class="sql-card-sub sqlite-overview-growth-delta">@SqliteFormat.SignedBytes(growthHead.DeltaBytes) · @RateText(growthHead.BytesPerDay)</span>
                        }
                    </div>
                    @if (_growthError is not null)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="sqlite-overview-growth-error">@_growthError</MudAlert>
                    }
                    else if (_growth is null)
                    {
                        <div class="sql-footnote">Reading samples…</div>
                    }
                    else if (_growth.Summary is { Collecting: true } collecting)
                    {
                        <div class="sql-footnote sqlite-overview-growth-collecting">@(collecting.First is { } first
                            ? $"collecting — first sample at {first.At.UtcDateTime.ToString("yyyy-MM-dd HH:mm", Inv)} UTC"
                            : "collecting — no samples yet")</div>
                    }
                    else
                    {
                        var summary = _growth.Summary;
                        <div class="sql-growth">
                            <span class="sql-num sql-mono sql-muted sqlite-overview-growth-first">@SqliteFormat.Bytes(summary.First!.Bytes)</span>
                            <svg class="sql-spark sqlite-overview-growth-spark" viewBox="0 0 @SparkWidth @SparkHeight" preserveAspectRatio="none" role="img"
                                 aria-label="@($"File size over {SpanDays(summary)} days")">
                                <polyline points="@SparkPoints(_growth.Samples)" />
                            </svg>
                            <span class="sql-num sql-mono sqlite-overview-growth-last">@SqliteFormat.Bytes(summary.Last!.Bytes)</span>
                        </div>
                        @if (summary.DeltaBytes > 0 && summary.DaysUntilFull is { } days && _growth.Volume is { } volume)
                        {
                            <div class="sql-footnote sqlite-overview-growth-volume">volume @SqliteFormat.Bytes(volume.TotalBytes) — ~@SqliteFormat.Count((long)Math.Round(days)) days at this rate</div>
                        }
                        <div class="sql-footnote">
                            One file-size sample an hour (scheduler and Overview loads), kept 30 days. Deleting rows doesn't shrink the file —
                            freed pages are reused; <span class="sql-mono">VACUUM</span> gives them back.
                        </div>
                    }
                </div>

                <div class="sql-card sqlite-overview-settings">
                    <div class="sql-card-head"><span class="sql-card-title">This console's connection</span></div>
                    <dl class="sql-kv">
                        <dt>busy_timeout</dt>
                        <dd class="sql-mono sqlite-overview-busy">@SqliteFormat.Count(o.BusyTimeoutMs) ms</dd>
                        <dt>foreign_keys</dt>
                        <dd>per-connection · on for this console's connections</dd>
                        <dt>mode</dt>
                        <dd>read-only (<span class="sql-mono">mode=ro</span>)</dd>
                    </dl>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private const int TopRows = 4;
    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;

    private readonly CancellationTokenSource _cts = new();
    private ConnectionInfo? _connection;
    private SqliteOverview? _overview;
    private TableSizes? _sizes;
    private string? _sizesError;
    private IntegrityResult? _integrity;
    private string? _integrityError;
    private bool _integrityRunning;
    private string? _error;
    private bool _loading;
    private DateTimeOffset? _loadedAt;
    private Guid? _dataConnectionId;
    private int _loadGeneration;
    private int _integrityGeneration;
    private bool _hasBackupDir;
    private bool _reindexing;
    private bool _recovering;
    private string? _reindexNotice;
    private SalvageOutcome? _recovered;
    private string? _repairError;
    private BackupsOverview? _backups;
    private string? _backupsError;
    private GrowthOverview? _growth;
    private string? _growthError;

    private const int SparkWidth = 300;
    private const int SparkHeight = 48;

    private bool CanWrite => _connection?.Summary.GetValueOrDefault("Mode") == "read-write";

    private bool Repairing => _reindexing || _recovering || _integrityRunning;

    private string? IntegrityStripClass => _integrity switch
    {
        null => null,
        { IntegrityOk: true, ForeignKeyViolations: > 0 } => "sql-strip-warn",
        { IntegrityOk: true } => "sql-strip-ok",
        _ => "sql-strip-danger",
    };

    private async Task OnSelectionChangedAsync(ConnectionInfo connection)
    {
        _connection = connection;
        ResetRepair();
        _hasBackupDir = await HasBackupDirAsync(connection);
        if (ReferenceEquals(_connection, connection))
        {
            await LoadAsync();
        }
    }

    /// <summary>Recover writes into the secret's BackupDir; the operation re-checks it through the path policy.</summary>
    private async Task<bool> HasBackupDirAsync(ConnectionInfo connection)
    {
        try
        {
            var secret = await Connections.GetSecretAsync(connection.Id, _cts.Token);
            return secret is not null && SqliteConnectionSettings.Parse(secret).BackupDir is not null;
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
            return false;
        }
        catch (FormatException)
        {
            return false;
        }
    }

    private void ResetRepair()
    {
        _reindexing = false;
        _recovering = false;
        _reindexNotice = null;
        _recovered = null;
        _repairError = null;
    }

    private async Task ReindexAsync()
    {
        if (!CanWrite || Repairing || _connection is not { } connection)
        {
            return;
        }

        // IsProd comes from the picker's server-side ConnectionInfo, never from the client.
        if (connection.IsProd && !await Confirmation.ConfirmAsync("Reindex", connection.Name, true, ct: _cts.Token))
        {
            return;
        }

        if (!ReferenceEquals(_connection, connection))
        {
            return;
        }

        _reindexing = true;
        _reindexNotice = null;
        _repairError = null;
        try
        {
            var result = await Reindex.HandleAsync(new ReindexCommand(connection.Id, connection.Name), _cts.Token);
            if (!ReferenceEquals(_connection, connection))
            {
                return;
            }

            if (result.IsSuccess)
            {
                _integrity = result.Value;
                _integrityGeneration++; // a check started earlier must not overwrite this fresher result
                _reindexNotice = result.Value!.IntegrityOk
                    ? "REINDEX finished — the fresh integrity check is ok."
                    : $"REINDEX finished — {ErrorCount(result.Value)} remain, so they aren't index-only. Recover into new file salvages what can be read.";
            }
            else
            {
                _repairError = result.Error;
            }
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
        }
        finally
        {
            if (ReferenceEquals(_connection, connection))
            {
                _reindexing = false;
            }
        }
    }

    private async Task RecoverAsync()
    {
        if (!CanWrite || !_hasBackupDir || Repairing || _connection is not { } connection)
        {
            return;
        }

        _recovering = true;
        _recovered = null;
        _repairError = null;
        try
        {
            var result = await Recover.HandleAsync(new RecoverCommand(connection.Id, connection.Name), _cts.Token);
            if (!ReferenceEquals(_connection, connection))
            {
                return;
            }

            if (result.IsSuccess)
            {
                _recovered = result.Value;
            }
            else
            {
                _repairError = result.Error;
            }
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
        }
        finally
        {
            if (ReferenceEquals(_connection, connection))
            {
                _recovering = false;
            }
        }
    }

    private async Task LoadAsync()
    {
        if (_connection is not { } connection)
        {
            return;
        }

        var generation = ++_loadGeneration;
        if (_dataConnectionId != connection.Id)
        {
            // Another connection's data must never sit under this connection's name while it loads.
            _dataConnectionId = connection.Id;
            _overview = null;
            _loadedAt = null;
            _integrity = null;
            _integrityRunning = false;
            _integrityGeneration++;
        }

        _loading = true;
        _error = null;
        _sizes = null;
        _sizesError = null;
        _backups = null;
        _backupsError = null;
        _growth = null;
        _growthError = null;
        _integrityError = null;
        try
        {
            var overview = await GetOverview.HandleAsync(connection.Id, _cts.Token);
            var integrity = await GetLastIntegrity.HandleAsync(connection.Id, _cts.Token);
            if (generation != _loadGeneration)
            {
                return;
            }

            _integrity = integrity;
            if (!overview.IsSuccess)
            {
                _overview = null;
                _loadedAt = null;
                _error = overview.Error;
                return;
            }

            _overview = overview.Value;
            _loadedAt = Clock.GetUtcNow();
            _loading = false;
            StateHasChanged();

            // Sizes, backups and growth load separately, side by side, so the tiles never wait on
            // them (spec §5, §11.8).
            await Task.WhenAll(LoadSizesAsync(connection, generation), LoadBackupsAsync(connection, generation), LoadGrowthAsync(connection, generation));
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
            // Page disposed mid-load.
        }
        finally
        {
            // A superseded load must not clear the busy flag of the load that replaced it.
            if (generation == _loadGeneration)
            {
                _loading = false;
            }
        }
    }

    private async Task LoadSizesAsync(ConnectionInfo connection, int generation)
    {
        var sizes = await GetTableSizes.HandleAsync(connection.Id, _cts.Token);
        if (generation != _loadGeneration)
        {
            return;
        }

        if (sizes.IsSuccess)
        {
            _sizes = sizes.Value;
        }
        else
        {
            _sizesError = sizes.Error;
        }

        StateHasChanged();
    }

    private async Task LoadBackupsAsync(ConnectionInfo connection, int generation)
    {
        var backups = await GetBackups.HandleAsync(connection.Id, _cts.Token);
        if (generation != _loadGeneration)
        {
            return;
        }

        if (backups.IsSuccess)
        {
            _backups = backups.Value;
        }
        else
        {
            _backupsError = backups.Error;
        }

        StateHasChanged();
    }

    private async Task LoadGrowthAsync(ConnectionInfo connection, int generation)
    {
        var growth = await GetGrowth.HandleAsync(connection.Id, _cts.Token);
        if (generation != _loadGeneration)
        {
            return;
        }

        if (growth.IsSuccess)
        {
            _growth = growth.Value;
        }
        else
        {
            _growthError = growth.Error;
        }

        StateHasChanged();
    }

    private string BackupAgeText => _backups switch
    {
        null when _backupsError is not null => "—",
        null => "…",
        { BackupDir: null } => "off",
        { Schedule.LastSuccess: { } last } => $"{SqliteFormat.Age(Clock.GetUtcNow() - last.TakenAt)} ago",
        _ => "none yet",
    };

    private string BackupPolicyText => _backups switch
    {
        null => _backupsError is not null ? "backup history" : "reading history…",
        { BackupDir: null } => "backups not enabled",
        { PolicySaved: true, Policy: { Enabled: true } policy } => $"policy: daily {policy.DailyAtUtc} UTC",
        _ => "no schedule",
    };

    private static string RateText(double? bytesPerDay) => bytesPerDay is { } rate
        ? $"{SqliteFormat.SignedBytes((long)Math.Round(rate)).TrimStart('+')}/day"
        : "";

    private static string SpanDays(GrowthSummary summary) =>
        Math.Max(1, Math.Round((summary.Last!.At - summary.First!.At).TotalDays)).ToString("0", Inv);

    /// <summary>Samples (oldest first) as polyline points in the SparkWidth × SparkHeight box: x by time, y by size (min..max).</summary>
    private static string SparkPoints(IReadOnlyList<GrowthSample> samples)
    {
        var ordered = samples.OrderBy(s => s.At).ToList();
        var t0 = ordered[0].At;
        var span = Math.Max(1, (ordered[^1].At - t0).TotalSeconds);
        var min = ordered.Min(s => s.Bytes);
        var range = Math.Max(1, ordered.Max(s => s.Bytes) - min);
        const double pad = 2;
        return string.Join(' ', ordered.Select(s =>
        {
            var x = (s.At - t0).TotalSeconds / span * SparkWidth;
            var y = pad + ((1 - ((double)(s.Bytes - min) / range)) * (SparkHeight - (2 * pad)));
            return $"{x.ToString("0.#", Inv)},{y.ToString("0.#", Inv)}";
        }));
    }

    private async Task RunIntegrityAsync()
    {
        if (_connection is not { } connection)
        {
            return;
        }

        var generation = ++_integrityGeneration;
        _integrityRunning = true;
        _integrityError = null;
        try
        {
            var result = await RunIntegrityCheck.HandleAsync(new RunIntegrityCheckCommand(connection.Id, connection.Name), _cts.Token);
            if (generation != _integrityGeneration)
            {
                return;
            }

            if (result.IsSuccess)
            {
                _integrity = result.Value;
            }
            else
            {
                _integrityError = result.Error;
            }
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
            // Page disposed mid-check.
        }
        finally
        {
            if (generation == _integrityGeneration)
            {
                _integrityRunning = false;
            }
        }
    }

    private static string ErrorCount(IntegrityResult result) =>
        result.Messages.Count == 1 ? "1 error" : $"{result.Messages.Count} errors";

    private static string ViolationCount(IntegrityResult result) =>
        result.ForeignKeyViolations == 1 ? "1 violation" : $"{result.ForeignKeyViolations} violations";

    private static string Pct(double value) => Math.Clamp(value, 0, 100).ToString("0.#", Inv);

    private static double BarMax(TableSizes sizes) =>
        Math.Max(1, sizes.Entries.Max(e => (double)(sizes.SizesAvailable ? e.Bytes ?? 0 : e.EstimatedRows ?? 0)));

    private static double Share(TableSizes sizes, TableSizeEntry entry, double max) =>
        100.0 * (sizes.SizesAvailable ? entry.Bytes ?? 0 : entry.EstimatedRows ?? 0) / max;

    private static string RowsLabel(TableSizeEntry entry) => entry.Type == SchemaObjectType.Index
        ? "index"
        : entry.EstimatedRows is { } rows ? $"{SqliteFormat.Approx(rows)} rows ≈" : "rows —";

    public void Dispose()
    {
        // Cancel but never dispose: a load continuation that resumes after dispose still reads
        // _cts.Token, and Token on a disposed source throws ObjectDisposedException. A source with no
        // timers or linked registrations holds nothing that needs disposal.
        _cts.Cancel();
    }
}
