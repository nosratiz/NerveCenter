@page "/p/aws/queues"
@using System.Globalization
@using Microsoft.Extensions.Logging
@using SbConsole.Plugins.Aws.Client
@using SbConsole.Plugins.Aws.Queues
@using SbConsole.Sdk
@inject IConnectionProvider Connections
@inject ListQueuesQueryHandler ListHandler
@inject GetConnectionEchoQueryHandler EchoHandler
@inject DeleteQueueCommandHandler DeleteHandler
@inject IConfirmationService Confirmation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject TimeProvider Clock
@inject ILogger<Queues> Logger
@implements IDisposable

<PageTitle>Queues</PageTitle>
<h1>Queues</h1>

@if (_connections.Count == 0)
{
    <MudAlert Severity="Severity.Info">No connections yet. Add an AWS SQS/SNS connection to get started.</MudAlert>
}
else
{
    <div class="d-flex align-center flex-wrap gap-4 my-4">
        <div class="d-flex align-center gap-2">
            <MudText Typo="Typo.overline" Class="mud-text-secondary">Account</MudText>
            <MudMenu Class="connection-menu">
                <ActivatorContent>
                    <div class="d-flex align-center gap-2" style="cursor:pointer">
                        <MudText Typo="Typo.subtitle1" Style="font-family:monospace">@SelectedConnection?.Name</MudText>
                        @if (SelectedConnection?.IsProd == true)
                        {
                            <MudChip T="string" Color="Color.Warning" Size="Size.Small">prod</MudChip>
                        }
                        <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Size="Size.Small" />
                    </div>
                </ActivatorContent>
                <ChildContent>
                    @foreach (var connection in _connections)
                    {
                        <MudMenuItem Class="connection-option" OnClick="@(() => OnConnectionChanged(connection.Id))">@connection.Name</MudMenuItem>
                    }
                </ChildContent>
            </MudMenu>
        </div>

        @* Value + ValueChanged, not @bind-Value + ValueChanged (RZ10010: a component parameter --
           here ValueChanged, generated by @bind-Value -- can't be supplied twice). OnPrefixChanged
           already assigns _namePrefix from the callback argument, so the one-way Value binding
           plus explicit ValueChanged still keeps the field in sync. *@
        <MudTextField T="string" Class="prefix-filter" Label="Starts with" Value="_namePrefix" Immediate="true" DebounceInterval="300" ValueChanged="OnPrefixChanged" Style="max-width:200px" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />

        <div class="d-flex align-center gap-2">
            <MudText Typo="Typo.overline" Class="mud-text-secondary">Auto-refresh</MudText>
            <MudButtonGroup Class="auto-refresh-picker" Variant="Variant.Outlined" Size="Size.Small">
                @foreach (var seconds in AutoRefreshChoices)
                {
                    <MudButton Class="@(seconds == 0 ? "auto-refresh-off" : $"auto-refresh-{seconds}")" Variant="@(seconds == AutoRefreshSeconds ? Variant.Filled : Variant.Outlined)" OnClick="@(() => SetAutoRefreshAsync(seconds))">@AutoRefreshLabel(seconds)</MudButton>
                }
            </MudButtonGroup>
        </div>

        <MudSpacer />
        <MudButton Class="create-queue-action" Color="Color.Primary" Variant="Variant.Outlined" OnClick="OpenCreate">+ Create queue</MudButton>
        @if (_loading)
        {
            <MudProgressCircular Class="queues-busy" Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
        }
    </div>

    <MudText Typo="Typo.caption" Class="connection-echo mud-text-secondary">@_connectionEcho</MudText>
    <div class="d-flex align-baseline gap-3 mt-1">
        <MudText Class="queues-summary mud-text-secondary" Typo="Typo.body2">@_queues.Count @(_queues.Count == 1 ? "queue" : "queues")</MudText>
        @if (_countsReadAt is { } readAt)
        {
            <MudText Typo="Typo.caption" Class="counts-read-caption mud-text-secondary">counts read @readAt.ToString("HH:mm:ss", CultureInfo.InvariantCulture) @ZoneLabel(readAt.Offset)</MudText>
        }
    </div>
    @if (_loadError is not null)
    {
        <MudAlert Class="queues-load-error my-2" Severity="Severity.Error" Dense="true">Couldn't list queues: @_loadError</MudAlert>
    }
    <MudText Typo="Typo.caption" Class="refresh-cost-caption mud-text-secondary mb-2">
        <span style="font-family:monospace">ListQueues</span> filters by prefix only — no substring or regex.
        Each refresh is @RefreshCostFormula(_queues.Count, _loadedWithPrefix) calls@(_loadedWithPrefix ? " — with a prefix, each queue also gets a ListDeadLetterSourceQueues lookup so a DLQ is found even when its sources don't match" : "").
    </MudText>

    <MudTable Items="_queues">
        <HeaderContent>
            <MudTh>Queue</MudTh>
            <MudTh>Type</MudTh>
            <MudTh Style="text-align:right">~Visible</MudTh>
            <MudTh Style="text-align:right">~In flight</MudTh>
            <MudTh Style="text-align:right">~Delayed</MudTh>
            <MudTh>Created</MudTh>
            <MudTh>Flags</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd Style="font-family:monospace"><MudLink Class="queue-detail-link" Href="@DetailUrl(context.QueueUrl)">@context.Name</MudLink></MudTd>
            <MudTd>@(context.IsFifo ? "FIFO" : "Standard")</MudTd>
            <MudTd Class="approx-visible" Style="text-align:right;font-family:monospace">@(context.AttributesUnavailable ? "—" : $"~{context.ApproxVisible}")</MudTd>
            <MudTd Class="approx-in-flight" Style="text-align:right;font-family:monospace">@(context.AttributesUnavailable ? "—" : $"~{context.ApproxInFlight}")</MudTd>
            <MudTd Class="approx-delayed" Style="text-align:right;font-family:monospace">@(context.AttributesUnavailable ? "—" : $"~{context.ApproxDelayed}")</MudTd>
            <MudTd Class="queue-created" Style="font-family:monospace">@(context.AttributesUnavailable ? "—" : context.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))</MudTd>
            <MudTd>
                @if (context.DeadLetterSourceCount > 0)
                {
                    <MudChip T="string" Class="dlq-flag" Color="Color.Error" Size="Size.Small">DLQ &times;@context.DeadLetterSourceCount</MudChip>
                }
                @if (context.IsFifo)
                {
                    <MudChip T="string" Class="fifo-flag" Size="Size.Small">FIFO</MudChip>
                }
                @if (context.IsKmsEncrypted)
                {
                    <MudChip T="string" Class="kms-flag" Size="Size.Small" Variant="Variant.Outlined">KMS</MudChip>
                }
            </MudTd>
            <MudTd>
                <MudButton Class="receive-action" Href="@ReceiveUrl(context.QueueUrl, context.Name)">Receive</MudButton>
                <MudButton Class="send-message-action" OnClick="@(() => OpenSend(context.QueueUrl))">Send</MudButton>
                @if (context.DeadLetterSourceCount > 0)
                {
                    <MudButton Class="redrive-action" OnClick="@(() => OpenRedrive(context.QueueUrl, context.QueueArn))">Redrive</MudButton>
                }
                @* Destructive actions sit behind a per-row overflow menu so they're never one stray
                   click away; the confirmation flows behind them are unchanged. *@
                <MudMenu Class="queue-row-menu" Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" AriaLabel="More actions" Disabled="@(_deletingQueue == context.QueueUrl)">
                    <MudMenuItem Class="purge-queue-action" OnClick="@(() => OpenPurge(context.QueueUrl))">Purge</MudMenuItem>
                    <MudMenuItem Class="delete-queue" OnClick="@(() => DeleteAsync(context.QueueUrl, context.Name))">Delete</MudMenuItem>
                </MudMenu>
                @if (_deletingQueue == context.QueueUrl)
                {
                    <MudProgressCircular Class="delete-queue-busy" Color="Color.Error" Size="Size.Small" Indeterminate="true" />
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private IReadOnlyList<ConnectionInfo> _connections = [];
    private IReadOnlyList<QueueSummary> _queues = [];
    private Guid _selectedConnectionId;
    private bool _loading;
    private string? _deletingQueue;
    private string _namePrefix = "";
    private string _connectionEcho = "";
    private DateTimeOffset? _countsReadAt;
    private string? _loadError;
    // Whether the rows currently shown were loaded under a prefix -- the refresh-cost caption
    // describes the load that produced them, not whatever is typed in the field right now.
    private bool _loadedWithPrefix;
    // Bumped by every LoadQueuesAsync/LoadEchoAsync start. A load whose generation is no longer the
    // latest when it completes is stale (the connection or prefix changed while it was in flight):
    // its result is discarded, so connection A's queues can never render under connection B.
    private int _loadGeneration;
    private int _echoGeneration;
    private CancellationTokenSource? _refreshCts;
    private bool _disposed;

    private const string AutoRefreshKey = "queues.autoRefreshSeconds";
    private static readonly int[] AutoRefreshChoices = [0, 15, 30, 60];

    // Blazor's keyed property injection (InjectAttribute.Key) -- FromKeyedServicesAttribute is
    // parameter-only. Same "aws" key AddSbConsolePlugin<TPlugin>() registers IPluginStore under.
    [Inject(Key = "aws")]
    private IPluginStore Store { get; set; } = default!;

    // Exposed for tests: the chosen interval (0 = Off) and whether the refresh loop is alive.
    internal int AutoRefreshSeconds { get; private set; }
    internal bool IsAutoRefreshing => _refreshCts is not null;

    // Mirrors SqsOperations.ListQueuesAsync: one ListQueues page plus one GetQueueAttributes per
    // queue, and -- only under a prefix -- one ListDeadLetterSourceQueues per queue as well (see
    // SqsOperations.BuildQueueSummariesAsync for why).
    internal static string RefreshCostFormula(int queueCount, bool prefixApplied) => prefixApplied
        ? $"1 + 2 × {queueCount} = {1 + 2 * queueCount}"
        : $"1 + {queueCount} = {1 + queueCount}";

    private static string AutoRefreshLabel(int seconds) => seconds == 0 ? "Off" : $"{seconds}s";

    private ConnectionInfo? SelectedConnection => _connections.FirstOrDefault(c => c.Id == _selectedConnectionId);

    protected override async Task OnInitializedAsync()
    {
        _connections = await Connections.ListAsync("aws");
        if (_connections.Count > 0)
        {
            _selectedConnectionId = _connections[0].Id;
            await LoadQueuesAsync();
            await LoadEchoAsync();
            AutoRefreshSeconds = await ReadAutoRefreshSecondsAsync();
            RestartAutoRefresh();
        }
    }

    // A missing, unrecognised, or unreadable stored value all mean Off -- the picker is a
    // convenience and must never break the page.
    private async Task<int> ReadAutoRefreshSecondsAsync()
    {
        try
        {
            var stored = await Store.GetAsync(AutoRefreshKey);
            return int.TryParse(stored, NumberStyles.None, CultureInfo.InvariantCulture, out var seconds) && AutoRefreshChoices.Contains(seconds)
                ? seconds
                : 0;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Reading the queues auto-refresh setting failed; defaulting to Off.");
            return 0;
        }
    }

    private async Task SetAutoRefreshAsync(int seconds)
    {
        AutoRefreshSeconds = seconds;
        RestartAutoRefresh();
        try
        {
            await Store.SetAsync(AutoRefreshKey, seconds.ToString(CultureInfo.InvariantCulture));
        }
        catch (Exception ex)
        {
            // The choice still applies for this visit; it just won't be remembered.
            Logger.LogWarning(ex, "Persisting the queues auto-refresh setting failed.");
        }
    }

    // One refresh step, called by the loop below every interval -- and directly by tests instead of
    // waiting on the real delay (same shape as QueueDetail.PollRedriveTasksAsync). Returns whether it
    // actually reloaded: a tick that lands while a load is in flight is skipped, never overlapped.
    internal async Task<bool> AutoRefreshTickAsync()
    {
        if (_loading)
        {
            return false;
        }

        await LoadQueuesAsync(fromAutoRefresh: true);
        StateHasChanged();
        return true;
    }

    private void RestartAutoRefresh()
    {
        StopAutoRefresh();
        if (_disposed || AutoRefreshSeconds == 0)
        {
            return;
        }

        _refreshCts = new CancellationTokenSource();
        _ = AutoRefreshLoopAsync(TimeSpan.FromSeconds(AutoRefreshSeconds), _refreshCts.Token);
    }

    private async Task AutoRefreshLoopAsync(TimeSpan interval, CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(interval, ct);
                await InvokeAsync(async () => await AutoRefreshTickAsync());
            }
        }
        catch (OperationCanceledException)
        {
            // Stopped: interval changed, turned Off, or the page was disposed.
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Auto-refreshing the queues list failed; stopping auto-refresh.");
        }
    }

    // Cancel then dispose, like QueueDetail.StopPolling: the loop only observes the token in
    // Task.Delay and its while-condition, and a cancelled token stays readable after disposal.
    private void StopAutoRefresh()
    {
        if (_refreshCts is { } cts)
        {
            _refreshCts = null;
            cts.Cancel();
            cts.Dispose();
        }
    }

    public void Dispose()
    {
        _disposed = true;
        StopAutoRefresh();
    }

    private async Task OnConnectionChanged(Guid connectionId)
    {
        _selectedConnectionId = connectionId;
        await LoadQueuesAsync();
        await LoadEchoAsync();
    }

    private async Task OnPrefixChanged(string value)
    {
        _namePrefix = value;
        await LoadQueuesAsync();
    }

    // Only the latest generation applies its result and clears _loading -- see _loadGeneration.
    // A failure clears the "counts read" caption (the counts are no longer current) and shows an
    // inline error; the snackbar fires for user-initiated loads and for the first failure of an
    // auto-refresh streak, never once per failing tick.
    private async Task LoadQueuesAsync(bool fromAutoRefresh = false)
    {
        var generation = ++_loadGeneration;
        var connectionId = _selectedConnectionId;
        var prefix = string.IsNullOrWhiteSpace(_namePrefix) ? null : _namePrefix;
        _loading = true;
        try
        {
            var result = await ListHandler.HandleAsync(connectionId, prefix);
            if (generation != _loadGeneration)
            {
                return;
            }

            if (result.IsSuccess)
            {
                _queues = result.Value!;
                _loadedWithPrefix = prefix is not null;
                _countsReadAt = TimeZoneInfo.ConvertTime(Clock.GetUtcNow(), Clock.LocalTimeZone);
                _loadError = null;
            }
            else
            {
                var alreadyFailing = _loadError is not null;
                _queues = [];
                _countsReadAt = null;
                _loadError = result.Error!;
                if (!(fromAutoRefresh && alreadyFailing))
                {
                    Snackbar.Add(result.Error!, Severity.Error);
                }
            }
        }
        finally
        {
            if (generation == _loadGeneration)
            {
                _loading = false;
            }
        }
    }

    private async Task LoadEchoAsync()
    {
        var generation = ++_echoGeneration;
        var result = await EchoHandler.HandleAsync(_selectedConnectionId);
        if (generation == _echoGeneration)
        {
            _connectionEcho = result.IsSuccess ? result.Value! : "";
        }
    }

    // TimeZoneInfo has no portable abbreviation, so the zone is labelled by its offset.
    private static string ZoneLabel(TimeSpan offset) =>
        offset == TimeSpan.Zero
            ? "UTC"
            : $"UTC{(offset < TimeSpan.Zero ? "-" : "+")}{offset.Duration():hh\\:mm}";

    // Same shape as AwsPlugin.BuildQueueProblemLink -- QueueDetail.razor's route takes the queue URL
    // escaped into a single segment plus ?connectionId=.
    private string DetailUrl(string queueUrl) =>
        $"/p/aws/queues/{Uri.EscapeDataString(queueUrl)}?connectionId={_selectedConnectionId}";

    private string ReceiveUrl(string queueUrl, string queueName)
    {
        var connection = _connections.Single(c => c.Id == _selectedConnectionId);
        return $"/p/aws/queues/receive?connectionId={connection.Id}&queueUrl={Uri.EscapeDataString(queueUrl)}&queueName={Uri.EscapeDataString(queueName)}";
    }

    private async Task OpenCreate()
    {
        var connection = _connections.Single(c => c.Id == _selectedConnectionId);
        var parameters = new DialogParameters<CreateQueueDialog>
        {
            { x => x.ConnectionId, connection.Id },
            { x => x.ConnectionName, connection.Name },
        };
        var dialog = await DialogService.ShowAsync<CreateQueueDialog>("Create queue", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadQueuesAsync();
        }
    }

    private async Task OpenSend(string queueUrl)
    {
        var connection = _connections.Single(c => c.Id == _selectedConnectionId);
        var queue = _queues.Single(q => q.QueueUrl == queueUrl);
        // ContentBasedDeduplication isn't part of QueueSummary (design spec §5's list columns) --
        // left at its default `false`, so the Deduplication ID field always shows for a FIFO queue
        // even when the queue itself has content-based dedup on. Harmless: the field can be left
        // blank if the queue computes one from the body.
        var parameters = new DialogParameters<SendMessageDialog>
        {
            { x => x.ConnectionId, connection.Id },
            { x => x.ConnectionName, connection.Name },
            { x => x.QueueUrl, queue.QueueUrl },
            { x => x.QueueName, queue.Name },
            { x => x.IsFifo, queue.IsFifo },
        };
        var dialog = await DialogService.ShowAsync<SendMessageDialog>("Send message", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadQueuesAsync();
        }
    }

    private async Task OpenRedrive(string queueUrl, string queueArn)
    {
        var connection = _connections.Single(c => c.Id == _selectedConnectionId);
        var queue = _queues.Single(q => q.QueueUrl == queueUrl);
        var confirmed = await Confirmation.ConfirmAsync("Redrive", queue.Name, connection.IsProd);
        if (!confirmed)
        {
            return;
        }

        var parameters = new DialogParameters<RedriveDialog>
        {
            { x => x.ConnectionId, connection.Id },
            { x => x.ConnectionName, connection.Name },
            { x => x.SourceQueueArn, queueArn },
            { x => x.SourceQueueName, queue.Name },
        };
        var dialog = await DialogService.ShowAsync<RedriveDialog>("Redrive from DLQ", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadQueuesAsync();
        }
    }

    private async Task OpenPurge(string queueUrl)
    {
        var connection = _connections.Single(c => c.Id == _selectedConnectionId);
        var queue = _queues.Single(q => q.QueueUrl == queueUrl);
        var confirmed = await Confirmation.ConfirmAsync("Purge", queue.Name, connection.IsProd, count: (int)queue.ApproxVisible);
        if (!confirmed)
        {
            return;
        }

        var parameters = new DialogParameters<PurgeQueueDialog>
        {
            { x => x.ConnectionId, connection.Id },
            { x => x.ConnectionName, connection.Name },
            { x => x.QueueUrl, queue.QueueUrl },
            { x => x.QueueName, queue.Name },
            { x => x.ApproxVisibleCount, queue.ApproxVisible },
        };
        var dialog = await DialogService.ShowAsync<PurgeQueueDialog>("Purge queue", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadQueuesAsync();
        }
    }

    private async Task DeleteAsync(string queueUrl, string queueName)
    {
        var connection = _connections.Single(c => c.Id == _selectedConnectionId);
        var confirmed = await Confirmation.ConfirmAsync("Delete", queueName, connection.IsProd);
        if (!confirmed)
        {
            return;
        }

        _deletingQueue = queueUrl;
        try
        {
            var result = await DeleteHandler.HandleAsync(new DeleteQueueCommand(connection.Id, connection.Name, queueUrl, queueName));
            if (!result.IsSuccess)
            {
                Snackbar.Add(result.Error!, Severity.Error);
            }
        }
        finally
        {
            _deletingQueue = null;
        }

        await LoadQueuesAsync();
    }
}
