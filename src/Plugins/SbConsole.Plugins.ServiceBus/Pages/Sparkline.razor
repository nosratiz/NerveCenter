@* Small inline trend line for one table cell. Deliberately takes a shared Max from the caller
   rather than normalizing against its own Values, so every sparkline in a column is drawn to the
   same y-scale: a flat line reliably means "flat", not "too small to see next to a bigger row" --
   see the mockup's own caption on the Queues page. *@
<svg width="@Width" height="@Height" viewBox="@($"0 0 {Width} {Height}")" class="sparkline">
    @if (Values.Count >= 2 && Max > 0)
    {
        <polyline points="@Points" fill="none" stroke="@Color" stroke-width="1.5" />
    }
    else
    {
        <line x1="0" y1="@(Height - 1)" x2="@Width" y2="@(Height - 1)" stroke="@Color" stroke-width="1" opacity="0.35" />
    }
</svg>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<long> Values { get; set; } = [];
    [Parameter] public long Max { get; set; }
    [Parameter] public string Color { get; set; } = "var(--mud-palette-primary)";
    [Parameter] public int Width { get; set; } = 72;
    [Parameter] public int Height { get; set; } = 22;

    private string Points => string.Join(" ", Values.Select((value, index) =>
    {
        var x = Values.Count == 1 ? 0 : index * (double)Width / (Values.Count - 1);
        var y = Max <= 0 ? Height - 1 : Height - 1 - value / (double)Max * (Height - 2);
        return FormattableString.Invariant($"{x:0.##},{y:0.##}");
    }));
}
