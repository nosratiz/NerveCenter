@using System.Globalization
@using System.Text.Encodings.Web
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Web
@using SbConsole.Plugins.Redis.Client
@using SbConsole.Plugins.Redis.Keys
@inject KeysQueryHandler QueryHandler
@inject SetHashFieldCommandHandler SetFieldHandler
@inject DeleteHashFieldCommandHandler DeleteFieldHandler
@inject RevealHashFieldCommandHandler RevealHandler
@inject ISnackbar Snackbar

@* Hash value panel (mockup 1b, right pane): an HSCAN MATCH filter, "+ Field", a Table/JSON
   toggle, then FIELD / VALUE / SIZE / ⋯ rows. Secret-looking fields stay masked (in both views)
   until an audited reveal; values are previewed, never dumped whole, since one field can be MBs. *@
<div class="he">
    <div class="he-toolbar">
        <MudTextField id="hash-editor-filter" data-testid="hash-editor-filter" T="string" Class="he-filter" Value="_filter"
                      ValueChanged="v => _filter = v ?? string.Empty" Placeholder="Filter fields (HSCAN)…" Immediate="true"
                      Variant="Variant.Outlined" Margin="Margin.Dense" OnKeyDown="OnFilterKeyDownAsync" />
        <button type="button" class="rds-link hash-editor-add-toggle" @onclick="ToggleAdd">+ Field</button>
        <span class="rds-spacer"></span>
        <div class="rds-segmented">
            <button type="button" class="@("hash-editor-view-table" + (_jsonView ? "" : " rds-active"))" @onclick="() => _jsonView = false">Table</button>
            <button type="button" class="@("hash-editor-view-json" + (_jsonView ? " rds-active" : ""))" @onclick="() => _jsonView = true">JSON</button>
        </div>
    </div>

    @if (_adding)
    {
        <div class="he-add">
            <MudTextField id="hash-editor-new-field" data-testid="hash-editor-new-field" T="string" Class="he-mono" Value="_newField"
                          ValueChanged="v => _newField = v ?? string.Empty" Placeholder="field" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudTextField id="hash-editor-new-value" data-testid="hash-editor-new-value" T="string" Class="he-mono he-grow" Value="_newValue"
                          ValueChanged="v => _newValue = v ?? string.Empty" Placeholder="value" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <button type="button" class="rds-btn-primary hash-editor-add-field" disabled="@string.IsNullOrWhiteSpace(_newField)" @onclick="AddFieldAsync">HSET</button>
            <button type="button" class="rds-link" @onclick="() => _adding = false">Cancel</button>
        </div>
    }

    @if (_loading && _page is null)
    {
        <div class="rds-skeleton hash-editor-loading"></div>
        <div class="rds-skeleton" style="width:70%"></div>
        <div class="rds-skeleton" style="width:50%"></div>
    }
    else if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="hash-editor-error">@_error</MudAlert>
    }
    else if (_page is not null)
    {
        @if (_jsonView)
        {
            <RedisJsonCode Json="@JsonView" Class="he-json hash-editor-json" />
        }
        else if (_page.Fields.Count == 0)
        {
            <div class="rds-empty hash-editor-empty">@(string.IsNullOrEmpty(_appliedPattern) ? "This hash has no fields." : "No fields match this filter.")</div>
        }
        else
        {
            <table class="rds-table hash-editor-fields">
                <thead>
                    <tr><th>Field</th><th>Value</th><th class="rds-num">Size</th><th class="he-menu-col"></th></tr>
                </thead>
                <tbody>
                    @foreach (var field in _page.Fields)
                    {
                        var masked = IsMasked(field.Field);
                        var age = masked ? null : AgeHint(field.Value);
                        <tr class="hash-field-row">
                            <td class="he-field hash-field-name">@field.Field</td>
                            <td class="he-value hash-field-value">
                                @if (masked)
                                {
                                    <span class="he-mask">••••••••</span>
                                    <button type="button" class="rds-link he-reveal hash-field-reveal" @onclick="() => RevealAsync(field.Field)">reveal</button>
                                }
                                else
                                {
                                    @Preview(field.Value)
                                    @if (age is not null)
                                    {
                                        <span class="he-age rds-warn hash-field-age">@age</span>
                                    }
                                }
                            </td>
                            <td class="@("rds-num he-size hash-field-size" + (field.SizeBytes > 1024 ? " rds-warn" : ""))">@RedisFormat.Bytes(field.SizeBytes)</td>
                            <td class="he-menu-col">
                                <MudMenu Class="hash-field-menu" Icon="@Icons.Material.Filled.MoreHoriz" Size="Size.Small" Dense="true"
                                         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" AriaLabel="@($"Actions for {field.Field}")">
                                    <MudMenuItem Class="hash-field-edit" OnClick="() => StartEdit(field)">Edit field</MudMenuItem>
                                    <MudMenuItem Class="hash-field-delete" OnClick="() => DeleteFieldAsync(field.Field)">
                                        <span class="mud-error-text">Delete field</span>
                                    </MudMenuItem>
                                </MudMenu>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <div class="he-footer">
            <span class="rds-muted hash-editor-field-count">@RedisFormat.Count(_page.Fields.Count) of @RedisFormat.Count(_page.TotalFieldCount) fields@(string.IsNullOrEmpty(_appliedPattern) ? "" : " (filtered)")</span>
            @if (!_page.Complete)
            {
                <button type="button" class="rds-link hash-editor-load-more" @onclick="LoadMoreAsync">Load more</button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public Guid ConnectionId { get; set; }
    [Parameter] public string ConnectionName { get; set; } = "";
    [Parameter] public int Database { get; set; }
    [Parameter] public string Key { get; set; } = "";

    /// <summary>Raised with HLEN (the page's "{n} fields" meta) after each load.</summary>
    [Parameter] public EventCallback<long> CountChanged { get; set; }

    private const int PageSize = 200;
    private const int PreviewChars = 72;
    private const int ArrayPreviewItems = 2;
    private const int StaleAfterDays = 30;

    private HashFieldPage? _page;
    private readonly HashSet<string> _revealed = [];
    private bool _loading;
    private string? _error;
    private string _filter = "";
    private string? _appliedPattern;
    private bool _jsonView;
    private bool _adding;
    private string _newField = "";
    private string _newValue = "";
    private string? _loadedIdentity;

    protected override async Task OnParametersSetAsync()
    {
        var identity = $"{ConnectionId}/{Database}/{Key}";
        if (_loadedIdentity != identity)
        {
            _loadedIdentity = identity;
            _page = null;
            _filter = "";
            _appliedPattern = null;
            _revealed.Clear();
            await LoadAsync();
        }
    }

    private bool IsMasked(string field) => RedisSecretFieldMasking.IsSensitive(field) && !_revealed.Contains(field);

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        var result = await QueryHandler.ScanHashFieldsAsync(ConnectionId, Database, Key, _appliedPattern, 0, PageSize);
        if (result.IsSuccess)
        {
            _page = result.Value;
            if (string.IsNullOrEmpty(_appliedPattern))
            {
                await CountChanged.InvokeAsync(_page!.TotalFieldCount);
            }
        }
        else
        {
            _error = result.Error;
        }
        _loading = false;
    }

    private async Task OnFilterKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key != "Enter")
        {
            return;
        }

        var text = _filter.Trim();
        // A bare word is a substring search; anything with glob syntax goes to HSCAN MATCH as typed.
        _appliedPattern = text.Length == 0 ? null : text.IndexOfAny(['*', '?', '[']) >= 0 ? text : $"*{text}*";
        await LoadAsync();
    }

    private async Task LoadMoreAsync()
    {
        if (_page is null)
        {
            return;
        }

        var result = await QueryHandler.ScanHashFieldsAsync(ConnectionId, Database, Key, _appliedPattern, _page.Cursor, PageSize);
        if (result.IsSuccess)
        {
            var merged = _page.Fields.Concat(result.Value!.Fields).ToList();
            _page = result.Value! with { Fields = merged };
        }
        else
        {
            Snackbar.Add(result.Error!, Severity.Error);
        }
    }

    /// <summary>
    /// The loaded fields as one object. A field whose value is itself a JSON object/array is
    /// embedded as JSON rather than an escaped string (prefs, recentViews), which is how people
    /// read these; masked fields stay masked here too.
    /// </summary>
    private string JsonView
    {
        get
        {
            using var buffer = new MemoryStream();
            using (var writer = new Utf8JsonWriter(buffer, new JsonWriterOptions { Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping }))
            {
                writer.WriteStartObject();
                foreach (var entry in _page?.Fields ?? [])
                {
                    writer.WritePropertyName(entry.Field);
                    if (IsMasked(entry.Field))
                    {
                        writer.WriteStringValue("••••••••");
                    }
                    else if (AsEmbeddedJson(entry.Value) is { } json)
                    {
                        writer.WriteRawValue(json, skipInputValidation: true);
                    }
                    else
                    {
                        writer.WriteStringValue(entry.Value);
                    }
                }

                writer.WriteEndObject();
            }

            return System.Text.Encoding.UTF8.GetString(buffer.ToArray());
        }
    }

    private static string? AsEmbeddedJson(string value)
    {
        if (!RedisValuePreview.LooksLikeJson(value))
        {
            return null;
        }

        try
        {
            using var doc = JsonDocument.Parse(value);
            return doc.RootElement.GetRawText();
        }
        catch (JsonException)
        {
            return null;
        }
    }

    /// <summary>Short values verbatim; a long JSON array as its first items plus "… N more ]"; anything else cut with "…".</summary>
    internal static string Preview(string value)
    {
        if (value.Length <= PreviewChars)
        {
            return value;
        }

        if (value.TrimStart().StartsWith('['))
        {
            try
            {
                using var doc = JsonDocument.Parse(value);
                if (doc.RootElement.ValueKind == JsonValueKind.Array)
                {
                    var items = doc.RootElement.EnumerateArray().ToList();
                    var shown = items.Take(ArrayPreviewItems).Select(i => Cut(i.GetRawText(), 30));
                    var rest = items.Count - Math.Min(items.Count, ArrayPreviewItems);
                    return rest > 0
                        ? $"[ {string.Join(", ", shown)}, … {RedisFormat.Count(rest)} more ]"
                        : $"[ {string.Join(", ", shown)} ]";
                }
            }
            catch (JsonException)
            {
                // Not actually JSON -- fall through to the plain cut.
            }
        }

        return Cut(value, PreviewChars);
    }

    private static string Cut(string value, int max) => value.Length <= max ? value : value[..max] + "…";

    /// <summary>"57 days old" for an ISO-8601 timestamp more than 30 days in the past -- stale sessions are the usual reason to open a hash.</summary>
    internal static string? AgeHint(string value)
    {
        // Cheap shape check first ("yyyy-MM-ddT..."), so ordinary values never hit the parser.
        if (value.Length is < 19 or > 40 || !char.IsAsciiDigit(value[0]) || value[4] != '-' || value[7] != '-' || value[10] != 'T')
        {
            return null;
        }

        if (!DateTimeOffset.TryParse(value, CultureInfo.InvariantCulture, DateTimeStyles.AssumeUniversal, out var at))
        {
            return null;
        }

        var days = (int)Math.Floor((DateTimeOffset.UtcNow - at).TotalDays);
        return days > StaleAfterDays ? $"{days} days old" : null;
    }

    private void ToggleAdd()
    {
        _adding = !_adding;
        if (_adding)
        {
            _newField = "";
            _newValue = "";
        }
    }

    private void StartEdit(HashFieldEntry field)
    {
        _newField = field.Field;
        _newValue = IsMasked(field.Field) ? "" : field.Value;
        _adding = true;
    }

    private async Task RevealAsync(string field)
    {
        _revealed.Add(field);
        await RevealHandler.RecordAsync(new RevealHashFieldCommand(ConnectionId, ConnectionName, Database, Key, field));
    }

    private async Task DeleteFieldAsync(string field)
    {
        var result = await DeleteFieldHandler.HandleAsync(new DeleteHashFieldCommand(ConnectionId, ConnectionName, Database, Key, field));
        if (result.IsSuccess)
        {
            Snackbar.Add($"Deleted field {field}", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(result.Error!, Severity.Error);
        }
    }

    private async Task AddFieldAsync()
    {
        if (string.IsNullOrWhiteSpace(_newField))
        {
            return;
        }

        var result = await SetFieldHandler.HandleAsync(new SetHashFieldCommand(ConnectionId, ConnectionName, Database, Key, _newField, _newValue));
        if (result.IsSuccess)
        {
            Snackbar.Add($"Set field {_newField}", Severity.Success);
            _newField = "";
            _newValue = "";
            _adding = false;
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(result.Error!, Severity.Error);
        }
    }
}
