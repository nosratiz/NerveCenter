@using System.Globalization
@* Minimal inline-SVG trend line. Stroke is currentColor, so the parent's rds-accent/rds-warn/
   rds-danger class sets the tone. Renders nothing until there are two points to join. *@
@if (Values.Count >= 2)
{
    <svg class="rds-sparkline @Class" viewBox="0 0 100 30" preserveAspectRatio="none" aria-hidden="true">
        <polyline points="@Points" />
    </svg>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<double> Values { get; set; } = [];

    [Parameter] public string? Class { get; set; }

    private string Points
    {
        get
        {
            var min = Values.Min();
            var max = Values.Max();
            // The vertical span is at least 25% of the values' magnitude, so a 97.7 -> 98.0 wobble
            // stays a small movement instead of stretching to full height, and a flat series lies
            // along the bottom (the baseline) like the mockup's quiet tiles.
            var span = Math.Max(max - min, Math.Max(Math.Abs(max), 1) * 0.25);
            var step = 100.0 / (Values.Count - 1);
            return string.Join(' ', Values.Select((v, i) =>
            {
                var y = 28 - (v - min) / span * 26;
                return string.Create(CultureInfo.InvariantCulture, $"{i * step:0.##},{y:0.##}");
            }));
        }
    }
}
