@using SbConsole.Plugins.Redis.Streams
@inject TrimStreamCommandHandler TrimHandler
@inject IConfirmationService Confirmation

@* The Streams header's "Trim…" action (mockup 1d). XTRIM is Destructive, so it still goes through
   IConfirmationService; IsProd is passed in by the page from its server-resolved ConnectionInfo. *@
<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2 mud-text-secondary">
            XTRIM MAXLEN drops the oldest entries of <span style="font-family:monospace">@Key</span> permanently
            (currently @RedisFormat.Count(Length) entries). Consumer groups keep pointing at the ids they had.
        </MudText>
        <MudNumericField id="streams-trim-maxlen" data-testid="streams-trim-maxlen" Class="streams-trim-maxlen" T="long" Value="_maxLen"
                         ValueChanged="v => _maxLen = v" Label="Keep at most (entries)" Min="0" Immediate="true" HideSpinButtons="true" />

        @if (_error is not null)
        {
            <MudAlert Class="streams-trim-error mt-3" Severity="Severity.Error" Dense="true">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        @if (_busy)
        {
            <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
        }
        <MudButton Class="streams-trim-submit" Variant="Variant.Filled" Color="Color.Error" Disabled="@(_busy || _maxLen < 0)" OnClick="TrimAsync">Trim</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Guid ConnectionId { get; set; }
    [Parameter] public string ConnectionName { get; set; } = "";
    [Parameter] public int Database { get; set; }
    [Parameter] public string Key { get; set; } = "";
    [Parameter] public bool IsProd { get; set; }
    [Parameter] public long Length { get; set; }

    private long _maxLen = 1000;
    private string? _error;
    private bool _busy;

    private async Task TrimAsync()
    {
        if (!await Confirmation.ConfirmAsync("Trim", Key, IsProd))
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var result = await TrimHandler.HandleAsync(new TrimStreamCommand(ConnectionId, ConnectionName, Database, Key, _maxLen));
            if (result.IsSuccess)
            {
                MudDialog.Close(DialogResult.Ok(_maxLen));
            }
            else
            {
                _error = result.Error;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
