    private async Task DeleteSelectedAsync()
    {
        if (_selection is not { } selection || _selectedStreamKey is not { } key)
        {
            return;
        }

        var ids = CheckedIds();
        if (ids.Count == 0)
        {
            return;
        }

        // Destructive: IsProd comes from the server-resolved connection picker, never the client.
        // One entry confirms against its id; several against the stream, with a count.
        var confirmed = ids.Count == 1
            ? await Confirmation.ConfirmAsync("Delete", ids[0], selection.Connection.IsProd)
            : await Confirmation.ConfirmAsync("Delete", key, selection.Connection.IsProd, ids.Count);
        if (!confirmed)
        {
            return;
        }

        var result = await DeleteEntriesHandler.HandleAsync(new DeleteStreamEntriesCommand(selection.Connection.Id, selection.Connection.Name, selection.Database, key, ids));
        if (result.IsSuccess)
        {
            _actionError = null;
            Snackbar.Add($"Deleted {ids.Count} entr{(ids.Count == 1 ? "y" : "ies")}", Severity.Success);
            ResetPendingSelection();
            await LoadDetailAsync();
        }
        else
        {
            _actionError = result.Error;
        }
    }

    /// <summary>A substituted IDialogService in tests hands back a reference whose Result is null; treat that as cancelled.</summary>
    private static async Task<DialogResult?> DialogResultAsync(IDialogReference? dialog) =>
        dialog?.Result is { } result ? await result : null;
