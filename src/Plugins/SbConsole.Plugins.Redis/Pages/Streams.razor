    // ---- consumers ----

    private async Task ClaimToLiveAsync(StreamConsumer stalled, StreamConsumer live)
    {
        if (_selection is not { } selection || _selectedStreamKey is not { } key || _selectedGroup is not { } group)
        {
            return;
        }

        _actionError = null;
        var result = await QueryHandler.GetPendingEntriesAsync(selection.Connection.Id, selection.Database, key, group, ClaimSweepCount);
        if (!result.IsSuccess)
        {
            _actionError = result.Error;
            return;
        }

        var ids = result.Value!.Where(p => p.Consumer == stalled.Name).Select(p => p.Id).ToList();
        if (ids.Count == 0)
        {
            _actionError = $"{stalled.Name} no longer holds any pending entries.";
            await LoadDetailAsync();
            return;
        }

        await OpenClaimDialogAsync(ids, live.Name, stalled.Name);
    }

    private async Task DeleteConsumerAsync(StreamConsumer consumer)
    {
        if (_selection is not { } selection || _selectedStreamKey is not { } key || _selectedGroup is not { } group)
        {
            return;
        }

        // Destructive: IsProd comes from the server-resolved connection picker, never the client.
        if (!await Confirmation.ConfirmAsync("Delete consumer", consumer.Name, selection.Connection.IsProd))
        {
            return;
        }

        _confirmingDeleteConsumer = null;
        var result = await DeleteConsumerHandler.HandleAsync(new DeleteStreamConsumerCommand(selection.Connection.Id, selection.Connection.Name, selection.Database, key, group, consumer.Name));
        if (result.IsSuccess)
        {
            _actionError = null;
            Snackbar.Add($"Deleted consumer {consumer.Name}", Severity.Success);
            ResetPendingSelection();
            await LoadDetailAsync();
        }
        else
        {
            _actionError = result.Error;
        }
    }

    // ---- pending entries: bulk actions on the checked rows ----

    private async Task ClaimSelectedAsync()
    {
        var ids = CheckedIds();
        if (ids.Count == 0)
        {
            return;
        }

        var owners = Pending.Where(p => _checked.Contains(p.Id)).Select(p => p.Consumer).ToHashSet();
        var target = _consumers.Where(c => !IsStalled(c) && !owners.Contains(c.Name)).MinBy(c => c.Idle)
            ?? _consumers.Where(c => !IsStalled(c)).MinBy(c => c.Idle);
        await OpenClaimDialogAsync(ids, target?.Name ?? "", null);
    }

    private async Task OpenClaimDialogAsync(IReadOnlyList<string> ids, string consumer, string? from)
    {
        if (_selection is not { } selection || _selectedStreamKey is not { } key || _selectedGroup is not { } group)
        {
            return;
        }

        var parameters = new DialogParameters
        {
            [nameof(StreamClaimDialog.ConnectionId)] = selection.Connection.Id,
            [nameof(StreamClaimDialog.ConnectionName)] = selection.Connection.Name,
            [nameof(StreamClaimDialog.Database)] = selection.Database,
            [nameof(StreamClaimDialog.Key)] = key,
            [nameof(StreamClaimDialog.Group)] = group,
            [nameof(StreamClaimDialog.EntryIds)] = ids,
            [nameof(StreamClaimDialog.Consumers)] = (IReadOnlyList<string>)[.. _consumers.Select(c => c.Name)],
            [nameof(StreamClaimDialog.Consumer)] = consumer,
            [nameof(StreamClaimDialog.From)] = from,
        };
        var dialog = await DialogService.ShowAsync<StreamClaimDialog>("Claim pending entries", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await DialogResultAsync(dialog) is { Canceled: false, Data: int claimed })
        {
            Snackbar.Add($"Claimed {claimed} of {ids.Count} entr{(ids.Count == 1 ? "y" : "ies")}", Severity.Success);
            _checked.Clear();
            await LoadDetailAsync();
        }
    }

