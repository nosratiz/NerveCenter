@using SbConsole.Plugins.Aws.Client
@using SbConsole.Plugins.Aws.Subscriptions
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudSelect T="string" Class="protocol-select" @bind-Value="_protocol" Label="Protocol">
            <MudSelectItem Value="@("sqs")">sqs</MudSelectItem>
            <MudSelectItem Value="@("https")">https</MudSelectItem>
            <MudSelectItem Value="@("email")">email</MudSelectItem>
            <MudSelectItem Value="@("lambda")">lambda</MudSelectItem>
        </MudSelect>
        <MudTextField id="subscribe-endpoint" @bind-Value="_endpoint" Label="Endpoint" Required="true" Immediate="true" />
        <MudSwitch T="bool" Class="raw-delivery-toggle" @bind-Value="_rawMessageDelivery" Label="Raw message delivery" Color="Color.Primary" />
        <MudSwitch T="bool" Class="filter-policy-toggle" @bind-Value="_useFilterPolicy" Label="Filter policy" Color="Color.Primary" />
        @if (_useFilterPolicy)
        {
            <MudSelect T="string" Class="filter-scope-select" @bind-Value="_filterScope" Label="Filter scope">
                <MudSelectItem Value="@FilterPolicyValidator.MessageAttributes">Message attributes</MudSelectItem>
                <MudSelectItem Value="@FilterPolicyValidator.MessageBody">Message body</MudSelectItem>
            </MudSelect>
            <MudTextField id="subscribe-filter-policy" @bind-Value="_filterPolicy" Label="Filter policy (JSON)" Lines="6" Immediate="true" Class="mt-2"
                          Style="font-family:monospace" HelperText="Leave empty for no filter." />
            @if (FilterValidation.Error is { } filterError)
            {
                <MudText Typo="Typo.caption" Color="Color.Error" Class="filter-policy-error">@filterError</MudText>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        @if (_busy)
        {
            <MudProgressCircular Class="subscribe-busy" Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
        }
        <MudButton Class="confirm-subscribe" Color="Color.Primary" Variant="Variant.Filled" Disabled="@(string.IsNullOrWhiteSpace(_endpoint) || !FilterValidation.IsValid || _busy)" OnClick="Save">Subscribe</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Guid ConnectionId { get; set; }
    [Parameter] public string ConnectionName { get; set; } = "";
    [Parameter] public string TopicArn { get; set; } = "";
    [Parameter] public string TopicName { get; set; } = "";

    [Inject] private SubscribeCommandHandler SubscribeHandler { get; set; } = default!;

    private string _protocol = "sqs";
    private string _endpoint = "";
    private bool _rawMessageDelivery;
    private bool _busy;
    private bool _useFilterPolicy;
    private string _filterPolicy = "";
    private string _filterScope = FilterPolicyValidator.MessageAttributes;

    // An editor that's toggled off (or left empty) means "no filter" -- always valid.
    private FilterPolicyValidator.Result FilterValidation => _useFilterPolicy
        ? FilterPolicyValidator.Validate(_filterPolicy, _filterScope)
        : new FilterPolicyValidator.Result(true, true, null);

    private async Task Save()
    {
        _busy = true;
        try
        {
            var withFilter = !FilterValidation.IsClear;
            var request = new SubscribeRequest(TopicArn, _protocol, _endpoint, _rawMessageDelivery,
                withFilter ? _filterPolicy.Trim() : null,
                withFilter ? _filterScope : null);
            var result = await SubscribeHandler.HandleAsync(new SubscribeCommand(ConnectionId, ConnectionName, TopicName, request));
            if (result.IsSuccess)
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(result.Error!, Severity.Error);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
