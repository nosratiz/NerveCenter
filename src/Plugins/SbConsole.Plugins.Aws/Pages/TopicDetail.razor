@page "/p/aws/topics/{TopicArnEncoded}"
@using SbConsole.Plugins.Aws.Client
@using System.Text.Json
@using SbConsole.Plugins.Aws.Subscriptions
@using SbConsole.Plugins.Aws.Topics
@using SbConsole.Sdk
@inject ListSubscriptionsQueryHandler ListHandler
@inject GetTopicAttributesQueryHandler AttributesHandler
@inject GetTopicDeliveryLogsQueryHandler DeliveryLogsHandler
@inject SubscribeCommandHandler SubscribeHandler
@inject UnsubscribeCommandHandler UnsubscribeHandler
@inject IConnectionProvider Connections
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IConfirmationService Confirmation

<PageTitle>@TopicName</PageTitle>
<div class="d-flex align-center gap-2 mb-2">
    <MudLink Href="/p/aws/topics">Topics</MudLink>
    <MudText>/</MudText>
    <MudText Style="font-family:monospace">@TopicName</MudText>
</div>

<MudTabs ActivePanelIndex="_activeTab" ActivePanelIndexChanged="OnActiveTabChangedAsync">
    <MudTabPanel Text="Subscriptions">
        <div class="d-flex align-center gap-2 mb-2">
            <MudText Typo="Typo.caption" Class="topic-arn mud-text-secondary" Style="font-family:monospace">@TopicArn</MudText>
            <MudSpacer />
            <MudButton Class="publish-action" OnClick="OpenPublish">Publish</MudButton>
            <MudButton Class="subscribe-action" Color="Color.Primary" Variant="Variant.Outlined" OnClick="OpenSubscribe">+ Subscribe</MudButton>
        </div>
        @if (_loading)
        {
            <MudProgressCircular Class="subs-busy" Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
        }
        else
        {
            <MudTable Items="_subscriptions">
                <HeaderContent>
                    <MudTh>Protocol</MudTh>
                    <MudTh>Endpoint</MudTh>
                    <MudTh>Filter policy</MudTh>
                    <MudTh>Raw delivery</MudTh>
                    <MudTh>State</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Protocol</MudTd>
                    <MudTd Style="font-family:monospace">@context.Endpoint</MudTd>
                    <MudTd Class="filter-policy" Style="font-family:monospace">@(context.FilterPolicyJson ?? "none")</MudTd>
                    <MudTd>@(context.RawMessageDelivery is { } raw ? (raw ? "On" : "Off") : "n/a")</MudTd>
                    <MudTd Class="sub-state">
                        @if (context.IsPending)
                        {
                            <MudChip T="string" Color="Color.Warning" Size="Size.Small">Pending</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Success" Size="Size.Small">Confirmed</MudChip>
                        }
                    </MudTd>
                    <MudTd>
                        @if (context.IsPending)
                        {
                            <MudButton Class="resend-action" OnClick="@(() => ResendAsync(context))">Resend</MudButton>
                        }
                        else
                        {
                            @* Confirmed rows only: a pending subscription's ARN is the literal
                               "PendingConfirmation", which SetSubscriptionAttributes can't target. *@
                            <MudButton Class="edit-filter-action" OnClick="@(() => OpenEditFilterAsync(context))">Edit filter</MudButton>
                            <MudButton Class="remove-subscription" Color="Color.Error" OnClick="@(() => RemoveAsync(context))">Remove</MudButton>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudTabPanel>
    <MudTabPanel Text="Attributes">
        @if (_attributesLoading)
        {
            <MudProgressCircular Class="attributes-busy" Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
        }
        else if (_attributesError is not null)
        {
            @AttributesError
        }
        else
        {
            <MudSimpleTable Class="topic-summary-table mb-4" Dense="true">
                <tbody>
                    <tr><td class="attribute-name">ARN</td><td style="font-family:monospace;word-break:break-all">@(Attr("TopicArn") ?? TopicArn)</td></tr>
                    <tr><td class="attribute-name">Display name</td><td>@(Attr("DisplayName") is { Length: > 0 } displayName ? displayName : "none")</td></tr>
                    <tr><td class="attribute-name">Owner</td><td style="font-family:monospace">@(Attr("Owner") ?? "n/a")</td></tr>
                    <tr><td class="attribute-name">FIFO</td><td>@YesNo(Attr("FifoTopic"))</td></tr>
                    <tr><td class="attribute-name">Content-based dedup</td><td>@YesNo(Attr("ContentBasedDeduplication"))</td></tr>
                    <tr><td class="attribute-name">KMS key</td><td style="font-family:monospace;word-break:break-all">@(Attr("KmsMasterKeyId") ?? "none")</td></tr>
                    <tr><td class="attribute-name">Subscriptions confirmed</td><td class="subs-confirmed">@(Attr("SubscriptionsConfirmed") ?? "n/a")</td></tr>
                    <tr><td class="attribute-name">Subscriptions pending</td><td class="subs-pending">@(Attr("SubscriptionsPending") ?? "n/a")</td></tr>
                    <tr><td class="attribute-name">Subscriptions deleted</td><td class="subs-deleted">@(Attr("SubscriptionsDeleted") ?? "n/a")</td></tr>
                </tbody>
            </MudSimpleTable>

            <MudText Typo="Typo.subtitle2" Class="mb-1">All other attributes</MudText>
            <MudSimpleTable Class="attributes-table" Dense="true">
                <tbody>
                    @foreach (var entry in _attributes.Where(a => !SummaryKeys.Contains(a.Key)).OrderBy(a => a.Key, StringComparer.Ordinal))
                    {
                        <tr>
                            <td class="attribute-name">@entry.Key</td>
                            <td style="font-family:monospace;word-break:break-all">@entry.Value</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </MudTabPanel>
    <MudTabPanel Text="Access policy">
        @if (_attributesLoading)
        {
            <MudProgressCircular Class="policy-busy" Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
        }
        else if (_attributesError is not null)
        {
            @AttributesError
        }
        else
        {
            <MudText Typo="Typo.subtitle2" Class="mb-1">Access policy</MudText>
            @if (Attr("Policy") is { Length: > 0 } policy)
            {
                @PolicyBlock(("topic-policy", policy))
            }
            else
            {
                <MudText Typo="Typo.body2" Class="topic-policy-none mud-text-secondary mb-4">No access policy set.</MudText>
            }
            @if (Attr("DeliveryPolicy") is { Length: > 0 } deliveryPolicy)
            {
                <MudText Typo="Typo.subtitle2" Class="mb-1">Delivery policy</MudText>
                @PolicyBlock(("topic-delivery-policy", deliveryPolicy))
            }
            @if (Attr("EffectiveDeliveryPolicy") is { Length: > 0 } effectiveDeliveryPolicy)
            {
                <MudText Typo="Typo.subtitle2" Class="mb-1">Effective delivery policy</MudText>
                @PolicyBlock(("topic-effective-delivery-policy", effectiveDeliveryPolicy))
            }
        }
    </MudTabPanel>
    <MudTabPanel Text="Delivery logs">
        @* Read-only. Loaded on first open of this tab only (CloudWatch Logs calls cost time and money,
           so a plain page load never makes them); window changes and Refresh reload. *@
        <div class="d-flex align-center flex-wrap gap-2 mb-2">
            <MudButtonGroup OverrideStyles="false" Size="Size.Small">
                @foreach (var option in WindowOptions)
                {
                    <MudButton Class="@($"delivery-logs-window-{option.Label}")" Size="Size.Small" Color="Color.Primary"
                               Variant="@(option.Window == _logsWindow ? Variant.Filled : Variant.Outlined)"
                               OnClick="@(() => SelectWindowAsync(option.Window))">@option.Label</MudButton>
                }
            </MudButtonGroup>
            <MudButtonGroup OverrideStyles="false" Size="Size.Small">
                <MudButton Class="delivery-logs-status-all" Size="Size.Small" Color="Color.Primary"
                           Variant="@(_failuresOnly ? Variant.Outlined : Variant.Filled)" OnClick="@(() => _failuresOnly = false)">All</MudButton>
                <MudButton Class="delivery-logs-status-failures" Size="Size.Small" Color="Color.Error"
                           Variant="@(_failuresOnly ? Variant.Filled : Variant.Outlined)" OnClick="@(() => _failuresOnly = true)">Failures</MudButton>
            </MudButtonGroup>
            <MudSpacer />
            <MudButton Class="delivery-logs-refresh" Size="Size.Small" Disabled="_logsLoading" OnClick="LoadDeliveryLogsAsync">Refresh</MudButton>
        </div>
        @if (_logsLoading)
        {
            <MudProgressCircular Class="delivery-logs-busy" Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
        }
        else if (_logsError is not null)
        {
            <MudAlert Class="delivery-logs-error" Severity="Severity.Warning" Dense="true">
                Couldn't load delivery logs: @_logsError
            </MudAlert>
        }
        else if (_logs is { LoggingNotConfigured: true })
        {
            <MudAlert Class="delivery-logs-not-configured" Severity="Severity.Info" Dense="true">
                @if (HasDeliveryStatusRoles)
                {
                    <text>Delivery status logging is configured on this topic, but no delivery status logs have been written yet
                    (no <code>@SuccessLogGroup</code> or <code>/Failure</code> log group exists). Logs appear after the next delivery attempt.</text>
                }
                else
                {
                    <text>Delivery status logging isn't enabled for this topic. Enable it under <b>Delivery status logging</b> when
                    editing the topic in the SNS console, or set the topic's per-protocol <code>&lt;Protocol&gt;SuccessFeedbackRoleArn</code> /
                    <code>&lt;Protocol&gt;FailureFeedbackRoleArn</code> attributes (e.g. <code>SQSFailureFeedbackRoleArn</code>). SNS then writes to
                    the <code>@SuccessLogGroup</code> and <code>@(SuccessLogGroup)/Failure</code> CloudWatch Logs groups.</text>
                }
            </MudAlert>
        }
        else if (_logs is not null)
        {
            var rows = _failuresOnly ? _logs.Entries.Where(e => e.IsFailure).ToList() : _logs.Entries;
            @if (rows.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="delivery-logs-empty mud-text-secondary">
                    No delivery status log events@(_failuresOnly ? " for failed deliveries" : "") in the last @WindowLabel(_logsWindow).
                </MudText>
            }
            else
            {
                <MudSimpleTable Class="delivery-logs-table" Dense="true" Hover="true">
                    <thead>
                        <tr>
                            <th>Time (UTC)</th>
                            <th>Status</th>
                            <th>Destination</th>
                            <th>Status code</th>
                            <th>Provider response</th>
                            <th>Dwell (ms)</th>
                            <th>Attempts</th>
                            <th>Message ID</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in rows)
                        {
                            <tr>
                                <td style="white-space:nowrap">@entry.Timestamp.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss.fff", System.Globalization.CultureInfo.InvariantCulture)</td>
                                <td>
                                    <MudChip T="string" Size="Size.Small" Color="@(entry.IsFailure ? Color.Error : Color.Success)">@entry.Status</MudChip>
                                </td>
                                @if (entry.RawMessage is not null)
                                {
                                    @* Unparseable event: show the raw text rather than drop it. *@
                                    <td colspan="6" class="delivery-log-raw" style="font-family:monospace;white-space:pre-wrap;word-break:break-all">@entry.RawMessage</td>
                                }
                                else
                                {
                                    <td style="font-family:monospace;word-break:break-all">@(entry.Destination ?? "n/a")</td>
                                    <td>@(entry.StatusCode?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "n/a")</td>
                                    <td style="font-family:monospace;word-break:break-all">@(entry.ProviderResponse ?? "n/a")</td>
                                    <td>@(entry.DwellTimeMs?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "n/a")</td>
                                    <td>@(entry.Attempts?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "n/a")</td>
                                    <td style="font-family:monospace">@(entry.MessageId ?? "n/a")</td>
                                }
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
            @if (_logs.IsTruncated)
            {
                <MudText Typo="Typo.caption" Class="delivery-logs-truncated mud-text-secondary">
                    Showing the newest @_logs.Entries.Count events found; the window may hold more. Narrow the window to see older events.
                </MudText>
            }
        }
    </MudTabPanel>
</MudTabs>

@code {
    [Parameter] public string TopicArnEncoded { get; set; } = "";
    [SupplyParameterFromQuery] public Guid ConnectionId { get; set; }

    private IReadOnlyList<SubscriptionSummary> _subscriptions = [];
    private bool _loading;
    private IReadOnlyDictionary<string, string> _attributes = new Dictionary<string, string>();
    private bool _attributesLoading;
    private string? _attributesError;

    // Shown in the summary table (or the Access policy tab), so left out of the raw table.
    private static readonly HashSet<string> SummaryKeys = new(StringComparer.Ordinal)
    {
        "TopicArn", "DisplayName", "Owner", "FifoTopic", "ContentBasedDeduplication", "KmsMasterKeyId",
        "SubscriptionsConfirmed", "SubscriptionsPending", "SubscriptionsDeleted",
        "Policy", "DeliveryPolicy", "EffectiveDeliveryPolicy",
    };

    private RenderFragment AttributesError => __builder =>
    {
        <MudAlert Class="topic-attributes-error" Severity="Severity.Warning" Dense="true">
            Couldn't load topic attributes: @_attributesError
        </MudAlert>
    };

    // Read-only by design -- no policy editing (design doc §6.7 completion pass, Task 5).
    private static RenderFragment PolicyBlock((string CssClass, string Json) policy) => __builder =>
    {
        <MudPaper Class="pa-3 mb-4" Outlined="true">
            <pre class="@policy.CssClass" style="font-family:monospace;white-space:pre-wrap;word-break:break-all;margin:0">@FormatJson(policy.Json)</pre>
        </MudPaper>
    };
    private string _connectionName = "";

    // Delivery logs tab (index 3): lazily loaded, state kept across tab switches.
    private const int DeliveryLogsTabIndex = 3;
    private static readonly (string Label, TimeSpan Window)[] WindowOptions =
        [("1h", TimeSpan.FromHours(1)), ("24h", TimeSpan.FromHours(24)), ("7d", TimeSpan.FromDays(7))];
    private int _activeTab;
    private TimeSpan _logsWindow = TimeSpan.FromHours(24);
    private bool _failuresOnly;
    private bool _logsRequested;
    private bool _logsLoading;
    private string? _logsError;
    private DeliveryLogsResult? _logs;
    private int _logsGeneration;

    private static string WindowLabel(TimeSpan window) => WindowOptions.FirstOrDefault(o => o.Window == window).Label ?? window.ToString();

    // Attributes are loaded with the page anyway; used only to word the not-configured message.
    private bool HasDeliveryStatusRoles => _attributes.Any(a => a.Key.EndsWith("FeedbackRoleArn", StringComparison.Ordinal) && a.Value.Length > 0);

    private string SuccessLogGroup
    {
        get
        {
            var parts = TopicArn.Split(':');
            return parts.Length == 6 ? $"sns/{parts[3]}/{parts[4]}/{parts[5]}" : $"sns/<region>/<account-id>/{TopicName}";
        }
    }

    private async Task OnActiveTabChangedAsync(int index)
    {
        _activeTab = index;
        if (index == DeliveryLogsTabIndex && !_logsRequested)
        {
            await LoadDeliveryLogsAsync();
        }
    }

    private async Task SelectWindowAsync(TimeSpan window)
    {
        if (window == _logsWindow && _logs is not null)
        {
            return;
        }

        _logsWindow = window;
        await LoadDeliveryLogsAsync();
    }

    // Its own error state: a denied logs:FilterLogEvents is an inline warning on this tab only. The
    // generation check drops a slower, older load that finishes after a newer one (e.g. 7d then 1h).
    private async Task LoadDeliveryLogsAsync()
    {
        var generation = ++_logsGeneration;
        _logsRequested = true;
        _logsLoading = true;
        StateHasChanged();
        var result = await DeliveryLogsHandler.HandleAsync(ConnectionId, TopicArn, _logsWindow);
        if (generation != _logsGeneration)
        {
            return;
        }

        _logs = result.IsSuccess ? result.Value : null;
        _logsError = result.IsSuccess ? null : result.Error;
        _logsLoading = false;
    }

    private string TopicArn => Uri.UnescapeDataString(TopicArnEncoded);
    private string TopicName => TopicArn[(TopicArn.LastIndexOf(':') + 1)..];

    protected override async Task OnInitializedAsync()
    {
        _connectionName = (await Connections.ListAsync("aws")).FirstOrDefault(c => c.Id == ConnectionId)?.Name ?? "";
        await LoadAsync();
        await LoadAttributesAsync();
    }

    private string? Attr(string key) => _attributes.TryGetValue(key, out var value) ? value : null;

    private static string YesNo(string? value) => value is null ? "n/a" : string.Equals(value, "true", StringComparison.OrdinalIgnoreCase) ? "Yes" : "No";

    // Pretty-prints JSON (indented); anything that isn't valid JSON is returned unchanged so the
    // raw policy string is still visible. Internal static so it's unit-testable directly.
    internal static string FormatJson(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return raw;
        }

        try
        {
            using var document = JsonDocument.Parse(raw);
            return JsonSerializer.Serialize(document.RootElement, IndentedJson);
        }
        catch (JsonException)
        {
            return raw;
        }
    }

    // Relaxed escaping keeps '+', '&', '\'' etc. readable instead of \u00XX -- safe here because
    // Blazor HTML-encodes the rendered text anyway.
    private static readonly JsonSerializerOptions IndentedJson = new()
    {
        WriteIndented = true,
        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
    };

    // Separate from the subscriptions load on purpose: a denied sns:GetTopicAttributes is an
    // inline warning on the Attributes/Access policy tabs, never a page failure.
    private async Task LoadAttributesAsync()
    {
        _attributesLoading = true;
        try
        {
            var result = await AttributesHandler.HandleAsync(ConnectionId, TopicArn);
            _attributes = result.IsSuccess ? result.Value! : new Dictionary<string, string>();
            _attributesError = result.IsSuccess ? null : result.Error;
        }
        finally
        {
            _attributesLoading = false;
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var result = await ListHandler.HandleAsync(ConnectionId, TopicArn);
            if (result.IsSuccess)
            {
                _subscriptions = result.Value!;
            }
            else
            {
                _subscriptions = [];
                Snackbar.Add(result.Error!, Severity.Error);
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenSubscribe()
    {
        var parameters = new DialogParameters<SubscribeDialog>
        {
            { x => x.ConnectionId, ConnectionId },
            { x => x.ConnectionName, _connectionName },
            { x => x.TopicArn, TopicArn },
            { x => x.TopicName, TopicName },
        };
        var dialog = await DialogService.ShowAsync<SubscribeDialog>("Subscribe", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    // Pre-filled from the row itself: _subscriptions comes from ListSubscriptionsAsync, the same
    // call GetSubscriptionFilterPoliciesQueryHandler wraps, and was just loaded -- re-querying
    // would be an identical round trip per subscription.
    private async Task OpenEditFilterAsync(SubscriptionSummary subscription)
    {
        var parameters = new DialogParameters<FilterPolicyDialog>
        {
            { x => x.ConnectionId, ConnectionId },
            { x => x.ConnectionName, _connectionName },
            { x => x.TopicName, TopicName },
            { x => x.SubscriptionArn, subscription.SubscriptionArn },
            { x => x.Endpoint, subscription.Endpoint },
            { x => x.InitialPolicyJson, subscription.FilterPolicyJson },
            { x => x.InitialScope, subscription.FilterPolicyScope },
        };
        var dialog = await DialogService.ShowAsync<FilterPolicyDialog>("Edit filter policy", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private async Task OpenPublish()
    {
        var parameters = new DialogParameters<PublishDialog>
        {
            { x => x.ConnectionId, ConnectionId },
            { x => x.ConnectionName, _connectionName },
            { x => x.TopicArn, TopicArn },
            { x => x.TopicName, TopicName },
            { x => x.IsFifo, TopicName.EndsWith(".fifo", StringComparison.Ordinal) },
        };
        await DialogService.ShowAsync<PublishDialog>("Publish to topic", parameters);
    }

    private async Task ResendAsync(SubscriptionSummary subscription)
    {
        var request = new SubscribeRequest(TopicArn, subscription.Protocol, subscription.Endpoint, subscription.RawMessageDelivery ?? false);
        var result = await SubscribeHandler.HandleAsync(new SubscribeCommand(ConnectionId, _connectionName, TopicName, request));
        if (!result.IsSuccess)
        {
            Snackbar.Add(result.Error!, Severity.Error);
        }

        await LoadAsync();
    }

    private async Task RemoveAsync(SubscriptionSummary subscription)
    {
        var confirmed = await Confirmation.ConfirmAsync("Remove", subscription.Endpoint, false);
        if (!confirmed)
        {
            return;
        }

        var result = await UnsubscribeHandler.HandleAsync(new UnsubscribeCommand(ConnectionId, _connectionName, TopicName, subscription.SubscriptionArn));
        if (!result.IsSuccess)
        {
            Snackbar.Add(result.Error!, Severity.Error);
        }

        await LoadAsync();
    }
}
