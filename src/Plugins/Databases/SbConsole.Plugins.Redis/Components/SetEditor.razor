@using Microsoft.AspNetCore.Components.Web
@using SbConsole.Plugins.Redis.Client
@using SbConsole.Plugins.Redis.Keys
@inject KeysQueryHandler QueryHandler
@inject AddSetMemberCommandHandler AddHandler
@inject RemoveSetMemberCommandHandler RemoveHandler
@inject ISnackbar Snackbar

@* Set value panel (mockup 1c, fourth column): membership check first (SISMEMBER -- how sets are
   actually used), then the members as pills with a trailing "+n" that reveals more (SSCAN-paged,
   so a huge set never loads whole). Remove… switches the pills into a removable state. *@
<div class="ste">
    @if (_loading && _page is null)
    {
        <div class="rds-skeleton set-editor-loading"></div>
        <div class="rds-skeleton" style="width:70%"></div>
    }
    else if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="set-editor-error">@_error</MudAlert>
    }
    else if (_page is not null)
    {
        <div class="ste-summary set-editor-cardinality">SCARD @RedisFormat.Count(_page.Cardinality) · unordered</div>

        <div class="ste-check">
            <MudTextField id="set-editor-ismember" data-testid="set-editor-ismember" T="string" Class="ste-mono ste-grow" Value="_candidate"
                          ValueChanged="OnCandidateChanged" Placeholder="Is member? (SISMEMBER)" Immediate="true"
                          Variant="Variant.Outlined" Margin="Margin.Dense" OnKeyDown="OnCandidateKeyDownAsync" />
            @if (_answer is { } answer)
            {
                <span class="@("ste-answer set-editor-ismember-answer " + (answer.IsMember ? "ste-yes" : "rds-muted"))">
                    @(answer.IsMember ? "✓ is a member" : "✗ not a member")
                </span>
            }
        </div>

        @if (_page.Members.Count == 0)
        {
            <div class="rds-empty set-editor-empty">This set is empty.</div>
        }
        else
        {
            <div class="ste-pills">
                @foreach (var member in _page.Members.Take(_visible))
                {
                    <span class="rds-pill set-member-pill" title="@member">
                        @member
                        @if (_removing)
                        {
                            <button type="button" class="ste-remove set-member-remove" aria-label="@($"Remove {member}")" @onclick="() => RemoveAsync(member)">×</button>
                        }
                    </span>
                }
                @if (HasMore)
                {
                    <button type="button" class="rds-pill rds-pill-accent ste-more set-editor-more" @onclick="ShowMoreAsync">@($"+{RedisFormat.Count(Remaining)}")</button>
                }
            </div>
        }

        @if (_adding)
        {
            <div class="ste-composer">
                <MudTextField id="set-editor-new-member" data-testid="set-editor-new-member" T="string" Class="ste-mono ste-grow" Value="_newMember"
                              ValueChanged="v => _newMember = v ?? string.Empty" Placeholder="member" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <button type="button" class="rds-btn-primary set-editor-add-member" disabled="@string.IsNullOrWhiteSpace(_newMember)" @onclick="AddAsync">SADD</button>
            </div>
        }

        <div class="ste-actions">
            <button type="button" class="rds-btn set-editor-add-toggle" @onclick="() => _adding = !_adding">Add</button>
            <button type="button" class="@(_removing ? "rds-link set-editor-remove-toggle" : "rds-link-danger set-editor-remove-toggle")" @onclick="() => _removing = !_removing">@(_removing ? "Done" : "Remove…")</button>
        </div>
    }
</div>

@code {
    [Parameter] public Guid ConnectionId { get; set; }
    [Parameter] public string ConnectionName { get; set; } = "";
    [Parameter] public int Database { get; set; }
    [Parameter] public string Key { get; set; } = "";

    /// <summary>Raised with SCARD after each load.</summary>
    [Parameter] public EventCallback<long> CountChanged { get; set; }

    private const int PageSize = 200;
    private const int VisibleStep = 24;

    private SetPage? _page;
    private int _visible = VisibleStep;
    private bool _loading;
    private string? _error;
    private bool _adding;
    private bool _removing;
    private string _newMember = "";
    private string _candidate = "";
    private (string Member, bool IsMember)? _answer;
    private string? _loadedIdentity;

    protected override async Task OnParametersSetAsync()
    {
        var identity = $"{ConnectionId}/{Database}/{Key}";
        if (_loadedIdentity != identity)
        {
            _loadedIdentity = identity;
            _page = null;
            _visible = VisibleStep;
            _adding = false;
            _removing = false;
            _candidate = "";
            _answer = null;
            await LoadAsync();
        }
    }

    private int Shown => Math.Min(_visible, _page?.Members.Count ?? 0);

    private long Remaining => Math.Max(0, (_page?.Cardinality ?? 0) - Shown);

    private bool HasMore => _page is not null && Remaining > 0 && (Shown < _page.Members.Count || !_page.Complete);

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        var result = await QueryHandler.ScanSetMembersAsync(ConnectionId, Database, Key, 0, PageSize);
        if (result.IsSuccess)
        {
            _page = result.Value;
            await CountChanged.InvokeAsync(_page!.Cardinality);
        }
        else
        {
            _error = result.Error;
        }
        _loading = false;
    }

    private async Task ShowMoreAsync()
    {
        if (_page is null)
        {
            return;
        }

        _visible += VisibleStep * 2;
        // SSCAN pages may come back short (or empty) mid-iteration, so keep going until the new
        // window is filled or the cursor wraps.
        while (_page.Members.Count < _visible && !_page.Complete)
        {
            var result = await QueryHandler.ScanSetMembersAsync(ConnectionId, Database, Key, _page.Cursor, PageSize);
            if (!result.IsSuccess)
            {
                Snackbar.Add(result.Error!, Severity.Error);
                return;
            }

            var merged = _page.Members.Concat(result.Value!.Members).Distinct(StringComparer.Ordinal).ToList();
            _page = result.Value! with { Members = merged };
        }
    }

    private void OnCandidateChanged(string? value)
    {
        _candidate = value ?? "";
        _answer = null;
    }

    private async Task OnCandidateKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || string.IsNullOrEmpty(_candidate))
        {
            return;
        }

        var member = _candidate;
        var result = await QueryHandler.IsSetMemberAsync(ConnectionId, Database, Key, member);
        if (result.IsSuccess)
        {
            _answer = (member, result.Value);
        }
        else
        {
            Snackbar.Add(result.Error!, Severity.Error);
        }
    }

    private async Task AddAsync()
    {
        if (string.IsNullOrWhiteSpace(_newMember))
        {
            return;
        }

        var result = await AddHandler.HandleAsync(new AddSetMemberCommand(ConnectionId, ConnectionName, Database, Key, _newMember));
        if (result.IsSuccess)
        {
            Snackbar.Add($"Added {_newMember}", Severity.Success);
            _newMember = "";
            _adding = false;
            _answer = null;
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(result.Error!, Severity.Error);
        }
    }

    private async Task RemoveAsync(string member)
    {
        var result = await RemoveHandler.HandleAsync(new RemoveSetMemberCommand(ConnectionId, ConnectionName, Database, Key, member));
        if (result.IsSuccess)
        {
            Snackbar.Add($"Removed {member}", Severity.Success);
            _answer = null;
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(result.Error!, Severity.Error);
        }
    }
}
