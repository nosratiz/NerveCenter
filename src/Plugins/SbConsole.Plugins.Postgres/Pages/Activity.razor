@* Mockups 1d (activity) and 1e (terminate confirmation, rendered by the host's ConfirmDialog). Stock MudBlazor in the Nocturne theme. *@
@page "/p/postgres/activity"
@using System.Globalization
@using SbConsole.Plugins.Postgres.Activity
@using SbConsole.Plugins.Postgres.Client
@inject GetActivityQueryHandler GetActivity
@inject CancelBackendCommandHandler CancelBackend
@inject TerminateBackendCommandHandler TerminateBackend
@inject IConfirmationService Confirmation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject TimeProvider Clock
@implements IAsyncDisposable

<PageTitle>PostgreSQL activity</PageTitle>

<div class="pg-page">
    <PgPageHeader Title="Activity">
        <Chips>
            <PgConnectionPicker Loading="_loading" SelectionChanged="OnSelectionChangedAsync" />
            @if (_userFilter is not null)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="pg-user-filter" OnClose="ClearUserFilter">user: @_userFilter</MudChip>
            }
        </Chips>
        <Meta>
            @if (_data is { } meta)
            {
                <span class="pg-activity-summary">@Summary(meta)</span>
            }
        </Meta>
        <Actions>
            @if (_interval > 0 && _connection is not null)
            {
                <span class="pg-meta pg-next-refresh">next in @_nextIn s</span>
            }
            @if (_connection is not null)
            {
                <MudSelect T="int" Class="pg-autorefresh" Label="Auto-refresh" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                           Value="_interval" ValueChanged="OnIntervalChanged">
                    <MudSelectItem T="int" Value="0">Off</MudSelectItem>
                    <MudSelectItem T="int" Value="5">5 s</MudSelectItem>
                    <MudSelectItem T="int" Value="15">15 s</MudSelectItem>
                </MudSelect>
                <MudSwitch T="bool" Class="pg-active-only" Label="Active only" Color="Color.Primary" Value="_activeOnly" ValueChanged="OnActiveOnlyChanged" />
            }
        </Actions>
    </PgPageHeader>

    @if (_connection is not null)
    {
        @if (_error is not null)
        {
            <div class="pg-body">
                <PgErrorAlert Info="_error" Title="@($"Can't read activity on {_connection.Name}.")" Class="pg-activity-error" />
            </div>
        }

        @if (_banner is { } banner)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="pg-blocker-banner">
                <span><strong class="pg-mono">pid @banner.Backend.Pid</strong>@BannerTail(banner)</span>
                <MudButton Variant="Variant.Text" Size="Size.Small" Class="pg-jump-blocker" OnClick="() => JumpToAsync(banner.Backend.Pid)">Jump to blocker ↓</MudButton>
            </MudAlert>
        }

        <MudTable T="ActivityRow" Class="pg-activity-table" Items="_rows" Dense="true" Hover="true" Elevation="0"
                  RowClassFunc="@((row, _) => RowClass(row))">
            <HeaderContent>
                <MudTh>pid</MudTh><MudTh>User</MudTh><MudTh>Application</MudTh><MudTh>Client</MudTh><MudTh>State</MudTh>
                <MudTh>Wait event</MudTh><MudTh>Query</MudTh><MudTh Class="pg-num">Duration</MudTh><MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                @{ var b = context.Backend; MudMenu? menu = null; }
                <MudTd>
                    <span class="pg-pid pg-mono" id="pg-backend-@b.Pid">@(context.Depth > 0 ? "↳ " : "")@b.Pid</span>
                    @if (context.BlocksCount > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Class="pg-blocks-chip">blocks @context.BlocksCount</MudChip>
                    }
                    @if (context.IsOwn)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="pg-own-chip">this console</MudChip>
                    }
                </MudTd>
                <MudTd Class="pg-mono">@b.User</MudTd>
                <MudTd Class="pg-mono">@b.Application</MudTd>
                <MudTd Class="pg-mono">@b.Client</MudTd>
                <MudTd><MudChip T="string" Size="Size.Small" Color="@StateColor(b)" Class="pg-state-chip">@b.State</MudChip></MudTd>
                <MudTd Class="pg-mono">@b.WaitEvent</MudTd>
                <MudTd Class="pg-mono pg-query-cell"><span title="@b.Query">@Truncate(b.Query)</span></MudTd>
                <MudTd Class="pg-mono pg-num">@(b.State == "idle" || b.Duration is null ? "—" : PgFormat.Duration(b.Duration.Value))</MudTd>
                <MudTd Class="pg-row-actions">
                    <MudButton Variant="Variant.Text" Size="Size.Small" Class="pg-cancel" Disabled="!CanCancel(context)"
                               OnClick="() => CancelAsync(context)">Cancel</MudButton>
                    <MudMenu @ref="menu" Class="pg-row-menu" Icon="@Icons.Material.Filled.MoreHoriz" Size="Size.Small" AriaLabel="@($"Actions for pid {b.Pid}")">
                        <MudMenuItem Class="pg-copy-query" OnClick="() => CopyAsync(b.Query)">Copy query</MudMenuItem>
                        <MudMenuItem Class="pg-filter-user" OnClick="() => FilterByUser(b.User)">Filter by @b.User</MudMenuItem>
                        <MudMenuItem Class="pg-cancel-menu" Disabled="!CanCancel(context)" OnClick="() => CloseThenAsync(menu, () => CancelAsync(context))">Cancel query</MudMenuItem>
                        <MudDivider />
                        <MudMenuItem Class="pg-terminate pg-menu-danger" Disabled="!CanTerminate(context)" OnClick="() => CloseThenAsync(menu, () => TerminateAsync(context))">Terminate backend…</MudMenuItem>
                    </MudMenu>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                @if (_data is not null || _error is not null)
                {
                    <div class="pg-activity-empty pg-muted">No backends to show.</div>
                }
            </NoRecordsContent>
        </MudTable>

        @if (!_activeOnly && (_hiddenIdle > 0 || _showIdle))
        {
            <div class="pg-idle-hidden pg-meta">
                @if (_showIdle)
                {
                    <span>Showing idle backends · </span>
                    <button type="button" class="pg-link pg-show-idle" @onclick="() => SetShowIdle(false)">hide idle</button>
                }
                else
                {
                    <span>… @_hiddenIdle idle @(_hiddenIdle == 1 ? "backend" : "backends") hidden · </span>
                    <button type="button" class="pg-link pg-show-idle" @onclick="() => SetShowIdle(true)">show all</button>
                }
            </div>
        }

        <div class="pg-footnote pg-activity-footnote">
            <span>Blocked rows are indented under their blocker (pg_blocking_pids). Sorted by transaction start.</span>
            <span class="pg-footnote-right">Cancel and Terminate are audited · <a href="/audit">Audit log</a></span>
        </div>
    }
</div>

@code {
    private const int TickSeconds = 1;
    private const int QueryChars = 120;

    private readonly CancellationTokenSource _cts = new();
    private ConnectionInfo? _connection;
    private PgActivity? _data;
    private PgErrorInfo? _error;
    private Guid? _dataConnectionId;
    private IReadOnlyList<ActivityRow> _rows = [];
    private ActivityRow? _banner;
    private int _hiddenIdle;
    private bool _activeOnly;
    private bool _showIdle;
    private string? _userFilter;
    private int _interval = 5;
    private int _nextIn = 5;
    private bool _loading;
    private bool _acting;
    private int _generation;
    private ITimer? _timer;
    private bool _disposed;
    private IJSObjectReference? _module;

    private bool ReadWrite => _connection?.Summary.GetValueOrDefault("Mode") == "read-write";

    private static bool IsIdle(PgBackend b) => b.State.StartsWith("idle", StringComparison.Ordinal);

    private bool CanCancel(ActivityRow r) => ReadWrite && !_acting && !IsIdle(r.Backend) && !IsConsole(r);

    private bool CanTerminate(ActivityRow r) => ReadWrite && !_acting && !IsConsole(r);

    private static bool IsConsole(ActivityRow r) => r.IsOwn || r.Backend.Application == "sbconsole";

    private static string RowClass(ActivityRow r) => "pg-activity-row" + (r.Depth > 0 ? $" pg-depth-{r.Depth}" : "");

    private static Color StateColor(PgBackend b) => b.State switch
    {
        "active" => Color.Success,
        var s when s.StartsWith("idle in transaction", StringComparison.Ordinal) => Color.Warning,
        _ => Color.Default,
    };

    private static string Truncate(string query)
    {
        var line = string.Join(' ', query.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
        return line.Length <= QueryChars ? line : line[..(QueryChars - 1)] + "…";
    }

    private static string Summary(PgActivity a) =>
        string.Create(CultureInfo.InvariantCulture,
            $"{a.Backends.Count} backends · {a.Backends.Count(b => b.BlockedBy.Count > 0)} blocked · {a.Backends.Count(b => b.State.StartsWith("idle in transaction", StringComparison.Ordinal))} idle in txn");

    private string BannerTail(ActivityRow blocker)
    {
        var n = blocker.BlocksCount;
        var on = BannerRelation(blocker) is { } relation ? $" on {relation}" : "";
        return $" has been idle in transaction for {PgFormat.Duration(blocker.Backend.Duration ?? TimeSpan.Zero)} and is blocking {n} {(n == 1 ? "session" : "sessions")}{on}. "
               + "Cancelling does nothing to an idle backend — terminating it will.";
    }

    private string? BannerRelation(ActivityRow blocker) =>
        _data?.Backends.Where(b => b.BlockedBy.Contains(blocker.Backend.Pid)).Select(b => b.WaitingOnRelation).FirstOrDefault(r => !string.IsNullOrEmpty(r));

    private void Recompute()
    {
        if (_data is not { } data)
        {
            _rows = [];
            _banner = null;
            _hiddenIdle = 0;
            return;
        }

        var (rows, hidden) = ActivityTree.Build(data, _activeOnly, _showIdle);
        if (_userFilter is null)
        {
            _rows = rows;
            _hiddenIdle = hidden;
        }
        else
        {
            // Counted after the user filter, so "N idle hidden" matches what show all would add.
            _rows = rows.Where(r => r.Backend.User == _userFilter).ToList();
            _hiddenIdle = Math.Max(0, data.Backends.Count(b => b.State == "idle" && b.User == _userFilter) - _rows.Count(r => r.Backend.State == "idle"));
        }

        // Over all backends, so the banner survives Active only and the user filter.
        var worst = ActivityTree.WorstBlocker(data);
        _banner = worst is not null && worst.BlocksCount > 0 && worst.Backend.State.StartsWith("idle in transaction", StringComparison.Ordinal) ? worst : null;
    }

    private async Task OnSelectionChangedAsync(ConnectionInfo connection)
    {
        if (_connection?.Id != connection.Id)
        {
            _userFilter = null;
        }

        _connection = connection;
        _timer ??= Clock.CreateTimer(_ => _ = TickAsync(), null, TimeSpan.FromSeconds(TickSeconds), TimeSpan.FromSeconds(TickSeconds));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_connection is not { } connection || _disposed)
        {
            return;
        }

        var generation = ++_generation;
        if (_dataConnectionId != connection.Id)
        {
            // Another connection's sessions must never sit under this connection's name while it loads.
            _dataConnectionId = connection.Id;
            _data = null;
            _error = null;
            Recompute();
        }

        _loading = true;
        _nextIn = _interval;
        StateHasChanged();
        try
        {
            var result = await GetActivity.HandleAsync(connection.Id, _cts.Token);
            if (generation != _generation || _disposed)
            {
                return;
            }

            if (result.IsSuccess && result.Value is { } activity)
            {
                _data = activity;
                _error = null;
            }
            else
            {
                _error = new PgErrorInfo(result.Error ?? "Connection not found.", null, null, null, null, null, false);
            }

            Recompute();
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
            return;
        }
        finally
        {
            if (generation == _generation && !_disposed)
            {
                _loading = false;
                _nextIn = _interval;
            }
        }

        if (!_disposed)
        {
            // Also repaints timer-driven reloads (the Overview page lesson): the callback ran on the renderer's context.
            StateHasChanged();
        }
    }

    private async Task TickAsync()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                if (_disposed || _loading || _acting || _interval <= 0 || _connection is null)
                {
                    return;
                }

                _nextIn--;
                if (_nextIn <= 0)
                {
                    await LoadAsync();
                }
                else
                {
                    StateHasChanged();
                }
            });
        }
        catch (Exception)
        {
            // A timer callback must never throw: a disposed circuit or a failed render just ends the countdown.
        }
    }

    private void OnIntervalChanged(int seconds)
    {
        _interval = seconds;
        _nextIn = seconds;
    }

    private void OnActiveOnlyChanged(bool value)
    {
        _activeOnly = value;
        Recompute();
    }

    private void SetShowIdle(bool value)
    {
        _showIdle = value;
        Recompute();
    }

    private void FilterByUser(string user)
    {
        _userFilter = user;
        Recompute();
    }

    private void ClearUserFilter()
    {
        _userFilter = null;
        Recompute();
    }

    // The popover must be gone before a dialog opens, or it stays visible behind the dialog's overlay.
    private static async Task CloseThenAsync(MudMenu? menu, Func<Task> action)
    {
        if (menu is not null)
        {
            await menu.CloseMenuAsync();
        }

        await action();
    }

    private async Task JumpToAsync(int pid)
    {
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/SbConsole.Plugins.Postgres/postgres.js");
            await _module.InvokeVoidAsync("scrollToId", $"pg-backend-{pid}");
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            // Scrolling is a convenience.
        }
    }

    private async Task CopyAsync(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            // Clipboard access can be refused (insecure context, permissions); copying is a convenience.
        }
    }

    private async Task CancelAsync(ActivityRow row)
    {
        if (_connection is not { } connection || _acting || _disposed)
        {
            return;
        }

        var pid = row.Backend.Pid;
        _acting = true;
        var ct = _cts.Token;
        try
        {
            if (!await Confirmation.ConfirmAsync("Cancel query of", $"pid {pid}", false, null, ct))
            {
                return;
            }

            if (_disposed)
            {
                return;
            }

            var result = await CancelBackend.HandleAsync(new BackendCommand(connection.Id, connection.Name, pid), ct);
            Report(result, $"Cancel sent to pid {pid}.");
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
            return;
        }
        finally
        {
            _acting = false;
        }

        await LoadAsync();
    }

    private async Task TerminateAsync(ActivityRow row)
    {
        if (_connection is not { } connection || _acting || _disposed)
        {
            return;
        }

        var b = row.Backend;
        var duration = b.Duration is { } d ? PgFormat.Duration(d) : "—";
        var consequence = $"This kills the connection with pg_terminate_backend. Its open transaction ({duration}) rolls back and {b.Application} will see a dropped connection."
                          + (row.BlocksCount > 0 ? $" The {row.BlocksCount} blocked {(row.BlocksCount == 1 ? "session" : "sessions")} will proceed." : "");
        var request = new ConfirmationRequest("Terminate", $"pid {b.Pid}", connection.IsProd, consequence,
        [
            new ConfirmationDetail("pid", b.Pid.ToString(CultureInfo.InvariantCulture)),
            new ConfirmationDetail("user", $"{b.User} · {b.Application} · {b.Client}"),
            new ConfirmationDetail("state", $"{b.State} · {duration} · blocks {row.BlocksCount}"),
            new ConfirmationDetail("query", b.Query),
        ], "pg.backend.terminate", Destructive: true);

        _acting = true;
        var ct = _cts.Token;
        try
        {
            if (!await Confirmation.ConfirmAsync(request, ct))
            {
                return;
            }

            if (_disposed)
            {
                return;
            }

            var result = await TerminateBackend.HandleAsync(new BackendCommand(connection.Id, connection.Name, b.Pid), ct);
            Report(result, $"Terminated pid {b.Pid}.");
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
            return;
        }
        finally
        {
            _acting = false;
        }

        await LoadAsync();
    }

    private void Report(PluginResult result, string success)
    {
        if (_disposed)
        {
            return;
        }

        if (result.IsSuccess)
        {
            Snackbar.Add(success, Severity.Success);
        }
        else
        {
            Snackbar.Add(result.Error ?? "The action failed.", Severity.Error);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _timer?.Dispose();
        _timer = null;
        _cts.Cancel();
        _cts.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone; nothing to release.
            }
        }
    }
}
