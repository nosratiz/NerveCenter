@* Mockup 1c (read-only run with history, and Write on PROD with a marked error line). *@
@page "/p/postgres/query"
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Logging
@using SbConsole.Plugins.Postgres.Client
@using SbConsole.Plugins.Postgres.Query
@inject RunQueryCommandHandler RunQuery
@inject ExplainQueryQueryHandler ExplainQuery
@inject ExportQueryCsvCommandHandler ExportQuery
@inject ListQueryHistoryQueryHandler ListHistory
@inject IConfirmationService Confirmation
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject TimeProvider Clock
@inject ILogger<Query> Logger
@implements IAsyncDisposable

<PageTitle>PostgreSQL query</PageTitle>

<div class="pg-page pg-query-page">
    <PgPageHeader Title="Query">
        <Chips>
            <PgConnectionPicker Loading="_running" ManageUrl="false" SelectionChanged="OnConnectionChangedAsync" />
            @if (_connection is not null)
            {
                <PgDatabasePicker Loading="_running" ConnectionId="_connection.Id" Default="@(_connection.Summary.GetValueOrDefault("Database"))"
                                  ManageUrl="false" SelectedChanged="OnDatabaseChangedAsync" />
            }
        </Chips>
        <Actions>
            @if (_connection is not null)
            {
                <span class="pg-mode-wrap" title="@(WriteAllowed ? null : "Connection is read-only")">
                    <MudToggleGroup @key="_toggleKey" T="string" Class="pg-mode-toggle" Value="@(_write ? "write" : "read")" ValueChanged="OnModeChangedAsync"
                                    Color="@(_write ? Color.Warning : Color.Success)" Size="Size.Small" Outlined="true" Delimiters="true">
                        <MudToggleItem Value="@("read")">Read-only</MudToggleItem>
                        <MudToggleItem Value="@("write")" Disabled="!WriteAllowed">Write</MudToggleItem>
                    </MudToggleGroup>
                </span>
                <MudSelect T="int" Class="pg-row-cap" Label="Rows" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width: 110px"
                           Value="_rowCap" ValueChanged="@(v => _rowCap = v)">
                    @foreach (var cap in RowCaps)
                    {
                        <MudSelectItem T="int" Value="@cap">@PgFormat.Count(cap)</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="int" Class="pg-timeout" Label="Timeout" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width: 110px"
                           Value="_timeoutS" ValueChanged="@(v => _timeoutS = v)">
                    @foreach (var seconds in Timeouts)
                    {
                        <MudSelectItem T="int" Value="@seconds">@seconds s</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="pg-query-export"
                           Disabled="@(_write || _running || _exporting || string.IsNullOrWhiteSpace(_sql))" OnClick="ExportAsync">@(_exporting ? "Exporting…" : "Export CSV")</MudButton>
                <MudButton Variant="Variant.Filled" Size="Size.Small" Color="@(_write ? Color.Warning : Color.Primary)" Class="pg-run"
                           Disabled="@(_running || string.IsNullOrWhiteSpace(_sql))" OnClick="RunAsync">
                    Run <span class="pg-mono pg-run-hint">Ctrl+↵</span>
                </MudButton>
            }
        </Actions>
    </PgPageHeader>

    @if (_connection is not null && _write && _connection.IsProd)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="pg-write-banner" Dense="true">
            <strong>Write mode on a PROD connection.</strong> Statements run in a transaction and are audited with your name. Switch back to Read-only when you're done.
            <MudButton Variant="Variant.Text" Size="Size.Small" Class="pg-back-to-readonly" OnClick="BackToReadOnly">Back to read-only</MudButton>
        </MudAlert>
    }

    @if (_connection is not null)
    {
        <div class="pg-query-layout">
            <div class="pg-query-main">
                <div class="pg-editor-wrap" @ref="_editorWrap">
                    <div class="pg-gutter" aria-hidden="true">
                        @for (var line = 1; line <= LineCount; line++)
                        {
                            <span class="@(_failure?.Line == line ? "pg-gutter-error" : null)">@line</span>
                        }
                    </div>
                    <MudTextField @ref="_editor" T="string" Class="pg-editor pg-mono" Variant="Variant.Text" Lines="10" MaxLines="200" Sizing="InputSizing.Auto" Underline="false"
                                  Immediate="true" Value="_sql" ValueChanged="@(v => _sql = v ?? "")" Placeholder="Write SQL…" />
                </div>

                @if (_status is not null)
                {
                    <div class="pg-status">@_status</div>
                }

                <div class="pg-result">
                    @if (_failure is not null)
                    {
                        <PgErrorAlert Info="_failure" Class="pg-query-error">
                            @if (_failure.Line is { } errLine)
                            {
                                <div class="pg-error-position">Line @errLine@(_failure.Column is { } col ? $", position {col}" : "")</div>
                            }
                            @if (_ranWrite && _auditedFailure)
                            {
                                <div>Nothing was changed — the transaction rolled back.</div>
                            }
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="pg-fix-rerun" OnClick="FixAsync">Fix and re-run</MudButton>
                        </PgErrorAlert>
                        @if (_errorMeta is not null)
                        {
                            <div class="pg-query-error-meta pg-mono pg-muted">@_errorMeta</div>
                        }
                    }
                    else
                    {
                        <MudTabs Elevation="0" Rounded="false" Class="pg-tabs" KeepPanelsAlive="false" ActivePanelIndex="_tab" ActivePanelIndexChanged="OnTabChangedAsync">
                            <MudTabPanel Text="Grid">@GridView</MudTabPanel>
                            <MudTabPanel Text="JSON">
                                @if (_result is null)
                                {
                                    <div class="pg-muted pg-empty">Run a query to see results.</div>
                                }
                                else
                                {
                                    <pre class="pg-result-json pg-json">@JsonText()</pre>
                                }
                            </MudTabPanel>
                            <MudTabPanel Text="EXPLAIN">
                                <div class="pg-muted pg-explain-note">EXPLAIN without ANALYZE — add it yourself to run the query.</div>
                                @if (_explainLoading)
                                {
                                    <MudProgressLinear Indeterminate="true" />
                                }
                                else if (_explainError is not null)
                                {
                                    <PgErrorAlert Info="@(new PgErrorInfo(_explainError, null, null, null, null, null, false))" Class="pg-explain-error" />
                                }
                                else if (_explain is not null)
                                {
                                    <pre class="pg-explain pg-json">@_explain</pre>
                                }
                            </MudTabPanel>
                        </MudTabs>
                    }
                </div>
            </div>

            <aside class="pg-history">
                <div class="pg-history-head"><strong>History</strong> <span class="pg-muted pg-mono">this connection</span></div>
                @foreach (var entry in _history)
                {
                    <div class="pg-history-item @(entry.SqlState is not null ? "pg-history-failed" : null)" role="button" tabindex="0"
                         @onclick="@(() => LoadEntry(entry))" @onkeydown="@(e => OnHistoryKey(e, entry))">
                        <span class="pg-mono pg-history-sql">@Preview(entry.Sql)</span>
                        <span class="pg-history-meta">
                            @PgFormat.Ago(Clock.GetUtcNow() - entry.At) ·
                            @if (entry.SqlState is not null)
                            {
                                <span class="pg-history-error">error @entry.SqlState</span>
                            }
                            else if (entry.Rows is { } rows)
                            {
                                <span>@PgFormat.Count(rows) @(rows == 1 ? "row" : "rows") · @entry.ElapsedSeconds.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) s</span>
                            }
                            else
                            {
                                <span>failed</span>
                            }
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(entry.Write ? Color.Warning : Color.Default)" Class="pg-history-mode">@(entry.Write ? "write" : "ro")</MudChip>
                            @if (entry.Write)
                            {
                                <span class="pg-history-actor">@entry.Actor</span>
                                <a href="/audit" title="@($"audit {entry.Hash}")" @onclick:stopPropagation="true">audit row</a>
                                <span class="pg-mono pg-muted">@ShortHash(entry.Hash)</span>
                            }
                        </span>
                    </div>
                }
                <div class="pg-footnote">Kept 90 days per connection. Writes link to their audit row.</div>
            </aside>
        </div>
    }
</div>

@code {
    private const string ModulePath = "./_content/SbConsole.Plugins.Postgres/postgres.js";
    private const string QueryPath = "/p/postgres/query";
    private const int GridPreviewRows = 200;
    private static readonly int[] RowCaps = [100, 1_000, 10_000];
    private static readonly int[] Timeouts = [10, 30, 60, 300];
    private static readonly HashSet<string> Numeric = ["int2", "int4", "int8", "float4", "float8", "numeric", "smallint", "integer", "bigint", "real", "double precision", "money"];

    private CancellationTokenSource _cts = new();
    private ConnectionInfo? _connection;
    private string? _database;
    private string _lastUrl = "";
    private string _sql = "";
    private string _prefill = "";
    private bool _write;
    private int _toggleKey;
    private int _rowCap = 1_000;
    private int _timeoutS = 30;
    private bool _running;
    private bool _exporting;
    private int _runGen;
    private int _exportGen;
    private int _historyGen;
    private int _explainGen;
    private int _tab;
    private bool _showAll;
    private PgQueryResult? _result;
    private PgErrorInfo? _failure;
    private bool _auditedFailure;
    private bool _ranWrite;
    private string? _status;
    private string? _errorMeta;
    private string? _ranSql;
    private string? _explain;
    private string? _explainError;
    private bool _explainLoading;
    private IReadOnlyList<QueryHistoryEntry> _history = [];
    private ElementReference _editorWrap;
    private MudTextField<string>? _editor;
    private bool _shortcutRegistered;
    private bool _registering;
    private bool _disposed;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Query>? _self;

    private bool WriteAllowed => _connection?.Summary.GetValueOrDefault("Mode") == "read-write";
    private int LineCount => _sql.Count(c => c == '\n') + 1;
    private string? DatabaseArg => string.IsNullOrEmpty(_database) ? null : _database;

    protected override void OnInitialized()
    {
        _lastUrl = Navigation.Uri;
        var query = QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);
        if (query.TryGetValue("sql", out var sql))
        {
            _sql = sql.ToString();
            _prefill = _sql;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shortcutRegistered || _registering || _disposed || _connection is null)
        {
            return;
        }

        _registering = true;
        DotNetObjectReference<Query>? self = null;
        try
        {
            var module = _module ?? await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            if (_disposed)
            {
                // Disposed while the import was in flight: DisposeAsync never saw this module.
                if (!ReferenceEquals(module, _module))
                {
                    await module.DisposeAsync();
                }

                return;
            }

            _module = module;
            self = DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("registerRunShortcut", _editorWrap, self);
            if (_disposed)
            {
                self.Dispose();
                return;
            }

            _self = self;
            self = null;
            _shortcutRegistered = true;
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or OperationCanceledException)
        {
            // The shortcut is a convenience; the Run button still works. (TaskCanceledException is an OperationCanceledException.)
        }
        finally
        {
            self?.Dispose();
            _registering = false;
        }
    }

    [JSInvokable]
    public Task RunFromShortcut() => InvokeAsync(async () =>
    {
        await RunAsync();
        if (!_disposed)
        {
            StateHasChanged();
        }
    });

    // ---- selection --------------------------------------------------------------------------------------------

    private async Task OnConnectionChangedAsync(ConnectionInfo connection)
    {
        if (_connection is not null && _connection.Id != connection.Id)
        {
            // Another connection's run, plan and mode must not carry over.
            await _cts.CancelAsync();
            _cts.Dispose();
            _cts = new CancellationTokenSource();
            // _running stays set until the cancelled run has actually completed (RunAsync clears it).
            _runGen++;
            _exportGen++;
            _database = null;
            _write = false;
            _toggleKey++;
            _history = [];
            ClearResults();
            _connection = connection;
            UpdateUrl();
        }

        _connection = connection;
        if (!WriteAllowed && _write)
        {
            // Same connection re-selected after its Mode became read-only: the toggle must show it.
            _write = false;
            _toggleKey++;
        }

        await LoadHistoryAsync();
    }

    private async Task OnDatabaseChangedAsync(string database)
    {
        if (_disposed)
        {
            return;
        }

        if (_database != null && _database != database)
        {
            // Cancel the in-flight run (the operations layer rolls a cancelled write back) and keep Run disabled until it ends.
            await _cts.CancelAsync();
            _cts.Dispose();
            _cts = new CancellationTokenSource();
            _runGen++;
            _exportGen++;
            ClearResults();
        }

        _database = database;
        UpdateUrl();
    }

    // Composed from tracked state, never from Navigation.Uri: it lags a NavigateTo on Blazor Server. sql is carried only while the editor still holds the prefill:
    // prerender and the interactive instance each initialise from the URL, so dropping it early loses the prefill.
    private void UpdateUrl()
    {
        if (_connection is not { } connection || _disposed)
        {
            return;
        }

        var uri = Navigation.GetUriWithQueryParameters(Navigation.ToAbsoluteUri(QueryPath).ToString(), new Dictionary<string, object?>
        {
            ["connectionId"] = connection.Id.ToString(),
            ["db"] = string.IsNullOrEmpty(_database) ? null : _database,
            ["sql"] = _prefill.Length > 0 && _sql == _prefill ? _prefill : null,
        });
        if (uri != _lastUrl)
        {
            _lastUrl = uri;
            Navigation.NavigateTo(uri, replace: true);
        }
    }

    private void ClearResults()
    {
        _result = null;
        _failure = null;
        _status = null;
        _errorMeta = null;
        _ranSql = null;
        _showAll = false;
        _explain = null;
        _explainError = null;
        _explainLoading = false;
        _explainGen++;
        _tab = 0;
    }

    // ---- mode ------------------------------------------------------------------------------------------------

    private async Task OnModeChangedAsync(string? mode)
    {
        if (_connection is not { } connection)
        {
            return;
        }

        if (mode != "write")
        {
            _write = false;
            return;
        }

        if (!WriteAllowed)
        {
            return;
        }

        // IsProd comes from the picker's server-side ConnectionInfo, never from the client.
        var capturedId = connection.Id;
        var confirmed = true;
        if (connection.IsProd)
        {
            try
            {
                confirmed = await Confirmation.ConfirmAsync("Enter write mode on", connection.Name, true, ct: _cts.Token);
            }
            catch (OperationCanceledException)
            {
                confirmed = false;
            }
        }

        if (_disposed)
        {
            return;
        }

        if (!confirmed || _connection?.Id != capturedId)
        {
            // Cancelled, or the user moved to another connection while the dialog was open: stay read-only.
            _write = false;
            _toggleKey++;
            return;
        }

        _write = true;
    }

    private void BackToReadOnly()
    {
        _write = false;
        _toggleKey++;
    }

    // ---- run -------------------------------------------------------------------------------------------------

    private async Task RunAsync()
    {
        if (_connection is not { } connection || _running || _disposed || string.IsNullOrWhiteSpace(_sql))
        {
            return;
        }

        var token = _cts.Token;
        var generation = ++_runGen;
        var sql = _sql;
        var write = _write;
        ClearResults();
        _running = true;
        StateHasChanged();
        try
        {
            await RunCoreAsync(connection, generation, sql, write, token);
        }
        finally
        {
            // Only the completed (or cancelled) run releases the button, so a run abandoned by a switch can't overlap a new one.
            _running = false;
        }
    }

    private async Task RunCoreAsync(ConnectionInfo connection, int generation, string sql, bool write, CancellationToken token)
    {
        var started = Clock.GetTimestamp();
        string? actor = await ActorAsync();
        PluginResult<QueryRun> result;
        try
        {
            result = await RunQuery.HandleAsync(new RunQueryCommand(connection.Id, connection.Name, DatabaseArg,
                new PgQueryRequest(sql, write, _rowCap, _timeoutS), actor), token);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            return;
        }

        if (generation != _runGen || _disposed)
        {
            return;
        }

        var elapsed = Clock.GetElapsedTime(started);
        _ranSql = sql;
        _ranWrite = write;
        if (!result.IsSuccess || result.Value is null)
        {
            _failure = new PgErrorInfo(result.Error ?? "The query failed.", null, null, null, null, null, false);
            _auditedFailure = false;
            return;
        }

        var run = result.Value;
        if (run.Error is { } error)
        {
            _failure = error;
            // A refusal never reached the server: no audit row, nothing to say about a rollback.
            _auditedFailure = error.SqlState is not null || error.IsConnectionFailure;
            _errorMeta = _auditedFailure
                ? string.Join(" · ", new[]
                {
                    error.SqlState is null ? null : $"SQLSTATE {error.SqlState}{(error.ConditionName is null ? "" : " · " + error.ConditionName)}",
                    SecondsText(elapsed),
                    $"audited as {run.AuditAction} (failed)",
                }.Where(p => p is not null))
                : null;
            await LoadHistoryAsync();
            return;
        }

        _result = run.Result;
        _status = BuildStatus(run, write);
        await LoadHistoryAsync();
    }

    private string BuildStatus(QueryRun run, bool write)
    {
        var r = run.Result!;
        var seconds = SecondsText(r.Elapsed);
        string body;
        if (write)
        {
            var affected = r.RowsAffected ?? r.Rows.Count;
            body = $"{PgFormat.Count(affected)} rows affected · {seconds} · committed";
        }
        else
        {
            var count = r.Rows.Count;
            body = $"● {PgFormat.Count(count)} {(count == 1 ? "row" : "rows")} · {seconds} · read-only txn · timeout {_timeoutS} s · cap {PgFormat.Count(_rowCap)}";
            if (r.Capped)
            {
                body += " · capped";
            }
        }

        return $"{body} · audited as {run.AuditAction}";
    }

    private static string SecondsText(TimeSpan span) => span.TotalSeconds.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) + " s";

    private async Task<string> ActorAsync()
    {
        try
        {
            var state = await AuthProvider.GetAuthenticationStateAsync();
            return state.User.Identity?.Name ?? "admin";
        }
        catch (Exception)
        {
            return "admin";
        }
    }

    private async Task FixAsync()
    {
        if (_editor is not null)
        {
            await _editor.FocusAsync();
        }
    }

    // ---- tabs ------------------------------------------------------------------------------------------------

    private async Task OnTabChangedAsync(int index)
    {
        _tab = index;
        if (index == 2 && _explain is null && !_explainLoading && _connection is { } connection)
        {
            var sql = _ranSql ?? _sql;
            if (string.IsNullOrWhiteSpace(sql))
            {
                return;
            }

            var generation = ++_explainGen;
            var token = _cts.Token;
            _explainLoading = true;
            _explainError = null;
            PluginResult<string> result;
            try
            {
                result = await ExplainQuery.HandleAsync(connection.Id, DatabaseArg, sql, _timeoutS, token);
            }
            catch (OperationCanceledException) when (token.IsCancellationRequested)
            {
                return;
            }

            if (generation != _explainGen || _disposed)
            {
                return;
            }

            _explainLoading = false;
            if (result.IsSuccess)
            {
                _explain = result.Value ?? "";
            }
            else
            {
                _explainError = result.Error ?? "EXPLAIN failed.";
            }
        }
    }

    private RenderFragment GridView => __builder =>
    {
        if (_result is not { } r)
        {
            <div class="pg-muted pg-empty">Run a query to see results. Ctrl+↵ runs the editor's text.</div>
            return;
        }

        var shown = _showAll ? r.Rows.Count : Math.Min(r.Rows.Count, GridPreviewRows);
        <div class="pg-grid-scroll">
            <table class="pg-result-grid">
                <thead>
                    <tr>
                        <th class="pg-rownum">#</th>
                        @foreach (var column in r.Columns)
                        {
                            <th class="@(Numeric.Contains(column.TypeName) ? "pg-num" : null)">
                                <span class="pg-mono">@column.Name</span> <span class="pg-coltype pg-muted">@column.TypeName</span>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < shown; i++)
                    {
                        var row = r.Rows[i];
                        <tr>
                            <td class="pg-rownum pg-mono">@(i + 1)</td>
                            @for (var c = 0; c < row.Count; c++)
                            {
                                var cell = row[c];
                                <td class="pg-mono @(c < r.Columns.Count && Numeric.Contains(r.Columns[c].TypeName) ? "pg-num" : null)" title="@(cell.Kind == PgCellKind.Json ? cell.Full : null)">
                                    @if (cell.Kind == PgCellKind.Null)
                                    {
                                        <PgNullChip />
                                    }
                                    else if (cell.Kind == PgCellKind.Json)
                                    {
                                        @("{…}")@(cell.JsonKeyCount is { } keys ? $" {keys} {(keys == 1 ? "key" : "keys")}" : "")
                                    }
                                    else
                                    {
                                        @cell.Display
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        if (r.Rows.Count > shown)
        {
            <div class="pg-grid-footer">
                @PgFormat.Count(shown) of @PgFormat.Count(r.Rows.Count) rows shown ·
                <button type="button" class="pg-link pg-show-all" @onclick="@(() => _showAll = true)">Show all</button>
            </div>
        }
        else if (r.Capped)
        {
            <div class="pg-grid-footer pg-muted">Row cap reached — raise Rows to see more.</div>
        }
    };

    private string JsonText()
    {
        if (_result is not { } r)
        {
            return "";
        }

        var shown = _showAll ? r.Rows.Count : Math.Min(r.Rows.Count, GridPreviewRows);
        using var stream = new MemoryStream();
        using (var writer = new Utf8JsonWriter(stream, new JsonWriterOptions { Indented = true }))
        {
            writer.WriteStartArray();
            for (var i = 0; i < shown; i++)
            {
                writer.WriteStartObject();
                var row = r.Rows[i];
                for (var c = 0; c < row.Count && c < r.Columns.Count; c++)
                {
                    writer.WritePropertyName(r.Columns[c].Name);
                    var cell = row[c];
                    if (cell.Kind == PgCellKind.Null)
                    {
                        writer.WriteNullValue();
                    }
                    else if (cell.Kind == PgCellKind.Json && cell.Full is { } full && TryParse(full, out var doc))
                    {
                        using (doc)
                        {
                            doc.RootElement.WriteTo(writer);
                        }
                    }
                    else
                    {
                        WriteTextCell(writer, r.Columns[c].TypeName, cell);
                    }
                }

                writer.WriteEndObject();
            }

            writer.WriteEndArray();
        }

        return System.Text.Encoding.UTF8.GetString(stream.ToArray());
    }

    private static readonly HashSet<string> JsonNumberTypes = ["int2", "int4", "int8", "numeric", "float4", "float8"];

    // Numbers and booleans keep their JSON type; anything that isn't a valid JSON number (NaN, Infinity) stays a string.
    private static void WriteTextCell(Utf8JsonWriter writer, string typeName, PgCell cell)
    {
        var text = cell.Full ?? cell.Display;
        if (cell.Kind == PgCellKind.Text && text is not null)
        {
            if (JsonNumberTypes.Contains(typeName) && TryParse(text, out var number))
            {
                using (number)
                {
                    if (number.RootElement.ValueKind == JsonValueKind.Number)
                    {
                        number.RootElement.WriteTo(writer);
                        return;
                    }
                }
            }
            else if (typeName == "bool")
            {
                if (text.Equals("true", StringComparison.OrdinalIgnoreCase) || text == "t")
                {
                    writer.WriteBooleanValue(true);
                    return;
                }

                if (text.Equals("false", StringComparison.OrdinalIgnoreCase) || text == "f")
                {
                    writer.WriteBooleanValue(false);
                    return;
                }
            }
        }

        writer.WriteStringValue(text);
    }

    private static bool TryParse(string text, out JsonDocument document)
    {
        try
        {
            document = JsonDocument.Parse(text);
            return true;
        }
        catch (JsonException)
        {
            document = null!;
            return false;
        }
    }

    // ---- export ----------------------------------------------------------------------------------------------

    private async Task ExportAsync()
    {
        if (_connection is not { } connection || _exporting || _disposed || string.IsNullOrWhiteSpace(_sql))
        {
            return;
        }

        _exporting = true;
        var token = _cts.Token;
        var generation = _exportGen;
        try
        {
            var result = await ExportQuery.HandleAsync(new ExportQueryCsvCommand(connection.Id, connection.Name, DatabaseArg, _sql, _timeoutS), token);
            if (generation != _exportGen || _disposed)
            {
                // The connection or database changed while exporting: the file and its message belong to the old target.
                return;
            }

            if (!result.IsSuccess || result.Value is not { } export)
            {
                _failure = new PgErrorInfo(result.Error ?? "The export failed.", null, null, null, null, null, false);
                _auditedFailure = false;
                _errorMeta = null;
                return;
            }

            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            using var stream = new MemoryStream(export.Content);
            using var streamRef = new DotNetStreamReference(stream);
            await _module.InvokeVoidAsync("downloadFromStream", export.FileName, streamRef);
            if (generation != _exportGen || _disposed)
            {
                return;
            }

            _status = export.Truncated
                ? $"Exported the first {PgFormat.Count(export.RowCount)} rows to {export.FileName} — the query returns more (exports are capped at {PgFormat.Count(CsvExport.MaxRows)} rows or {PgFormat.Bytes(CsvExport.MaxBytes)})."
                : $"Exported {PgFormat.Count(export.RowCount)} rows to {export.FileName}.";
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException)
        {
            if (generation != _exportGen || _disposed)
            {
                return;
            }

            _failure = new PgErrorInfo("The browser couldn't save the file.", null, null, null, null, null, false);
            _auditedFailure = false;
            _errorMeta = null;
        }
        finally
        {
            _exporting = false;
        }
    }

    // ---- history ---------------------------------------------------------------------------------------------

    private async Task LoadHistoryAsync()
    {
        if (_connection is not { } connection || _disposed)
        {
            return;
        }

        var generation = ++_historyGen;
        var token = _cts.Token;
        try
        {
            var entries = await ListHistory.HandleAsync(connection.Id, token);
            if (generation == _historyGen && !_disposed)
            {
                _history = entries;
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Loading query history for connection {ConnectionId} failed", connection.Id);
            if (generation == _historyGen && !_disposed)
            {
                _history = [];
            }
        }
    }

    private void LoadEntry(QueryHistoryEntry entry) => _sql = entry.Sql;

    private void OnHistoryKey(KeyboardEventArgs e, QueryHistoryEntry entry)
    {
        if (e.Key is "Enter" or " ")
        {
            LoadEntry(entry);
        }
    }

    private static string Preview(string sql)
    {
        var line = string.Join(' ', sql.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries));
        return line.Length <= 60 ? line : line[..60] + "…";
    }

    private static string ShortHash(string hash) => hash.StartsWith("sha256:", StringComparison.Ordinal) ? hash[7..] : hash;

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await _cts.CancelAsync();
        _cts.Dispose();
        if (_module is not null)
        {
            try
            {
                if (_shortcutRegistered)
                {
                    await _module.InvokeVoidAsync("unregisterRunShortcut", _editorWrap);
                }

                await _module.DisposeAsync();
            }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException or InvalidOperationException)
            {
                // The circuit is already gone; nothing to release.
            }
        }

        _self?.Dispose();
    }
}
