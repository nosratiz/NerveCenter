@using Microsoft.AspNetCore.WebUtilities
@using SbConsole.Plugins.Kubernetes.Overview
@inject IConnectionProvider Connections
@inject NavigationManager Navigation

@* Header chips (mockup 3a): the connection menu (red dot = last overview load failed), PROD chip, server · context.
   The choice lives in ?connectionId= so links stay shareable. *@
@if (!_loaded)
{
    <MudProgressCircular Class="k8s-picker-loading" Size="Size.Small" Indeterminate="true" />
}
else if (_connections.Count == 0)
{
    <span class="k8s-muted k8s-no-connections">No Kubernetes connections yet — add one under <a href="/connections">Connections</a>.</span>
}
else
{
    <MudMenu Class="k8s-connection-menu" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
        <ActivatorContent>
            @* MudBlazor 9's activator div only handles keydown; the click has to come from here. *@
            <MudChip T="string" Variant="Variant.Outlined" Class="@(SelectedUnreachable ? "k8s-unreachable" : null)"
                     OnClick="@(e => context.ToggleAsync(e))">
                @if (SelectedUnreachable)
                {
                    <span class="k8s-unreachable-dot k8s-selected-dot"></span>
                }
                <span class="k8s-selected-connection">@_connection?.Name</span> ▾
            </MudChip>
        </ActivatorContent>
        <ChildContent>
            @foreach (var connection in _connections)
            {
                <MudMenuItem Class="k8s-connection-option" OnClick="@(() => SelectAsync(connection))">
                    @if (_unreachable.Contains(connection.Id))
                    {
                        <span class="k8s-unreachable-dot"></span>
                    }
                    @connection.Name
                    @if (connection.IsProd)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Class="k8s-prod-chip-option">PROD</MudChip>
                    }
                </MudMenuItem>
            }
        </ChildContent>
    </MudMenu>

    @if (_connection?.IsProd == true)
    {
        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled" Class="k8s-prod-chip">PROD</MudChip>
    }

    @if (_connection is { } selected && selected.Summary.TryGetValue("Server", out var server))
    {
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="k8s-server-chip">
            <span class="k8s-mono">@server</span> · @selected.Summary.GetValueOrDefault("Context")
        </MudChip>
    }

    @if (Loading)
    {
        <MudProgressCircular Class="k8s-page-busy" Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
    }
}

@code {
    public const string Kind = KubernetesPlugin.Kind;

    [Inject(Key = KubernetesPlugin.PluginId)]
    private IPluginStore Store { get; set; } = default!;

    /// <summary>Raised once after the initial selection resolves, then on every change. Never raised when there are no connections.</summary>
    [Parameter] public EventCallback<ConnectionInfo> SelectionChanged { get; set; }

    [Parameter] public bool Loading { get; set; }

    /// <summary>True (default): the picker keeps ?connectionId= in sync itself. False: the host page owns the URL.</summary>
    [Parameter] public bool ManageUrl { get; set; } = true;

    private IReadOnlyList<ConnectionInfo> _connections = [];
    private ConnectionInfo? _connection;
    private HashSet<Guid> _unreachable = [];
    private bool _loaded;

    private bool SelectedUnreachable => _connection is { } c && _unreachable.Contains(c.Id);

    protected override async Task OnInitializedAsync()
    {
        _connections = await Connections.ListAsync(Kind);
        await RefreshReachabilityAsync();
        _loaded = true;
        if (_connections.Count == 0)
        {
            return;
        }

        var query = QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);
        ConnectionInfo? fromQuery = null;
        if (query.TryGetValue("connectionId", out var idValue) && Guid.TryParse(idValue.ToString(), out var id))
        {
            fromQuery = _connections.FirstOrDefault(c => c.Id == id);
        }

        await SelectAsync(fromQuery ?? _connections[0]);
    }

    /// <summary>
    /// Re-reads each connection's stored overview state. Dot rule: a failure newer than the last good load
    /// (or any failure with no good load). Pages call this after their own load so the dot follows it.
    /// </summary>
    public async Task RefreshReachabilityAsync()
    {
        var unreachable = new HashSet<Guid>();
        foreach (var connection in _connections)
        {
            try
            {
                var state = await OverviewSnapshotStore.ReadAsync(Store, connection.Id, CancellationToken.None);
                if (state.LastFailureAt is { } failedAt && (state.LastGood is null || failedAt > state.LastGood.LoadedAt))
                {
                    unreachable.Add(connection.Id);
                }
            }
            catch (Exception)
            {
                // The dot is a hint; an unreadable store must not break the picker.
            }
        }

        _unreachable = unreachable;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SelectAsync(ConnectionInfo connection)
    {
        _connection = connection;
        if (ManageUrl)
        {
            var uri = Navigation.GetUriWithQueryParameter("connectionId", connection.Id.ToString());
            if (uri != Navigation.Uri)
            {
                Navigation.NavigateTo(uri, replace: true);
            }
        }

        await SelectionChanged.InvokeAsync(connection);
    }
}
