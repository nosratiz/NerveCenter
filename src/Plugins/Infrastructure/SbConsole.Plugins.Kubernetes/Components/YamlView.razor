@using Microsoft.AspNetCore.Components.Rendering
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@implements IAsyncDisposable

@* Read-only YAML (spec §7/§8 "YAML" tabs and dialog). Each top-level key folds; long sections start folded.
   Copy puts the whole document on the clipboard via kubernetes.js. *@
<div class="k8s-yaml-view @Class">
    <div class="k8s-yaml-toolbar">
        <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.ContentCopy"
                   Class="k8s-yaml-copy" OnClick="CopyAsync">Copy</MudButton>
        <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.UnfoldMore"
                   Class="k8s-yaml-expand" Disabled="@(_collapsed.Count == 0)" OnClick="@(() => _collapsed.Clear())">Expand all</MudButton>
    </div>
    <pre class="k8s-yaml">@RenderDocument</pre>
</div>

@code {
    /// <summary>Sections with more body lines than this start folded.</summary>
    internal const int FoldThreshold = 30;

    [Parameter, EditorRequired] public string Yaml { get; set; } = "";

    [Parameter] public string? Class { get; set; }

    private sealed record Section(string Header, string Body);

    private string _preamble = "";
    private IReadOnlyList<Section> _sections = [];
    private readonly HashSet<int> _collapsed = [];
    private string? _parsed;
    private IJSObjectReference? _module;

    protected override void OnParametersSet()
    {
        if (Yaml == _parsed)
        {
            return;
        }

        _parsed = Yaml;
        (_preamble, _sections) = Parse(Yaml);
        _collapsed.Clear();
        for (var i = 0; i < _sections.Count; i++)
        {
            if (_sections[i].Body.Count(c => c == '\n') > FoldThreshold)
            {
                _collapsed.Add(i);
            }
        }
    }

    /// <summary>A top-level key: a line starting with a non-space, non-comment, non-list character that has a colon.</summary>
    private static bool IsTopLevelKey(string line) =>
        line.Length > 0 && !char.IsWhiteSpace(line[0]) && line[0] is not '#' and not '-' && line.Contains(':');

    private static (string Preamble, IReadOnlyList<Section> Sections) Parse(string yaml)
    {
        var lines = yaml.Replace("\r\n", "\n").TrimEnd('\n').Split('\n');
        var preamble = new List<string>();
        var sections = new List<(string Header, List<string> Body)>();
        foreach (var line in lines)
        {
            if (IsTopLevelKey(line))
            {
                sections.Add((line, []));
            }
            else if (sections.Count == 0)
            {
                preamble.Add(line);
            }
            else
            {
                sections[^1].Body.Add(line);
            }
        }

        static string Join(List<string> part) => part.Count == 0 ? "" : string.Join('\n', part) + "\n";
        return (Join(preamble), sections.Select(s => new Section(s.Header, Join(s.Body))).ToList());
    }

    private void Toggle(int index)
    {
        if (!_collapsed.Remove(index))
        {
            _collapsed.Add(index);
        }
    }

    // Built by hand rather than in markup: whitespace inside <pre> is content, and Razor's whitespace rules would add or drop it.
    private void RenderDocument(RenderTreeBuilder b)
    {
        var seq = 0;
        if (_preamble.Length > 0)
        {
            b.AddContent(seq++, _preamble);
        }

        for (var i = 0; i < _sections.Count; i++)
        {
            var index = i;
            var section = _sections[i];
            var foldable = section.Body.Length > 0;
            var folded = _collapsed.Contains(index);

            b.OpenElement(10, "span");
            b.SetKey(index);
            b.AddAttribute(11, "class", "k8s-yaml-section");
            if (foldable)
            {
                b.OpenElement(12, "button");
                b.AddAttribute(13, "type", "button");
                b.AddAttribute(14, "class", folded ? "k8s-yaml-key k8s-yaml-folded-key" : "k8s-yaml-key");
                b.AddAttribute(15, "aria-expanded", folded ? "false" : "true");
                b.AddAttribute(16, "onclick", EventCallback.Factory.Create(this, () => Toggle(index)));
                b.AddContent(17, section.Header);
                b.CloseElement();
            }
            else
            {
                b.OpenElement(18, "span");
                b.AddAttribute(19, "class", "k8s-yaml-key");
                b.AddContent(20, section.Header);
                b.CloseElement();
            }

            b.AddContent(21, "\n");
            if (foldable && folded)
            {
                b.OpenElement(22, "span");
                b.AddAttribute(23, "class", "k8s-yaml-folded");
                b.AddContent(24, "  …\n");
                b.CloseElement();
            }
            else if (foldable)
            {
                b.AddContent(25, section.Body);
            }

            b.CloseElement();
        }
    }

    private async Task CopyAsync()
    {
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", K8sJs.ModulePath);
            await _module.InvokeVoidAsync("copyText", Yaml);
            Snackbar.Add("YAML copied.", Severity.Success);
        }
        catch (JSException)
        {
            Snackbar.Add("Couldn't copy — select the text and copy it instead.", Severity.Warning);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone.
            }
        }
    }
}
