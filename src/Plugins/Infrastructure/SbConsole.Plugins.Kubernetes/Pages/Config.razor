@* Mockup 3f (ConfigMaps expanded inline, Secrets as metadata only). Spec §9. Stock MudBlazor in the Nocturne theme.
   No auto-refresh: config changes rarely and an edit must never be repainted under the user — Refresh button only. *@
@page "/p/kubernetes/config"
@using System.Globalization
@using System.Text
@using SbConsole.Plugins.Kubernetes.Access
@using SbConsole.Plugins.Kubernetes.Config
@using SbConsole.Plugins.Kubernetes.Workloads
@inject ListConfigMapsQueryHandler ListConfigMaps
@inject ListSecretsQueryHandler ListSecrets
@inject GetPermissionsQueryHandler GetPermissions
@inject GetResourceYamlQueryHandler GetResourceYaml
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject AccessCache AccessCache
@inject TimeProvider Clock
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Kubernetes config</PageTitle>

<div class="k8s-page">
    <K8sPageHeader Title="Config">
        <Chips>
            <K8sConnectionPicker Loading="_loading" SelectionChanged="OnConnectionChangedAsync" />
            <RbacChip Permissions="_permissions" Needs="K8sPermissions.ConfigActions" />
            @if (_connection is not null)
            {
                <K8sNamespacePicker ConnectionId="_connection.Id" SelectionChanged="OnNamespacesChangedAsync" />
            }
        </Chips>
        <Actions>
            @if (_connection is not null)
            {
                <MudTextField T="string" Class="k8s-config-filter" Value="_filter" ValueChanged="@(v => _filter = v ?? "")" Immediate="true"
                              Placeholder="Filter…" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" />
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="k8s-config-refresh" Disabled="_loading" OnClick="RefreshAsync">Refresh</MudButton>
            }
        </Actions>
    </K8sPageHeader>

    @if (_connection is not null)
    {
        <div class="k8s-body k8s-config-body">
            <MudPaper Outlined="true" Class="k8s-configmaps">
                <div class="k8s-card-head">
                    <strong>ConfigMaps</strong>
                    @if (_maps is not null)
                    {
                        <span class="k8s-meta k8s-cm-count">@_maps.Count.ToString(Inv) in @ScopeLabel</span>
                    }
                </div>
                @if (_mapsError is not null)
                {
                    <div class="k8s-card-pad">
                        <K8sErrorAlert Info="@(new K8sErrorInfo(_mapsError, null, null, false))" Title="Can't list ConfigMaps." Class="k8s-cm-error" />
                    </div>
                }
                @ConfigMapsTable()
            </MudPaper>

            <MudPaper Outlined="true" Class="k8s-secrets">
                <div class="k8s-card-head">
                    <strong>Secrets</strong>
                    @if (_secrets is not null)
                    {
                        <span class="k8s-meta k8s-secrets-count">@_secrets.Count.ToString(Inv) in @ScopeLabel</span>
                    }
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Outlined.Lock"
                             Class="k8s-secrets-metadata">metadata only</MudChip>
                </div>
                <div class="k8s-secrets-callout">
                    <MudIcon Icon="@Icons.Material.Outlined.Lock" Size="Size.Small" />
                    <span>Secret values are never shown — the console reads key names, type and age only. Rotate or read values with your cluster's secret manager.</span>
                </div>
                @if (_secretsError is not null)
                {
                    <div class="k8s-card-pad">
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="k8s-secrets-error">@_secretsError</MudAlert>
                    </div>
                }
                @SecretsTable()
            </MudPaper>

            <div class="k8s-footnote k8s-config-footnote">
                Edit is Mutating: a short confirmation, and it fails rather than overwrite a change made since you loaded the map.
                <span class="k8s-config-audited">Audited as <span class="k8s-mono">@UpdateConfigMapCommandHandler.Action</span> (key names only)</span>
            </div>
        </div>
    }
</div>

@code {
    private const int RowCap = 50;
    private const int InlineValueMax = 200;
    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;

    private readonly CancellationTokenSource _cts = new();
    private readonly HashSet<string> _expandedMaps = new(StringComparer.Ordinal);
    private readonly HashSet<string> _expandedValues = new(StringComparer.Ordinal);
    private ConnectionInfo? _connection;
    private IReadOnlyList<string>? _namespaces;
    private K8sPermissions? _permissions;
    private IReadOnlyList<ConfigMapRow>? _maps;
    private IReadOnlyList<SecretSummary>? _secrets;
    private string? _mapsError;
    private string? _secretsError;
    private string _filter = "";
    private bool _showAllMaps;
    private bool _showAllSecrets;
    private bool _loading;
    private int _generation;
    private K8sDialogGate _dialogs = null!; // OnInitialized; no event can reach the page before it runs
    private bool _disposed;
    private K8sVisibilityHook? _visibility;

    private string ScopeLabel => _namespaces switch
    {
        null or { Count: 0 } => "all namespaces",
        { Count: 1 } one => one[0],
        var many => $"{many.Count.ToString(Inv)} namespaces",
    };

    /// <summary>With more than one namespace in scope, names repeat: each row says which namespace it is from.</summary>
    private bool ShowNamespace => _namespaces is not { Count: 1 };

    private static string MapKey(K8sConfigMap map) => $"{map.Namespace}/{map.Name}";

    private RenderFragment ConfigMapsTable() => __builder =>
    {
        if (_maps is not { } all)
        {
            if (_mapsError is null)
            {
                <div class="k8s-card-pad k8s-cm-loading">
                    @for (var i = 0; i < 3; i++)
                    {
                        <MudSkeleton Height="28px" />
                    }
                </div>
            }

            return;
        }

        var filtered = Filter(all, r => r.Map.Name);
        var shown = _showAllMaps ? filtered : filtered.Take(RowCap).ToList();
        if (filtered.Count == 0)
        {
            <div class="k8s-card-pad k8s-muted k8s-cm-empty">@(all.Count == 0 ? "No ConfigMaps in these namespaces." : "Nothing matches the filter.")</div>
            return;
        }

        <div class="k8s-table-wrap">
            <MudTable T="ConfigMapRow" Items="shown" Dense="true" Hover="true" Elevation="0" Class="k8s-cm-table"
                      RowClassFunc="CmRowClass" OnRowClick="@((TableRowClickEventArgs<ConfigMapRow> e) => ToggleMap(e.Item))">
                <HeaderContent>
                    <MudTh Class="k8s-cm-caret-col"></MudTh>
                    <MudTh>Name</MudTh>
                    <MudTh Class="k8s-num">Keys</MudTh>
                    <MudTh>Used by</MudTh>
                    <MudTh Class="k8s-num">Age</MudTh>
                </HeaderContent>
                <RowTemplate>
                    @{ var open = _expandedMaps.Contains(MapKey(context.Map)); }
                    <MudTd Class="k8s-cm-caret-col">
                        <MudIcon Size="Size.Small" Icon="@(open ? Icons.Material.Filled.KeyboardArrowDown : Icons.Material.Filled.KeyboardArrowRight)" />
                    </MudTd>
                    <MudTd>
                        <div class="k8s-mono k8s-cm-name">@context.Map.Name</div>
                        @if (ShowNamespace)
                        {
                            <div class="k8s-mono k8s-muted k8s-cm-ns">@context.Map.Namespace</div>
                        }
                    </MudTd>
                    <MudTd Class="k8s-num k8s-mono k8s-cm-keys">@((context.Map.Data.Count + context.Map.BinarySizes.Count).ToString(Inv))</MudTd>
                    <MudTd Class="k8s-cm-used">
                        @if (context.Unused)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" Class="k8s-unused">unused</MudChip>
                        }
                        else
                        {
                            @UsedBy(context)
                        }
                    </MudTd>
                    <MudTd Class="k8s-num k8s-mono k8s-muted k8s-cm-age">@K8sFormat.Age(Clock.GetUtcNow() - context.Map.CreatedAt)</MudTd>
                </RowTemplate>
                <ChildRowContent>
                    @if (_expandedMaps.Contains(MapKey(context.Map)))
                    {
                        <MudTr Class="k8s-cm-detail-row">
                            <td colspan="5" class="k8s-cm-detail">@Detail(context.Map)</td>
                        </MudTr>
                    }
                </ChildRowContent>
            </MudTable>
        </div>
        @if (filtered.Count > shown.Count)
        {
            <div class="k8s-card-pad k8s-muted k8s-cm-more">
                @(filtered.Count - shown.Count) more · <button type="button" class="k8s-link k8s-cm-show-all" @onclick="() => _showAllMaps = true">show all</button>
            </div>
        }
    };

    private static string UsedBy(ConfigMapRow row) =>
        string.Join(", ", row.UsedBy.Select(u => $"{u.Name} · {string.Join(" + ", u.Via)}"));

    private string CmRowClass(ConfigMapRow row, int index) =>
        "k8s-cm-row" + (_expandedMaps.Contains(MapKey(row.Map)) ? " k8s-cm-row-expanded" : "");

    private RenderFragment Detail(K8sConfigMap map) => __builder =>
    {
        <div class="k8s-cm-kv">
            @foreach (var (key, value) in map.Data.OrderBy(kv => kv.Key, StringComparer.Ordinal))
            {
                var valueKey = $"{MapKey(map)}/{key}";
                <span class="k8s-mono k8s-cm-key">@key</span>
                @if (IsInline(value))
                {
                    <span class="k8s-mono k8s-cm-value">@value</span>
                }
                else
                {
                    var open = _expandedValues.Contains(valueKey);
                    <span class="k8s-mono k8s-cm-value"><span class="k8s-muted">@Collapsed(value) · </span><button type="button" class="k8s-link k8s-cm-expand" @onclick="() => ToggleValue(valueKey)">@(open ? "collapse" : "expand")</button>@if (open)
                        {
                            <pre class="k8s-cm-pre">@value</pre>
                        }</span>
                }
            }
            @foreach (var (key, size) in map.BinarySizes.OrderBy(kv => kv.Key, StringComparer.Ordinal))
            {
                <span class="k8s-mono k8s-cm-key">@key</span>
                <span class="k8s-mono k8s-muted k8s-cm-value k8s-cm-binary">@K8sFormat.Bytes(size) binary</span>
            }
        </div>
        <div class="k8s-cm-actions">
            <MudButton Class="k8s-cm-copy-yaml" Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Outlined.ContentCopy"
                       OnClick="() => CopyYamlAsync(map)">Copy as YAML</MudButton>
            @if (CanEdit(map.Namespace))
            {
                <MudButton Class="k8s-cm-edit" Variant="Variant.Outlined" Size="Size.Small" OnClick="() => EditAsync(map)">Edit…</MudButton>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" Class="k8s-cm-mutating">mutating</MudChip>
            }
        </div>
    };

    private RenderFragment SecretsTable() => __builder =>
    {
        if (_secrets is not { } all)
        {
            if (_secretsError is null)
            {
                <div class="k8s-card-pad k8s-secrets-loading">
                    @for (var i = 0; i < 3; i++)
                    {
                        <MudSkeleton Height="28px" />
                    }
                </div>
            }

            return;
        }

        var filtered = Filter(all, s => s.Name);
        var shown = _showAllSecrets ? filtered : filtered.Take(RowCap).ToList();
        if (filtered.Count == 0)
        {
            <div class="k8s-card-pad k8s-muted k8s-secrets-empty">@(all.Count == 0 ? "No Secrets in these namespaces." : "Nothing matches the filter.")</div>
            return;
        }

        <div class="k8s-table-wrap">
            <MudTable T="SecretSummary" Items="shown" Dense="true" Hover="true" Elevation="0" Class="k8s-secrets-table" RowClass="k8s-secret-row">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Type</MudTh>
                    <MudTh>Keys</MudTh>
                    <MudTh Class="k8s-num">Age</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <div class="k8s-mono k8s-secret-name">@context.Name</div>
                        @if (ShowNamespace)
                        {
                            <div class="k8s-mono k8s-muted k8s-secret-ns">@context.Namespace</div>
                        }
                    </MudTd>
                    <MudTd Class="k8s-mono k8s-secret-type">@context.Type</MudTd>
                    <MudTd>
                        <div class="k8s-secret-keys">
                            @foreach (var key in context.KeyNames)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="k8s-mono k8s-secret-key">@key</MudChip>
                            }
                        </div>
                    </MudTd>
                    <MudTd Class="k8s-num">
                        <div class="k8s-secret-age-cell">
                            @if (context.TlsNotAfter is { } notAfter)
                            {
                                var (text, color) = Expiry(notAfter);
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="color" Class="k8s-tls-expiry">@text</MudChip>
                            }
                            <span class="k8s-mono k8s-muted k8s-secret-age">@K8sFormat.Age(Clock.GetUtcNow() - context.CreatedAt)</span>
                        </div>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </div>
        @if (filtered.Count > shown.Count)
        {
            <div class="k8s-card-pad k8s-muted k8s-secrets-more">
                @(filtered.Count - shown.Count) more · <button type="button" class="k8s-link k8s-secrets-show-all" @onclick="() => _showAllSecrets = true">show all</button>
            </div>
        }
    };

    private IReadOnlyList<T> Filter<T>(IReadOnlyList<T> rows, Func<T, string> name)
    {
        var term = _filter.Trim();
        return term.Length == 0 ? rows : rows.Where(r => name(r).Contains(term, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    /// <summary>Spec: values collapse when longer than 200 characters or multi-line.</summary>
    internal static bool IsInline(string value) => value.Length <= InlineValueMax && !value.Contains('\n');

    /// <summary>"{…} 1.8 Ki" for JSON-looking values, else "14 lines".</summary>
    internal static string Collapsed(string value)
    {
        var trimmed = value.TrimStart();
        if (trimmed.StartsWith('{') || trimmed.StartsWith('['))
        {
            return "{…} " + K8sFormat.Bytes(Encoding.UTF8.GetByteCount(value));
        }

        var lines = value.TrimEnd('\n').Split('\n').Length;
        return lines == 1 ? "1 line" : $"{lines.ToString(Inv)} lines";
    }

    /// <summary>TLS expiry chip: Error under 7 days (or past), Warning under 30.</summary>
    private (string Text, Color Color) Expiry(DateTimeOffset notAfter)
    {
        var left = notAfter - Clock.GetUtcNow();
        if (left <= TimeSpan.Zero)
        {
            return ("expired", Color.Error);
        }

        var days = (int)Math.Floor(left.TotalDays);
        return ($"expires in {days.ToString(Inv)}d", days < 7 ? Color.Error : days < 30 ? Color.Warning : Color.Default);
    }

    // RBAC (spec §11): Edit is not rendered without configmaps update in the map's namespace. Until the probe answers
    // nothing mutating renders; an incomplete review renders everything and leaves the 403 as the backstop.
    private bool CanEdit(string ns) =>
        _permissions is { } p && (p.Incomplete || p.Can("", "configmaps", "update", ns));

    private void ToggleMap(ConfigMapRow? row)
    {
        if (row is null)
        {
            return;
        }

        var key = MapKey(row.Map);
        if (!_expandedMaps.Remove(key))
        {
            _expandedMaps.Add(key);
        }
    }

    private void ToggleValue(string key)
    {
        if (!_expandedValues.Remove(key))
        {
            _expandedValues.Add(key);
        }
    }

    protected override void OnInitialized()
    {
        // No poller on this page; the gate still marks dialogs as open.
        _dialogs = new K8sDialogGate(_ => { });
        _visibility = new K8sVisibilityHook(_ => Task.CompletedTask);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Only for the module (clipboard): there is no poller to pause while the tab is hidden.
        if (firstRender && _visibility is not null)
        {
            await _visibility.StartAsync(JS);
        }
    }

    private async Task OnConnectionChangedAsync(ConnectionInfo connection)
    {
        if (_disposed)
        {
            return;
        }

        if (_connection?.Id != connection.Id)
        {
            // Another cluster's config must never sit under this connection's name. The namespace picker re-resolves
            // its selection for the new connection and raises it, which starts the load.
            _generation++;
            _connection = connection;
            _namespaces = null;
            _permissions = null;
            _maps = null;
            _secrets = null;
            _mapsError = null;
            _secretsError = null;
            _expandedMaps.Clear();
            _expandedValues.Clear();
            _showAllMaps = false;
            _showAllSecrets = false;
            _loading = false;
            return;
        }

        _connection = connection;
        await LoadAsync();
    }

    private async Task OnNamespacesChangedAsync(IReadOnlyList<string> namespaces)
    {
        if (_disposed)
        {
            return;
        }

        _namespaces = namespaces;
        _showAllMaps = false;
        _showAllSecrets = false;
        await LoadAsync();
    }

    private async Task RefreshAsync()
    {
        if (_connection is { } connection)
        {
            AccessCache.Invalidate(connection.Id);
        }

        await LoadAsync();
    }

    /// <summary>Permissions, ConfigMaps and Secrets. Each card fails on its own: a 403 on secrets never hides the maps.</summary>
    private async Task LoadAsync()
    {
        if (_connection is not { } connection || _namespaces is not { } namespaces || _disposed)
        {
            return;
        }

        var generation = ++_generation;
        _loading = true;
        StateHasChanged();

        try
        {
            // Sequential on purpose: the handlers share the circuit's scoped services.
            var permissions = await GetPermissions.HandleAsync(connection.Id, namespaces, false, _cts.Token);
            if (generation != _generation || _disposed)
            {
                return;
            }

            // A failed lookup (connection gone) leaves the server's 403 as the backstop rather than hiding everything.
            _permissions = permissions.Value ?? K8sPermissions.All;

            var maps = await ListConfigMaps.HandleAsync(connection.Id, namespaces, _cts.Token);
            if (generation != _generation || _disposed)
            {
                return;
            }

            if (maps is { IsSuccess: true, Value: { } mapRows })
            {
                _maps = mapRows;
                _mapsError = null;
            }
            else
            {
                // Keep the last rows and say why they are not fresh.
                _mapsError = maps.Error ?? "Listing failed.";
            }

            var secrets = await ListSecrets.HandleAsync(connection.Id, namespaces, _cts.Token);
            if (generation != _generation || _disposed)
            {
                return;
            }

            if (secrets is { IsSuccess: true, Value: { } secretRows })
            {
                _secrets = secretRows;
                _secretsError = null;
            }
            else
            {
                // Typically "Your account can't list secrets." — shown in the Secrets card alone.
                _secrets = null;
                _secretsError = secrets.Error ?? "Listing failed.";
            }
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
            return;
        }
        finally
        {
            if (generation == _generation && !_disposed)
            {
                _loading = false;
            }
        }

        if (!_disposed)
        {
            StateHasChanged();
        }
    }

    private async Task EditAsync(K8sConfigMap map)
    {
        if (_connection is not { } connection)
        {
            return;
        }

        var result = await _dialogs.RunAsync(async () =>
        {
            var reference = await ConfigMapEditDialog.ShowAsync(Dialogs, connection, map,
                () => ReadMapAsync(connection.Id, map.Namespace, map.Name));
            return await reference.Result;
        });
        if (_disposed || result is not { Canceled: false })
        {
            return;
        }

        Snackbar.Add($"Updated ConfigMap {map.Name}.", Severity.Success);
        await LoadAsync();
    }

    /// <summary>The map as it is now (null = gone), for the edit dialog's Reload after a conflict.</summary>
    private async Task<PluginResult<K8sConfigMap?>> ReadMapAsync(Guid connectionId, string ns, string name)
    {
        var result = await ListConfigMaps.HandleAsync(connectionId, [ns], _cts.Token);
        return result is { IsSuccess: true, Value: { } rows }
            ? PluginResult<K8sConfigMap?>.Ok(rows.FirstOrDefault(r => r.Map.Namespace == ns && r.Map.Name == name)?.Map)
            : PluginResult<K8sConfigMap?>.Fail(result.Error ?? "Reloading failed.");
    }

    private async Task CopyYamlAsync(K8sConfigMap map)
    {
        if (_connection is not { } connection)
        {
            return;
        }

        var yaml = await GetResourceYaml.HandleAsync(connection.Id, K8sResourceKind.ConfigMap, map.Namespace, map.Name, _cts.Token);
        if (_disposed)
        {
            return;
        }

        if (!yaml.IsSuccess || yaml.Value is null)
        {
            Snackbar.Add(yaml.Error ?? "It no longer exists — refresh.", Severity.Error);
            return;
        }

        try
        {
            if (_visibility?.Module is not { } module)
            {
                return;
            }

            await module.InvokeVoidAsync("copyText", yaml.Value);
            Snackbar.Add($"Copied {map.Name} as YAML.", Severity.Info);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
            // Clipboard access can be refused by the browser; copying is a convenience.
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _cts.Cancel();
        _cts.Dispose();
        if (_visibility is not null)
        {
            await _visibility.DisposeAsync();
        }
    }
}
