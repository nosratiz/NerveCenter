@* Mockup 4a: "what runs here and what does it talk to". The map is one custom component — SVG edges under absolutely
   positioned nodes (MudBlazor has no graph). Detection, layout and the overlay are plain C# (Architecture/); this page
   only renders them. Descriptions, manual and dismissed edges are console data, audited as k8s.arch.edit. Polls every 30 s. *@
@page "/p/kubernetes/architecture"
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using SbConsole.Plugins.Kubernetes.Architecture
@using SbConsole.Plugins.Kubernetes.Overview
@inject GetArchitectureQueryHandler GetArchitecture
@inject SaveDescriptionCommandHandler SaveDescription
@inject AddDependencyCommandHandler AddDependency
@inject RemoveDependencyCommandHandler RemoveDependency
@inject RestoreDismissedCommandHandler RestoreDismissed
@inject AuthenticationStateProvider Auth
@inject TimeProvider Clock
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Kubernetes architecture</PageTitle>

<div class="k8s-page k8s-arch-page">
    <K8sPageHeader Title="Architecture">
        <Chips>
            <K8sConnectionPicker @ref="_picker" Loading="_loading" SelectionChanged="OnConnectionChangedAsync" />
            @if (_connection is not null)
            {
                <K8sNamespacePicker ConnectionId="_connection.Id" SelectionChanged="OnNamespacesChangedAsync" />
            }
        </Chips>
        <Actions>
            @if (_connection is not null)
            {
                <MudTextField T="string" Class="k8s-arch-find" Placeholder="Find a service…" Immediate="true" DebounceInterval="200"
                              Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                              Value="_find" ValueChanged="OnFindChanged" />
            }
        </Actions>
    </K8sPageHeader>

    @if (_connection is not null)
    {
        <div class="k8s-arch-toolbar">
            <span class="k8s-muted">Group by</span>
            <MudToggleGroup T="ArchGroupBy" Class="k8s-arch-groupby" Value="_groupBy" ValueChanged="OnGroupByChanged"
                            Size="Size.Small" Outlined="true" Delimiters="true" Color="Color.Primary">
                <MudToggleItem T="ArchGroupBy" Value="ArchGroupBy.Namespace" Class="k8s-arch-groupby-namespace">Namespace</MudToggleItem>
                <MudToggleItem T="ArchGroupBy" Value="ArchGroupBy.Team" Class="k8s-arch-groupby-team">Team</MudToggleItem>
                <MudToggleItem T="ArchGroupBy" Value="ArchGroupBy.None" Class="k8s-arch-groupby-none">None</MudToggleItem>
            </MudToggleGroup>
            <MudCheckBox T="bool" Class="k8s-arch-show-stores" Dense="true" Size="Size.Small" Color="Color.Primary"
                         Value="_showStores" ValueChanged="OnShowStoresChanged" Label="Stores" />
            <MudCheckBox T="bool" Class="k8s-arch-show-external" Dense="true" Size="Size.Small" Color="Color.Primary"
                         Value="_showExternal" ValueChanged="OnShowExternalChanged" Label="External" />
            @if (_view is not null && Undescribed > 0)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" Class="k8s-arch-undescribed"
                         Icon="@Icons.Material.Outlined.Notes">@Undescribed.ToString(Inv) undescribed</MudChip>
            }
            @if (_view is { Graph.Dismissed: > 0 } dismissedView)
            {
                <span class="k8s-meta k8s-arch-dismissed">
                    @Plural(dismissedView.Graph.Dismissed, "dismissed edge") ·
                    <button type="button" class="k8s-link k8s-arch-restore" @onclick="RestoreAsync">restore</button>
                </span>
            }
            <span class="k8s-spacer"></span>
            <span class="k8s-arch-legend">
                <span><svg width="22" height="6" aria-hidden="true"><line x1="0" y1="3" x2="22" y2="3" class="k8s-arch-legend-line" /></svg>HTTP</span>
                <span><svg width="22" height="6" aria-hidden="true"><line x1="0" y1="3" x2="22" y2="3" class="k8s-arch-legend-line" stroke-dasharray="4 3" /></svg>queue</span>
                <span><svg width="22" height="6" aria-hidden="true"><line x1="0" y1="3" x2="22" y2="3" class="k8s-arch-legend-line k8s-arch-legend-store" /></svg>store</span>
            </span>
        </div>

        <div class="k8s-arch-body">
            <div class="k8s-arch-canvas-wrap">
                @if (_error is not null)
                {
                    <K8sErrorAlert Info="@(new K8sErrorInfo(_error, null, null, false))" Title="Can't map this cluster." Class="k8s-arch-error" />
                }

                @if (_view is not null)
                {
                    @if (_layout.Nodes.Count == 0)
                    {
                        <MudPaper Outlined="true" Class="k8s-arch-empty k8s-muted">No Deployments, StatefulSets or DaemonSets in the selected namespaces.</MudPaper>
                    }
                    else
                    {
                        @Map()
                        <div class="k8s-arch-caption k8s-meta">
                            <span>Click a node to inspect</span>
                            <span class="k8s-arch-edge-counts">@EdgeCounts</span>
                        </div>
                    }
                }
                else if (_error is null)
                {
                    <div class="k8s-arch-loading">
                        @for (var i = 0; i < 3; i++)
                        {
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="160px" Height="52px" />
                        }
                    </div>
                }
            </div>

            @if (Selected is { } node)
            {
                @Inspector(node)
            }
        </div>
    }
</div>

@code {
    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(30);
    private const string ExternalOption = "__external__";

    private readonly CancellationTokenSource _cts = new();
    private K8sPoller? _poller;
    private K8sVisibilityHook? _visibility;
    private K8sConnectionPicker? _picker;
    private ConnectionInfo? _connection;
    private IReadOnlyList<string>? _namespaces;
    private ArchitectureView? _view;
    private ArchLayout _layout = ArchLayout.Empty;
    private string? _error;
    private bool _loading;
    private int _generation;
    private bool _disposed;

    private ArchGroupBy _groupBy = ArchGroupBy.Namespace;
    private bool _showStores = true;
    private bool _showExternal = true;
    private string _find = "";
    private string? _selectedId;

    // Inspector state: description editor and the add-dependency form.
    private bool _editing;
    private string _draft = "";
    private int _draftVersion;
    private bool _adding;
    private string? _addTo;
    private string _addHost = "";
    private ArchEdgeKind _addKind = ArchEdgeKind.Http;
    private string _addLabel = "";
    private string? _inspectorError;
    private bool _busy;

    private ArchNode? Selected => _selectedId is null ? null : _view?.Graph.Nodes.FirstOrDefault(n => n.Id == _selectedId);

    private ArchDescription? DescriptionOf(string id) => _view?.Descriptions.GetValueOrDefault(id);

    /// <summary>Workloads and stores in the selection that nobody has described yet.</summary>
    private int Undescribed => _view?.Graph.Nodes.Count(n => n.InScope && n.Kind is ArchNodeKind.Workload or ArchNodeKind.Store
                                                            && !_view.Descriptions.ContainsKey(n.Id)) ?? 0;

    private string EdgeCounts
    {
        get
        {
            var edges = _layout.Edges;
            var manual = edges.Count(e => e.Edge.Manual);
            return $"{Plural(edges.Count, "edge")} · {(edges.Count - manual).ToString(Inv)} detected · {manual.ToString(Inv)} manual";
        }
    }

    private static string Plural(int n, string one) => $"{n.ToString(Inv)} {one}{(n == 1 ? "" : "s")}";

    private string Link(string href) => AttentionRules.WithConnection(_connection?.Id ?? Guid.Empty)(href);

    private bool Matches(ArchNode n) => _find.Trim().Length == 0 || n.Name.Contains(_find.Trim(), StringComparison.OrdinalIgnoreCase);

    private static string Px(int v) => v.ToString(Inv) + "px";

    private static string NodeIcon(ArchNode n) => n.Kind switch
    {
        ArchNodeKind.Ingress => Icons.Material.Outlined.Public,
        ArchNodeKind.External => Icons.Material.Outlined.OpenInNew,
        ArchNodeKind.Service => Icons.Material.Outlined.Hub,
        ArchNodeKind.Store => n.StoreType switch
        {
            "Redis" or "Memcached" => Icons.Material.Outlined.Bolt,
            "Kafka" or "RabbitMQ" or "NATS" => Icons.Material.Outlined.Queue,
            _ => Icons.Material.Outlined.Storage,
        },
        _ => Icons.Material.Outlined.ViewInAr,
    };

    private static string HealthClass(ArchHealth h) => h switch
    {
        ArchHealth.Ok => "k8s-arch-ok",
        ArchHealth.Degraded => "k8s-arch-degraded",
        ArchHealth.Failing => "k8s-arch-failing",
        ArchHealth.Idle => "k8s-arch-idle",
        _ => "",
    };

    private static (string Text, Color Color)? HealthChip(ArchHealth h) => h switch
    {
        ArchHealth.Ok => ("healthy", Color.Success),
        ArchHealth.Degraded => ("degraded", Color.Warning),
        ArchHealth.Failing => ("unavailable", Color.Error),
        ArchHealth.Idle => ("scaled to 0", Color.Default),
        _ => null,
    };

    private string NodeClass(ArchNode n)
    {
        var cls = "k8s-arch-node " + HealthClass(n.Health);
        if (n.Id == _selectedId) cls += " k8s-arch-node-selected";
        if (n.Kind == ArchNodeKind.External) cls += " k8s-arch-node-external";
        if (!Matches(n)) cls += " k8s-arch-node-dim";
        return cls;
    }

    private string EdgeClass(ArchEdge e)
    {
        var cls = "k8s-arch-edge k8s-arch-edge-" + e.Kind.ToString().ToLowerInvariant();
        if (_selectedId is not null && (e.From == _selectedId || e.To == _selectedId)) cls += " k8s-arch-edge-on";
        return cls;
    }

    private RenderFragment Map() => __builder =>
    {
        <div class="k8s-arch-canvas" style="@($"width:{Px(_layout.Width)};height:{Px(_layout.Height)}")">
            @foreach (var lane in _layout.Lanes)
            {
                <div class="@(lane.Side ? "k8s-arch-lane k8s-arch-lane-side" : "k8s-arch-lane")"
                     style="@($"left:{Px(lane.X)};top:{Px(lane.Y)};width:{Px(lane.Width)};height:{Px(lane.Height)}")">
                    @if (lane.Label.Length > 0)
                    {
                        <span class="k8s-arch-lane-label">@lane.Label</span>
                    }
                </div>
            }
            <svg class="k8s-arch-edges" width="@_layout.Width.ToString(Inv)" height="@_layout.Height.ToString(Inv)" aria-hidden="true">
                <defs>
                    <marker id="k8s-arch-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
                        <path d="M0 0.5 L7.5 4 L0 7.5 Z" class="k8s-arch-arrow" />
                    </marker>
                    <marker id="k8s-arch-arrow-on" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
                        <path d="M0 0.5 L7.5 4 L0 7.5 Z" class="k8s-arch-arrow-on" />
                    </marker>
                </defs>
                @* Selected edges last, so they paint over the others. *@
                @foreach (var placed in _layout.Edges.OrderBy(p => p.Edge.From == _selectedId || p.Edge.To == _selectedId))
                {
                    var cls = EdgeClass(placed.Edge);
                    <path d="@placed.Path" class="@cls" data-edge="@placed.Edge.Id"
                          marker-end="@(cls.Contains("k8s-arch-edge-on", StringComparison.Ordinal) ? "url(#k8s-arch-arrow-on)" : "url(#k8s-arch-arrow)")" />
                }
            </svg>
            @if (_selectedId is not null)
            {
                @foreach (var placed in _layout.Edges.Where(p => p.Edge.From == _selectedId || p.Edge.To == _selectedId))
                {
                    <span class="k8s-arch-edge-label k8s-mono" style="@($"left:{Px(placed.LabelX)};top:{Px(placed.LabelY)}")">@placed.Edge.Label</span>
                }
            }
            @foreach (var placed in _layout.Nodes)
            {
                var n = placed.Node;
                <button type="button" class="@NodeClass(n)" data-node="@n.Id" title="@n.Name"
                        style="@($"left:{Px(placed.X)};top:{Px(placed.Y)};width:{Px(placed.Width)}")"
                        aria-pressed="@(n.Id == _selectedId ? "true" : "false")" @onclick="() => Select(n.Id)">
                    <MudIcon Icon="@NodeIcon(n)" Size="Size.Small" Class="k8s-arch-node-icon" />
                    <span class="k8s-arch-node-text">
                        <span class="k8s-arch-node-name k8s-mono">
                            <span class="k8s-arch-node-title">@n.Name</span>
                            @if (DescriptionOf(n.Id) is not null)
                            {
                                <MudIcon Icon="@Icons.Material.Outlined.Notes" Class="k8s-arch-described" Style="font-size:12px" Title="Has a description" />
                            }
                        </span>
                        <span class="k8s-arch-node-sub">@n.Subtitle</span>
                    </span>
                </button>
            }
        </div>
    };

    private RenderFragment Inspector(ArchNode node) => __builder =>
    {
        var description = DescriptionOf(node.Id);
        var dependsOn = _view!.Graph.Edges.Where(e => e.From == node.Id).ToList();
        var usedBy = _view.Graph.Edges.Where(e => e.To == node.Id).ToList();
        <aside class="k8s-arch-inspector" aria-label="@($"{node.Name} details")">
            <div class="k8s-arch-insp-head">
                <div class="k8s-arch-insp-title">
                    <span class="k8s-mono k8s-arch-insp-name">@node.Name</span>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="k8s-arch-insp-kind">@KindText(node)</MudChip>
                    <span class="k8s-spacer"></span>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Class="k8s-arch-insp-close" aria-label="Close" OnClick="CloseInspector" />
                </div>
                <div class="k8s-arch-insp-meta">
                    @if (node.Namespace is { } ns)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="k8s-mono k8s-arch-insp-ns">@ns</MudChip>
                    }
                    @if (HealthChip(node.Health) is { } chip)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="chip.Color" Class="k8s-arch-insp-health">@chip.Text</MudChip>
                    }
                    @if (node.Version is { } version)
                    {
                        <span class="k8s-mono k8s-muted k8s-arch-insp-version">@version</span>
                    }
                </div>
                @if (node is { WorkloadKind: K8sWorkloadKind.Deployment, Namespace: { } deploymentNs })
                {
                    <MudButton Href="@Link(KubernetesPlugin.DeploymentHref(deploymentNs, node.Name))" Variant="Variant.Outlined" Size="Size.Small"
                               Class="k8s-arch-open-deployment">Open deployment</MudButton>
                }
            </div>

            <div class="k8s-arch-insp-body">
                @if (_inspectorError is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="k8s-arch-insp-error" ShowCloseIcon="true"
                              CloseIconClicked="() => _inspectorError = null">@_inspectorError</MudAlert>
                }

                @if (node.Kind is not ArchNodeKind.External)
                {
                    <section class="k8s-arch-section k8s-arch-description">
                        <div class="k8s-arch-section-head">
                            <span class="k8s-tile-label">Description</span>
                            @if (description is not null)
                            {
                                <span class="k8s-meta k8s-arch-desc-stamp">v@(description.Version.ToString(Inv)) · @description.Author · @Ago(description.At)</span>
                            }
                        </div>
                        @if (_editing)
                        {
                            <MudTextField T="string" Class="k8s-arch-desc-editor" Lines="6" Variant="Variant.Outlined"
                                          Margin="Margin.Dense" Immediate="true" MaxLength="SaveDescriptionCommandHandler.MaxLength"
                                          Placeholder="What it does, what it owns, who's on call…" AutoFocus="true"
                                          Value="_draft" ValueChanged="v => _draft = v ?? string.Empty" />
                            <div class="k8s-arch-desc-actions">
                                <span class="k8s-meta">Markdown · stored by the console</span>
                                <span class="k8s-spacer"></span>
                                <MudButton Variant="Variant.Text" Size="Size.Small" Class="k8s-arch-desc-cancel" OnClick="CancelEdit" Disabled="_busy">Cancel</MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="k8s-arch-desc-save"
                                           OnClick="() => SaveDescriptionAsync(node)" Disabled="_busy">Save</MudButton>
                            </div>
                        }
                        else if (description is not null)
                        {
                            <div class="k8s-arch-desc-text">@description.Text</div>
                            <MudButton Variant="Variant.Text" Size="Size.Small" Class="k8s-arch-desc-edit" StartIcon="@Icons.Material.Outlined.Edit"
                                       OnClick="() => StartEdit(node)">Edit</MudButton>
                        }
                        else
                        {
                            <div class="k8s-muted k8s-arch-desc-none">No description yet.</div>
                            <MudButton Variant="Variant.Text" Size="Size.Small" Class="k8s-arch-desc-edit" StartIcon="@Icons.Material.Outlined.Add"
                                       OnClick="() => StartEdit(node)">Add description</MudButton>
                        }
                    </section>
                }

                <section class="k8s-arch-section k8s-arch-depends-on">
                    <div class="k8s-arch-section-head"><span class="k8s-tile-label">Depends on</span><span class="k8s-meta">@dependsOn.Count.ToString(Inv)</span></div>
                    @if (dependsOn.Count == 0)
                    {
                        <div class="k8s-muted k8s-arch-dep-none">Nothing detected.</div>
                    }
                    @foreach (var edge in dependsOn)
                    {
                        @DependencyRow(edge, edge.To)
                    }
                </section>

                <section class="k8s-arch-section k8s-arch-used-by">
                    <div class="k8s-arch-section-head"><span class="k8s-tile-label">Used by</span><span class="k8s-meta">@usedBy.Count.ToString(Inv)</span></div>
                    @if (usedBy.Count == 0)
                    {
                        <div class="k8s-muted k8s-arch-dep-none">Nothing detected.</div>
                    }
                    @foreach (var edge in usedBy)
                    {
                        @DependencyRow(edge, edge.From)
                    }
                </section>

                @if (node.Kind is ArchNodeKind.Workload or ArchNodeKind.Store or ArchNodeKind.Ingress)
                {
                    @if (_adding)
                    {
                        @AddForm(node)
                    }
                    else
                    {
                        <MudButton Variant="Variant.Text" Size="Size.Small" Class="k8s-arch-add" StartIcon="@Icons.Material.Outlined.Add"
                                   OnClick="StartAdd">Add dependency</MudButton>
                    }
                }
            </div>

            <div class="k8s-footnote k8s-arch-insp-foot">
                Detected edges refresh every 30 s. Manual edges and descriptions are console data, audited as <span class="k8s-mono">k8s.arch.edit</span>.
            </div>
        </aside>
    };

    private RenderFragment DependencyRow(ArchEdge edge, string otherId) => __builder =>
    {
        var other = _view!.Graph.Nodes.FirstOrDefault(n => n.Id == otherId);
        <div class="k8s-arch-dep" data-edge="@edge.Id">
            @if (other is not null)
            {
                <MudIcon Icon="@NodeIcon(other)" Size="Size.Small" Class="k8s-arch-dep-icon" />
            }
            <div class="k8s-arch-dep-text">
                <button type="button" class="k8s-link k8s-mono k8s-arch-dep-name" @onclick="() => Select(otherId)">@(other?.Name ?? otherId)</button>
                <span class="k8s-muted k8s-arch-dep-label">@edge.Label@(other?.Kind == ArchNodeKind.External ? " · external" : "")</span>
            </div>
            <span class="k8s-mono k8s-arch-src">@edge.Source</span>
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Class="k8s-arch-dep-remove" Disabled="_busy"
                           aria-label="@(edge.Manual ? "Remove dependency" : "Dismiss detected dependency")"
                           title="@(edge.Manual ? "Remove" : "Dismiss — wrongly detected")" OnClick="() => RemoveAsync(edge)" />
        </div>
    };

    private RenderFragment AddForm(ArchNode node) => __builder =>
    {
        var candidates = _view!.Graph.Nodes.Where(n => n.Id != node.Id && n.Kind != ArchNodeKind.Ingress)
            .OrderBy(n => n.Name, StringComparer.Ordinal).ToList();
        <div class="k8s-arch-add-form">
            <MudSelect T="string" Class="k8s-arch-add-to" Label="Depends on" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                       Value="_addTo" ValueChanged="v => _addTo = v" ToStringFunc="@(id => AddTargetText(id))">
                @foreach (var c in candidates)
                {
                    <MudSelectItem T="string" Value="c.Id">@AddTargetText(c.Id)</MudSelectItem>
                }
                <MudSelectItem T="string" Value="@ExternalOption">External host…</MudSelectItem>
            </MudSelect>
            @if (_addTo == ExternalOption)
            {
                <MudTextField T="string" Class="k8s-arch-add-host" Label="Host or URL" Placeholder="api.stripe.com" Variant="Variant.Outlined"
                              Margin="Margin.Dense" Immediate="true" Value="_addHost" ValueChanged="v => _addHost = v ?? string.Empty" />
            }
            <div class="k8s-arch-add-row">
                <MudSelect T="ArchEdgeKind" Class="k8s-arch-add-kind" Label="Kind" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                           Value="_addKind" ValueChanged="v => _addKind = v">
                    <MudSelectItem T="ArchEdgeKind" Value="ArchEdgeKind.Http">HTTP / gRPC</MudSelectItem>
                    <MudSelectItem T="ArchEdgeKind" Value="ArchEdgeKind.Queue">Queue</MudSelectItem>
                    <MudSelectItem T="ArchEdgeKind" Value="ArchEdgeKind.Store">Store</MudSelectItem>
                </MudSelect>
                <MudTextField T="string" Class="k8s-arch-add-label" Label="Label (optional)" Variant="Variant.Outlined" Margin="Margin.Dense"
                              MaxLength="AddDependencyCommandHandler.MaxLabelLength" Immediate="true"
                              Value="_addLabel" ValueChanged="v => _addLabel = v ?? string.Empty" />
            </div>
            <div class="k8s-arch-desc-actions">
                <span class="k8s-spacer"></span>
                <MudButton Variant="Variant.Text" Size="Size.Small" Class="k8s-arch-add-cancel" OnClick="CancelAdd" Disabled="_busy">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="k8s-arch-add-save"
                           OnClick="() => AddAsync(node)" Disabled="@(_busy || _addTo is null)">Add</MudButton>
            </div>
        </div>
    };

    private string AddTargetText(string? id)
    {
        if (id is null) return "";
        if (id == ExternalOption) return "External host…";
        var n = _view?.Graph.Nodes.FirstOrDefault(x => x.Id == id);
        return n is null ? id : n.Namespace is { } ns ? $"{n.Name} · {ns}" : n.Name;
    }

    private static string KindText(ArchNode n) => n.Kind switch
    {
        ArchNodeKind.Ingress => "Ingress",
        ArchNodeKind.External => "External",
        ArchNodeKind.Service => "Service",
        ArchNodeKind.Store => $"{n.StoreType} · {n.WorkloadKind}",
        _ => n.WorkloadKind?.ToString() ?? "Workload",
    };

    private string Ago(DateTimeOffset at) => K8sFormat.Age(Clock.GetUtcNow() - at) + " ago";

    private void Select(string id)
    {
        if (_selectedId != id)
        {
            _editing = false;
            _adding = false;
            _inspectorError = null;
        }

        _selectedId = id;
    }

    private void CloseInspector()
    {
        _selectedId = null;
        _editing = false;
        _adding = false;
        _inspectorError = null;
    }

    private void OnFindChanged(string? value)
    {
        _find = value ?? "";
        // A single match is selected for you.
        var matches = _view?.Graph.Nodes.Where(n => _layout.Nodes.Any(p => p.Node.Id == n.Id) && _find.Trim().Length > 0 && Matches(n)).ToList();
        if (matches is { Count: 1 })
        {
            Select(matches[0].Id);
        }
    }

    private void OnGroupByChanged(ArchGroupBy by)
    {
        _groupBy = by;
        Relayout();
    }

    private void OnShowStoresChanged(bool show)
    {
        _showStores = show;
        Relayout();
    }

    private void OnShowExternalChanged(bool show)
    {
        _showExternal = show;
        Relayout();
    }

    private void Relayout()
    {
        _layout = _view is null ? ArchLayout.Empty : ArchitectureLayout.Compute(_view.Graph, new ArchLayoutOptions(_groupBy, _showStores, _showExternal));
        if (_selectedId is not null && _layout.Nodes.All(p => p.Node.Id != _selectedId))
        {
            CloseInspector();
        }
    }

    private void StartEdit(ArchNode node)
    {
        var current = DescriptionOf(node.Id);
        _draft = current?.Text ?? "";
        _draftVersion = current?.Version ?? 0;
        _editing = true;
        _inspectorError = null;
    }

    private void CancelEdit()
    {
        _editing = false;
        _inspectorError = null;
    }

    private void StartAdd()
    {
        _adding = true;
        _addTo = null;
        _addHost = "";
        _addKind = ArchEdgeKind.Http;
        _addLabel = "";
        _inspectorError = null;
    }

    private void CancelAdd()
    {
        _adding = false;
        _inspectorError = null;
    }

    private async Task<ArchEditContext?> ContextAsync()
    {
        if (_connection is not { } connection)
        {
            return null;
        }

        var state = await Auth.GetAuthenticationStateAsync();
        return new ArchEditContext(connection.Id, connection.Name, state.User.Identity?.Name ?? "anonymous");
    }

    private async Task SaveDescriptionAsync(ArchNode node)
    {
        if (await ContextAsync() is not { } context || _disposed)
        {
            return;
        }

        _busy = true;
        try
        {
            var r = await SaveDescription.HandleAsync(new SaveDescriptionCommand(context, node.Id, _draft, _draftVersion), _cts.Token);
            if (_disposed) return;
            if (r.IsSuccess || r.Error == "Nothing changed.")
            {
                _editing = false;
                _inspectorError = null;
                await LoadAsync(background: true);
            }
            else
            {
                _inspectorError = r.Error;
            }
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AddAsync(ArchNode node)
    {
        if (_addTo is null || await ContextAsync() is not { } context || _disposed)
        {
            return;
        }

        _busy = true;
        try
        {
            var to = _addTo == ExternalOption ? _addHost : _addTo;
            var r = await AddDependency.HandleAsync(new AddDependencyCommand(context, node.Id, to, _addKind, _addLabel), _cts.Token);
            if (_disposed) return;
            if (r.IsSuccess)
            {
                _adding = false;
                _inspectorError = null;
                await LoadAsync(background: true);
            }
            else
            {
                _inspectorError = r.Error;
            }
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemoveAsync(ArchEdge edge)
    {
        if (await ContextAsync() is not { } context || _disposed)
        {
            return;
        }

        _busy = true;
        try
        {
            var r = await RemoveDependency.HandleAsync(new RemoveDependencyCommand(context, edge), _cts.Token);
            if (_disposed) return;
            _inspectorError = r.IsSuccess ? null : r.Error;
            await LoadAsync(background: true);
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RestoreAsync()
    {
        if (await ContextAsync() is not { } context || _disposed)
        {
            return;
        }

        try
        {
            var r = await RestoreDismissed.HandleAsync(context, _cts.Token);
            if (_disposed) return;
            if (!r.IsSuccess)
            {
                _error = r.Error;
            }

            await LoadAsync(background: true);
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
        }
    }

    protected override void OnInitialized()
    {
        _poller = new K8sPoller(Clock, PollInterval, PollAsync);
        _visibility = new K8sVisibilityHook(SetHidden);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _visibility is not null)
        {
            await _visibility.StartAsync(JS);
        }
    }

    /// <summary>Called through <see cref="K8sVisibilityHook"/>: no polling while the browser tab is hidden.</summary>
    public Task SetHidden(bool hidden)
    {
        if (!_disposed && _poller is not null)
        {
            _poller.Hidden = hidden;
        }

        return Task.CompletedTask;
    }

    private async Task OnConnectionChangedAsync(ConnectionInfo connection)
    {
        if (_disposed)
        {
            return;
        }

        if (_connection?.Id != connection.Id)
        {
            // Another cluster's map must never sit under this connection's name. The namespace picker raises its
            // selection for the new connection, which starts the load.
            _generation++;
            _connection = connection;
            _namespaces = null;
            _view = null;
            _layout = ArchLayout.Empty;
            _error = null;
            _loading = false;
            CloseInspector();
            _poller?.Start();
            return;
        }

        _connection = connection;
        await LoadAsync(background: false);
    }

    private async Task OnNamespacesChangedAsync(IReadOnlyList<string> namespaces)
    {
        if (_disposed)
        {
            return;
        }

        _namespaces = namespaces;
        await LoadAsync(background: false);
    }

    private async Task LoadAsync(bool background)
    {
        if (_connection is not { } connection || _namespaces is not { } namespaces || _disposed)
        {
            return;
        }

        var generation = ++_generation;
        if (!background)
        {
            _loading = true;
            StateHasChanged();
        }

        try
        {
            var result = await GetArchitecture.HandleAsync(connection.Id, namespaces, _cts.Token);
            if (generation != _generation || _disposed)
            {
                return;
            }

            if (result is { IsSuccess: true, Value: { } view })
            {
                _view = view;
                _error = null;
                Relayout();
            }
            else
            {
                // Keep the last map on screen and say why it is not fresh.
                _error = result.Error ?? "Loading failed.";
            }
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
            return;
        }
        finally
        {
            if (generation == _generation && !_disposed)
            {
                _loading = false;
            }
        }

        if (_disposed)
        {
            return;
        }

        StateHasChanged();
        if (_picker is not null)
        {
            await _picker.RefreshReachabilityAsync();
        }
    }

    private async Task PollAsync()
    {
        if (_disposed)
        {
            return;
        }

        try
        {
            await InvokeAsync(async () =>
            {
                if (_disposed || _loading || _busy)
                {
                    return;
                }

                await LoadAsync(background: true);
            });
        }
        catch (Exception)
        {
            // A timer callback must never throw: a disposed circuit or a failed render just skips this tick.
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _poller?.Dispose();
        _cts.Cancel();
        _cts.Dispose();
        if (_visibility is not null)
        {
            await _visibility.DisposeAsync();
        }
    }
}
