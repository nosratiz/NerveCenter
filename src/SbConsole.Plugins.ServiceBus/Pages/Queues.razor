@page "/p/azure-servicebus/queues"
@using SbConsole.Plugins.ServiceBus.Client
@using SbConsole.Plugins.ServiceBus.Queues
@using SbConsole.Sdk
@inject IConnectionProvider Connections
@inject IPluginStore Store
@inject TimeProvider Clock
@inject ListQueuesQueryHandler ListHandler
@inject DeleteQueueCommandHandler DeleteHandler
@inject IConfirmationService Confirmation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Queues</PageTitle>
<h1>Queues</h1>

@if (_connections.Count == 0)
{
    <MudAlert Severity="Severity.Info">No connections yet. Add an Azure Service Bus connection to get started.</MudAlert>
}
else
{
    <div class="d-flex align-center flex-wrap gap-4 my-4">
        <div class="d-flex align-center gap-2">
            <MudText Typo="Typo.overline" Class="mud-text-secondary">Namespace</MudText>
            <MudMenu Class="namespace-menu">
                <ActivatorContent>
                    <div class="d-flex align-center gap-2" style="cursor:pointer">
                        <MudText Typo="Typo.subtitle1" Style="font-family:monospace">@SelectedConnection?.Name</MudText>
                        @if (SelectedConnection?.IsProd == true)
                        {
                            <MudChip T="string" Color="Color.Warning" Size="Size.Small">prod</MudChip>
                        }
                        <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Size="Size.Small" />
                    </div>
                </ActivatorContent>
                <ChildContent>
                    @foreach (var connection in _connections)
                    {
                        <MudMenuItem Class="namespace-option" OnClick="@(() => OnConnectionChanged(connection.Id))">@connection.Name</MudMenuItem>
                    }
                </ChildContent>
            </MudMenu>
        </div>

        <MudTextField T="string" Class="queue-filter" Placeholder="Filter queues..." @bind-Value="_filterText" Immediate="true" Style="max-width:220px" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />

        <MudButtonGroup Class="metric-range" Variant="Variant.Outlined">
            @foreach (var range in AllRanges)
            {
                <MudButton Class="@($"range-{RangeLabel(range)}")" Variant="@(range == _range ? Variant.Filled : Variant.Outlined)" OnClick="@(() => SelectRange(range))">@RangeLabel(range)</MudButton>
            }
        </MudButtonGroup>

        <MudSpacer />
        <MudButton Class="create-queue-action" Color="Color.Primary" Variant="Variant.Outlined" OnClick="OpenCreate">+ Create queue</MudButton>
        @if (_loading)
        {
            <MudProgressCircular Class="queues-busy" Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
        }
    </div>

    <MudText Class="queues-summary mud-text-secondary mb-2" Typo="Typo.body2">@QueueCount @(QueueCount == 1 ? "queue" : "queues") &middot; @DeadLetterCount dead-lettered</MudText>

    <MudTable Items="FilteredQueues">
        <HeaderContent>
            <MudTh>Queue</MudTh>
            <MudTh>Active (@RangeLabel(_range))</MudTh>
            <MudTh>Active</MudTh>
            <MudTh>DLQ (@RangeLabel(_range))</MudTh>
            <MudTh>DLQ</MudTh>
            <MudTh>Size</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd Style="font-family:monospace">@context.Name</MudTd>
            <MudTd><Sparkline Values="@ActiveSeries(context.Name)" Max="@ActiveMax" Color="var(--mud-palette-primary)" /></MudTd>
            <MudTd>@context.ActiveMessageCount</MudTd>
            <MudTd><Sparkline Values="@DeadLetterSeries(context.Name)" Max="@DeadLetterMax" Color="var(--mud-palette-error)" /></MudTd>
            <MudTd Style="@(context.DeadLetterMessageCount > 0 ? "color:var(--mud-palette-error)" : null)">@context.DeadLetterMessageCount</MudTd>
            <MudTd>@FormatSize(context.SizeInBytes)</MudTd>
            <MudTd>
                <MudButton Href="@PeekUrl(context.Name)">Peek</MudButton>
                <MudButton Class="dead-letter-action" Href="@PeekUrl(context.Name, deadLetter: true, deadLetterCount: context.DeadLetterMessageCount)">Dead-letter</MudButton>
                <MudButton Class="send-message-action" OnClick="@(() => OpenSend(context.Name))">Send</MudButton>
                <MudButton Class="delete-queue" Color="Color.Error" Disabled="@(_deletingQueue == context.Name)" OnClick="@(() => DeleteAsync(context.Name))">Delete</MudButton>
                @if (_deletingQueue == context.Name)
                {
                    <MudProgressCircular Class="delete-queue-busy" Color="Color.Error" Size="Size.Small" Indeterminate="true" />
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
    <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">Sparklines share a y-scale per column, so a flat line means flat — not small.</MudText>
}

@code {
    private enum MetricRange { OneHour, SixHours, TwentyFourHours }
    private static readonly MetricRange[] AllRanges = [MetricRange.OneHour, MetricRange.SixHours, MetricRange.TwentyFourHours];

    private static TimeSpan RangeSpan(MetricRange range) => range switch
    {
        MetricRange.OneHour => TimeSpan.FromHours(1),
        MetricRange.SixHours => TimeSpan.FromHours(6),
        _ => TimeSpan.FromHours(24),
    };

    private static string RangeLabel(MetricRange range) => range switch
    {
        MetricRange.OneHour => "1h",
        MetricRange.SixHours => "6h",
        _ => "24h",
    };

    private IReadOnlyList<ConnectionInfo> _connections = [];
    private IReadOnlyList<QueueSummary> _queues = [];
    private Dictionary<string, IReadOnlyList<MetricSnapshotPoint>> _history = new();
    private Guid _selectedConnectionId;
    private MetricRange _range = MetricRange.SixHours;

    private ConnectionInfo? SelectedConnection => _connections.FirstOrDefault(c => c.Id == _selectedConnectionId);

    // Busy-state convention for this plugin's pages (the host had none to match -- Connections.razor
    // grew the same shape in the same change). Every button that awaits an Azure call flips a flag
    // before the await and clears it in a `finally`, binds that flag to its own Disabled, and shows
    // a small inline MudProgressCircular beside itself. The flag is scoped to the thing being acted
    // on (a queue name here, a connection id on Connections.razor) so an in-flight call never
    // disables unrelated rows. Timeouts (AzureServiceBusOperations' tightened RetryOptions and the
    // 2-minute cap on the looping operations) are what actually bound the wait -- this is only so a
    // bounded wait doesn't look like a frozen page.
    private bool _loading;
    private string? _deletingQueue;
    private string _filterText = "";

    private int QueueCount => _queues.Count;
    private long DeadLetterCount => _queues.Sum(q => q.DeadLetterMessageCount);

    private IEnumerable<QueueSummary> FilteredQueues => string.IsNullOrWhiteSpace(_filterText)
        ? _queues
        : _queues.Where(q => q.Name.Contains(_filterText, StringComparison.OrdinalIgnoreCase));

    // Shared per-column y-scale (the mockup's own point: a flat sparkline must mean flat, not
    // "too small to see next to a bigger row's line") -- the max is taken across every row
    // currently shown, not each row's own history.
    private long ActiveMax => FilteredQueues.SelectMany(q => HistoryWithin(q.Name).Select(p => p.ActiveCount)).DefaultIfEmpty(0).Max();
    private long DeadLetterMax => FilteredQueues.SelectMany(q => HistoryWithin(q.Name).Select(p => p.DeadLetterCount)).DefaultIfEmpty(0).Max();

    private IReadOnlyList<long> ActiveSeries(string queueName) => [.. HistoryWithin(queueName).Select(p => p.ActiveCount)];
    private IReadOnlyList<long> DeadLetterSeries(string queueName) => [.. HistoryWithin(queueName).Select(p => p.DeadLetterCount)];

    private IEnumerable<MetricSnapshotPoint> HistoryWithin(string queueName)
    {
        if (!_history.TryGetValue(queueName, out var points))
        {
            return [];
        }

        var cutoff = Clock.GetUtcNow() - RangeSpan(_range);
        return points.Where(p => p.At >= cutoff);
    }

    private void SelectRange(MetricRange range) => _range = range;

    protected override async Task OnInitializedAsync()
    {
        _connections = await Connections.ListAsync("azure-servicebus");
        if (_connections.Count > 0)
        {
            _selectedConnectionId = _connections[0].Id;
            await LoadQueuesAsync();
        }
    }

    private async Task OnConnectionChanged(Guid connectionId)
    {
        _selectedConnectionId = connectionId;
        await LoadQueuesAsync();
    }

    private async Task LoadQueuesAsync()
    {
        _loading = true;
        try
        {
            var result = await ListHandler.HandleAsync(_selectedConnectionId);
            if (result.IsSuccess)
            {
                _queues = result.Value!;
            }
            else
            {
                _queues = [];
                Snackbar.Add(result.Error!, Severity.Error);
            }

            // Records the count this page just fetched live, so the trend line responds to
            // whatever the user just did (send, consume, delete, create) immediately instead of
            // waiting for MetricsCollectorService's next passive 60s tick.
            foreach (var queue in _queues)
            {
                var point = new MetricSnapshotPoint(Clock.GetUtcNow(), queue.ActiveMessageCount, queue.DeadLetterMessageCount);
                await MetricHistoryStore.AppendAsync(Store, _selectedConnectionId, queue.Name, point);
            }

            await LoadHistoryAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadHistoryAsync()
    {
        var history = new Dictionary<string, IReadOnlyList<MetricSnapshotPoint>>();
        foreach (var queue in _queues)
        {
            history[queue.Name] = await MetricHistoryStore.ReadAsync(Store, _selectedConnectionId, queue.Name);
        }

        _history = history;
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:0.#} KB",
        _ => $"{bytes / (1024.0 * 1024.0):0.#} MB",
    };

    // Peek.razor looks the connection's name and prod status up itself from ConnectionId via
    // IConnectionProvider, rather than trusting them off the URL (a hand-typed link omitting
    // isProd used to silently downgrade a prod dead-letter purge to a plain two-button confirm).
    // So this only needs to carry ConnectionId, plus DeadLetter/DeadLetterCount when linking into
    // dead-letter mode -- deadLetterCount is the row's live count, used so the purge confirmation
    // shows the real message count rather than the peek page's capped page size.
    private string PeekUrl(string queueName, bool deadLetter = false, long? deadLetterCount = null)
    {
        var connection = _connections.Single(c => c.Id == _selectedConnectionId);
        var url = $"/p/azure-servicebus/queues/{Uri.EscapeDataString(queueName)}/peek?connectionId={connection.Id}";
        if (deadLetter)
        {
            url += "&deadLetter=true";
            if (deadLetterCount is not null)
            {
                url += $"&deadLetterCount={deadLetterCount}";
            }
        }

        return url;
    }

    private async Task OpenCreate()
    {
        var connection = _connections.Single(c => c.Id == _selectedConnectionId);
        var parameters = new DialogParameters<CreateQueueDialog>
        {
            { x => x.ConnectionId, connection.Id },
            { x => x.ConnectionName, connection.Name },
        };
        var dialog = await DialogService.ShowAsync<CreateQueueDialog>("Create queue", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadQueuesAsync();
        }
    }

    private async Task OpenSend(string queueName)
    {
        var connection = _connections.Single(c => c.Id == _selectedConnectionId);
        var parameters = new DialogParameters<SendMessageDialog>
        {
            { x => x.ConnectionId, connection.Id },
            { x => x.ConnectionName, connection.Name },
            { x => x.QueueName, queueName },
        };
        var dialog = await DialogService.ShowAsync<SendMessageDialog>("Send message", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadQueuesAsync();
        }
    }

    private async Task DeleteAsync(string queueName)
    {
        var connection = _connections.Single(c => c.Id == _selectedConnectionId);
        var confirmed = await Confirmation.ConfirmAsync("Delete", queueName, connection.IsProd);
        if (!confirmed)
        {
            return;
        }

        _deletingQueue = queueName;
        try
        {
            var result = await DeleteHandler.HandleAsync(new DeleteQueueCommand(connection.Id, connection.Name, connection.IsProd, queueName));
            if (!result.IsSuccess)
            {
                Snackbar.Add(result.Error!, Severity.Error);
            }
        }
        finally
        {
            _deletingQueue = null;
        }

        await LoadQueuesAsync();
    }
}
