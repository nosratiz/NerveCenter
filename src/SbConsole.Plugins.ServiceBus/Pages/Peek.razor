@* Message browser: peeks a queue's active messages, or its dead-letter sub-queue when DeadLetter
   is set. Dead-letter mode adds multi-select resubmit and a queue-wide dead-letter purge. *@
@page "/p/azure-servicebus/queues/{QueueName}/peek"
@using SbConsole.Plugins.ServiceBus.Client
@using SbConsole.Plugins.ServiceBus.Messages
@using SbConsole.Sdk
@inject PeekMessagesQueryHandler PeekHandler
@inject ResubmitDeadLetterMessagesCommandHandler ResubmitHandler
@inject PurgeDeadLetterMessagesCommandHandler PurgeHandler
@inject IConfirmationService Confirmation
@inject ISnackbar Snackbar

<PageTitle>@(DeadLetter ? "Dead-letter" : "Peek") — @QueueName</PageTitle>
<h1>@(DeadLetter ? "Dead-letter" : "Peek"): @QueueName</h1>

@if (DeadLetter)
{
    <div class="d-flex gap-2 mb-2">
        <MudButton Class="resubmit-selected" Disabled="@(_selectedSequenceNumbers.Count == 0)" OnClick="ResubmitSelectedAsync">
            Resubmit selected (@_selectedSequenceNumbers.Count)
        </MudButton>
        <MudButton Class="purge-queue" Color="Color.Error" OnClick="PurgeAsync">Purge queue</MudButton>
    </div>
}

<MudGrid>
    <MudItem xs="5">
        @foreach (var message in _messages)
        {
            <div class="d-flex align-center gap-2">
                @if (DeadLetter)
                {
                    <input type="checkbox" class="select-message"
                           checked="@_selectedSequenceNumbers.Contains(message.SequenceNumber)"
                           @onchange="@(e => ToggleSelection(message.SequenceNumber, (bool)e.Value!))" />
                }
                <MudButton OnClick="@(() => _selected = message)">
                    #@message.SequenceNumber · @message.EnqueuedTime.ToLocalTime() · deliveries @message.DeliveryCount
                </MudButton>
            </div>
        }
    </MudItem>
    <MudItem xs="7">
        @if (_selected is not null)
        {
            @if (_selected.DeadLetterReason is { } reason)
            {
                <MudAlert Severity="Severity.Warning">@reason — @_selected.DeadLetterErrorDescription</MudAlert>
            }
            <MudText Typo="Typo.subtitle2">@_selected.ContentType</MudText>
            <pre>@_selected.Body</pre>
            <MudText Typo="Typo.subtitle2" Class="mt-4">Application properties</MudText>
            <MudTable Items="_selected.Properties">
                <HeaderContent>
                    <MudTh>Key</MudTh>
                    <MudTh>Value</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Key</MudTd>
                    <MudTd>@context.Value</MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudItem>
</MudGrid>

@code {
    [Parameter] public string QueueName { get; set; } = "";
    [SupplyParameterFromQuery] public Guid ConnectionId { get; set; }
    [SupplyParameterFromQuery] public bool DeadLetter { get; set; }
    [SupplyParameterFromQuery] public long? DeadLetterCount { get; set; }

    [Inject] private IConnectionProvider Connections { get; set; } = default!;

    private IReadOnlyList<PeekedMessage> _messages = [];
    private PeekedMessage? _selected;
    private readonly HashSet<long> _selectedSequenceNumbers = [];
    private (Guid ConnectionId, string QueueName, bool DeadLetter)? _lastLoaded;

    // ConnectionName and IsProd used to be [SupplyParameterFromQuery], but that made the
    // prod-purge typed-confirmation gate trivially bypassable: a client (or a hand-typed URL)
    // could simply omit isProd and silently downgrade a prod dead-letter purge to a plain
    // two-button confirm. IsProd/Name are security-relevant, so they're looked up from the
    // real connection record instead of trusted off the URL -- ConnectionId/DeadLetter stay as
    // query parameters since they're not security-relevant the same way.
    private ConnectionInfo? _connection;

    // Blazor reuses this component instance across same-route navigations (e.g. flipping
    // DeadLetter or ConnectionId in the query string while QueueName stays the same), so
    // OnInitializedAsync only runs once per instance and would leave the message list stale.
    // OnParametersSetAsync runs on every such navigation, so the reload lives here instead --
    // guarded against re-running on renders that don't actually change these parameters.
    protected override async Task OnParametersSetAsync()
    {
        var current = (ConnectionId, QueueName, DeadLetter);
        if (_lastLoaded == current)
        {
            return;
        }

        _lastLoaded = current;
        var connections = await Connections.ListAsync("azure-servicebus");
        _connection = connections.FirstOrDefault(c => c.Id == ConnectionId);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await PeekHandler.HandleAsync(ConnectionId, QueueName, DeadLetter);
        _selectedSequenceNumbers.Clear();
        if (result.IsSuccess)
        {
            _messages = result.Value!;
            _selected = _messages.FirstOrDefault();
        }
        else
        {
            _messages = [];
            _selected = null;
            Snackbar.Add(result.Error!, Severity.Error);
        }
    }

    private void ToggleSelection(long sequenceNumber, bool selected)
    {
        if (selected)
        {
            _selectedSequenceNumbers.Add(sequenceNumber);
        }
        else
        {
            _selectedSequenceNumbers.Remove(sequenceNumber);
        }
    }

    private async Task ResubmitSelectedAsync()
    {
        var requested = _selectedSequenceNumbers.Count;
        var result = await ResubmitHandler.HandleAsync(new ResubmitDeadLetterMessagesCommand(ConnectionId, _connection?.Name ?? "", QueueName, [.. _selectedSequenceNumbers]));
        if (result.IsSuccess)
        {
            Snackbar.Add($"{result.Value} of {requested} resubmitted", Severity.Success);
        }
        else
        {
            Snackbar.Add(result.Error!, Severity.Error);
        }

        await LoadAsync();
    }

    private async Task PurgeAsync()
    {
        // DeadLetterCount comes from the Queues page's per-row live count (Fix D): _messages.Count
        // is capped at the peek page size (32), so it would badly understate the confirmation
        // prompt's "this will purge N item(s)" warning on a large dead-letter queue. It's only a
        // display number -- unlike IsProd below, which must come from the trusted connection
        // record rather than the URL, this one being slightly stale by click time is fine.
        var count = DeadLetterCount.HasValue ? (int)DeadLetterCount.Value : _messages.Count;
        var confirmed = await Confirmation.ConfirmAsync("Purge", QueueName, _connection?.IsProd ?? false, count: count);
        if (!confirmed)
        {
            return;
        }

        var result = await PurgeHandler.HandleAsync(new PurgeDeadLetterMessagesCommand(ConnectionId, _connection?.Name ?? "", QueueName));
        if (!result.IsSuccess)
        {
            Snackbar.Add(result.Error!, Severity.Error);
        }

        await LoadAsync();
    }
}
