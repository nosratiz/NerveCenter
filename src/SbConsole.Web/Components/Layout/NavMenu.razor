@inject PluginRegistry Registry
@inject IConnectionProvider Connections
@inject ILogger<NavMenu> Logger
@implements IDisposable

<MudNavMenu Color="Color.Primary" Rounded="true">
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
    <MudNavLink Href="/connections" Icon="@Icons.Material.Filled.Cable">Connections</MudNavLink>
    <MudNavLink Href="/audit" Icon="@Icons.Material.Filled.History">Audit</MudNavLink>
    <MudNavLink Href="/plugins" Icon="@Icons.Material.Filled.Extension">Plugins</MudNavLink>
    <MudNavLink Href="/settings" Icon="@Icons.Material.Filled.Settings">Settings</MudNavLink>

    @foreach (var plugin in Registry.Plugins)
    {
        @* A plain section label instead of a collapsible MudNavGroup: with one plugin there is
           nothing worth hiding, so a permanently-expanded, always-clickable group just adds an
           extra (pointless) toggle interaction. Matches the mockup's own flat-sections call for
           up to three plugins (docs/design.md). *@
        <MudDivider Class="my-2 mx-4" />
        <MudText Typo="Typo.overline" Class="nav-section-label px-4 mud-text-secondary">@plugin.DisplayName</MudText>
        @foreach (var item in plugin.NavItems)
        {
            <MudNavLink Href="@item.Href" Icon="@(item.Icon ?? Icons.Material.Filled.Extension)">
                @item.Title
                @if (_badges.TryGetValue(item.Href, out var count) && count > 0)
                {
                    <span class="nav-badge" style="margin-left:6px;font:600 10px monospace;padding:1px 6px;border-radius:9px;background:var(--mud-palette-error);color:#fff">@count</span>
                }
            </MudNavLink>
        }
    }
</MudNavMenu>

@code {
    private readonly Dictionary<string, int> _badges = new();
    private readonly CancellationTokenSource _cts = new();

    // Fire-and-forget: never awaited from a lifecycle method, so the very first render of any page
    // (this component is part of the persistent layout, not re-created per page) is never blocked
    // on a Service Bus or database call (docs/design.md §5).
    protected override void OnInitialized()
    {
        _ = RefreshLoopAsync(_cts.Token);
    }

    private async Task RefreshLoopAsync(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            try
            {
                await RefreshBadgesAsync(ct);
            }
            catch (Exception ex)
            {
                // Best-effort: a failed refresh tick leaves the last-known badges in place and
                // tries again next tick, rather than tearing down the nav menu. Logged so a
                // systematic failure (a plugin that always throws, or Registry.Plugins /
                // Connections.ListAsync itself failing) leaves at least one diagnosable trace
                // instead of badges silently freezing for the life of the circuit.
                Logger.LogWarning(ex, "Refreshing plugin nav badges failed for this tick; keeping the last-known badges.");
            }

            try
            {
                await Task.Delay(TimeSpan.FromSeconds(60), ct);
            }
            catch (OperationCanceledException)
            {
                break;
            }
        }
    }

    // Public so tests can call one refresh directly instead of waiting on the real loop/timer
    // (docs/design.md §8) -- the loop above is just this method plus a delay, in a while loop.
    public async Task RefreshBadgesAsync(CancellationToken ct = default)
    {
        foreach (var plugin in Registry.Plugins)
        {
            var connections = await Connections.ListAsync(plugin.ConnectionKind, ct);
            foreach (var navItem in plugin.NavItems)
            {
                int? total = null;
                foreach (var connection in connections)
                {
                    int? count;
                    try
                    {
                        // GetSecretAsync inside the try, not before it: ISecretProtector.Unprotect
                        // throws for a corrupt or wrong-key ciphertext, and a throw here would
                        // escape before any later connection or plugin is reached in this tick.
                        // Since the bad connection is hit first on every subsequent tick too, that
                        // silently froze ALL badges for ALL plugins for the life of the circuit.
                        var secret = await Connections.GetSecretAsync(connection.Id, ct);
                        if (secret is null)
                        {
                            continue;
                        }

                        count = await plugin.GetNavBadgeAsync(navItem.Href, secret, ct);
                    }
                    catch (Exception ex)
                    {
                        Logger.LogDebug(ex, "Computing the {Href} badge for connection {ConnectionId} failed; skipping it for this tick.", navItem.Href, connection.Id);
                        continue;
                    }

                    if (count is { } c)
                    {
                        total = (total ?? 0) + c;
                    }
                }

                if (total is { } t)
                {
                    _badges[navItem.Href] = t;
                }
                else
                {
                    _badges.Remove(navItem.Href);
                }
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    // Dispose the CTS as well as cancelling it: the loop's own catch (OperationCanceledException)
    // { break; } guarantees it has stopped observing _cts.Token by the time this returns, so
    // disposing here can't race an in-flight token registration.
    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
