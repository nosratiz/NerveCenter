@inject PluginRegistry Registry
@inject IConnectionProvider Connections
@inject NavigationManager Nav
@inject ILogger<NavMenu> Logger
@implements IDisposable

@* Icon rail + contextual drawer (mockup "SbConsole Navigation" option 1a): the rail holds the
   console's own pages and one monogram per plugin, and never grows past one icon per plugin; only
   the selected plugin's pages and connections are expanded, in the drawer beside it. Badges from
   plugins not shown in the drawer still surface as a dot on their rail icon. *@
<nav class="nav-shell">
    <div class="nav-rail">
        <a href="/" class="nav-rail-logo" title="SbConsole" aria-label="SbConsole"><span class="nav-logo-mark"></span></a>
        <NavLink class="nav-rail-item" href="/" Match="NavLinkMatch.All" title="Dashboard" aria-label="Dashboard"><MudIcon Icon="@Icons.Material.Outlined.Dashboard" Size="Size.Small" /></NavLink>
        <NavLink class="nav-rail-item" href="/connections" title="Connections" aria-label="Connections"><MudIcon Icon="@Icons.Material.Outlined.Cable" Size="Size.Small" /></NavLink>
        <NavLink class="nav-rail-item" href="/audit" title="Audit" aria-label="Audit"><MudIcon Icon="@Icons.Material.Outlined.History" Size="Size.Small" /></NavLink>
        <div class="nav-rail-sep"></div>

        @foreach (var plugin in Registry.Plugins)
        {
            var isCurrent = plugin.Id == PluginIdFromUrl();
            var showDot = PluginHasBadge(plugin) && !(_drawerOpen && plugin.Id == SelectedPlugin?.Id);
            <a href="@EntryHref(plugin)" class="nav-rail-plugin @(isCurrent ? "active" : null)" title="@plugin.DisplayName" aria-label="@plugin.DisplayName">
                @MonogramOf(plugin)
                @if (showDot)
                {
                    <span class="nav-rail-dot" aria-label="needs attention"></span>
                }
            </a>
        }
        <NavLink class="nav-rail-item nav-rail-add" href="/plugins" title="Plugins" aria-label="Plugins"><MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" /></NavLink>

        <div class="nav-rail-bottom">
            <NavLink class="nav-rail-item" href="/settings" title="Settings" aria-label="Settings"><MudIcon Icon="@Icons.Material.Outlined.Settings" Size="Size.Small" /></NavLink>
            <button type="button" class="nav-rail-item nav-drawer-toggle" @onclick="ToggleDrawer"
                    title="@(_drawerOpen ? "Collapse sidebar" : "Expand sidebar")" aria-label="@(_drawerOpen ? "Collapse sidebar" : "Expand sidebar")" aria-expanded="@(_drawerOpen ? "true" : "false")">
                <MudIcon Icon="@(_drawerOpen ? Icons.Material.Filled.KeyboardDoubleArrowLeft : Icons.Material.Filled.KeyboardDoubleArrowRight)" Size="Size.Small" />
            </button>
        </div>
    </div>

    @if (_drawerOpen && SelectedPlugin is { } selected)
    {
        <div class="nav-drawer">
            <div class="nav-drawer-head">
                <span class="nav-drawer-title">@selected.DisplayName</span>
                <span class="nav-drawer-version">@selected.Version</span>
            </div>
            <div class="nav-drawer-list">
                @foreach (var item in selected.NavItems)
                {
                    <NavLink class="nav-drawer-item" href="@item.Href">
                        <MudIcon Icon="@(item.Icon ?? Icons.Material.Outlined.Folder)" Size="Size.Small" />
                        <span class="nav-drawer-item-title">@item.Title</span>
                        @if (_badges.TryGetValue(item.Href, out var count) && count > 0)
                        {
                            <span class="nav-badge">@count</span>
                        }
                    </NavLink>
                }
            </div>

            <div class="nav-drawer-sep"></div>
            <div class="nav-section-label">Connections</div>
            <div class="nav-drawer-list">
                @if (_connections.TryGetValue(selected.Id, out var connections) && connections.Count > 0)
                {
                    @foreach (var connection in connections)
                    {
                        <a href="/connections" class="nav-connection" title="@StatusTitle(connection)">
                            <span class="nav-status-dot @StatusClass(connection)"></span>@connection.Name
                        </a>
                    }
                }
                else
                {
                    <a href="/connections" class="nav-connection nav-connection-empty">Add a connection</a>
                }
            </div>
        </div>
    }
</nav>

@code {
    private readonly Dictionary<string, int> _badges = new();
    private readonly Dictionary<string, IReadOnlyList<ConnectionInfo>> _connections = new();
    private readonly CancellationTokenSource _cts = new();
    private bool _drawerOpen = true;

    // The plugin shown in the drawer: the one owning the current URL, or -- on a host page such as
    // Dashboard or Audit -- whichever was shown last, so leaving a plugin doesn't blank the drawer.
    private string? _selectedPluginId;

    private IPlugin? SelectedPlugin =>
        Registry.Plugins.FirstOrDefault(p => p.Id == _selectedPluginId) ?? Registry.Plugins.FirstOrDefault();

    // Fire-and-forget: never awaited from a lifecycle method, so the very first render of any page
    // (this component is part of the persistent layout, not re-created per page) is never blocked
    // on a Service Bus or database call (docs/design.md §5).
    protected override void OnInitialized()
    {
        _selectedPluginId = PluginIdFromUrl();
        Nav.LocationChanged += OnLocationChanged;
        _ = RefreshLoopAsync(_cts.Token);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _selectedPluginId = PluginIdFromUrl() ?? _selectedPluginId;
        _ = InvokeAsync(StateHasChanged);
    }

    // Plugin pages mount at /p/{pluginId}/... (docs/design.md), so the URL alone says which plugin
    // owns the current page.
    private string? PluginIdFromUrl()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0];
        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
        if (segments.Length < 2 || segments[0] != "p")
        {
            return null;
        }

        return Registry.Plugins.FirstOrDefault(p => p.Id == segments[1])?.Id;
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private static string EntryHref(IPlugin plugin) =>
        plugin.NavItems.Count > 0 ? plugin.NavItems[0].Href : $"/p/{plugin.Id}";

    private static string MonogramOf(IPlugin plugin) => PluginMonogram.Of(plugin);

    private bool PluginHasBadge(IPlugin plugin) =>
        plugin.NavItems.Any(item => _badges.TryGetValue(item.Href, out var count) && count > 0);

    private static string StatusClass(ConnectionInfo connection) => connection.LastTestSucceeded switch
    {
        true => "ok",
        false => "bad",
        null => "unknown",
    };

    private static string StatusTitle(ConnectionInfo connection) => connection.LastTestSucceeded switch
    {
        true => "Last test succeeded",
        false => "Last test failed",
        null => "Not tested yet",
    };

    private async Task RefreshLoopAsync(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            try
            {
                await RefreshBadgesAsync(ct);
            }
            catch (Exception ex)
            {
                // Best-effort: a failed refresh tick leaves the last-known badges in place and
                // tries again next tick, rather than tearing down the nav menu. Logged so a
                // systematic failure (a plugin that always throws, or Registry.Plugins /
                // Connections.ListAsync itself failing) leaves at least one diagnosable trace
                // instead of badges silently freezing for the life of the circuit.
                Logger.LogWarning(ex, "Refreshing plugin nav badges failed for this tick; keeping the last-known badges.");
            }

            try
            {
                await Task.Delay(TimeSpan.FromSeconds(60), ct);
            }
            catch (OperationCanceledException)
            {
                break;
            }
        }
    }

    // Public so tests can call one refresh directly instead of waiting on the real loop/timer
    // (docs/design.md §8) -- the loop above is just this method plus a delay, in a while loop.
    public async Task RefreshBadgesAsync(CancellationToken ct = default)
    {
        // Connection lists first, rendered straight away: they're one local DB read each, while
        // the badge calls below talk to every broker and can take seconds per unreachable one --
        // the drawer's Connections section shouldn't wait on those.
        foreach (var plugin in Registry.Plugins)
        {
            _connections[plugin.Id] = await Connections.ListAsync(plugin.ConnectionKind, ct);
        }

        await InvokeAsync(StateHasChanged);

        foreach (var plugin in Registry.Plugins)
        {
            var connections = _connections[plugin.Id];
            foreach (var navItem in plugin.NavItems)
            {
                int? total = null;
                foreach (var connection in connections)
                {
                    int? count;
                    try
                    {
                        // GetSecretAsync inside the try, not before it: ISecretProtector.Unprotect
                        // throws for a corrupt or wrong-key ciphertext, and a throw here would
                        // escape before any later connection or plugin is reached in this tick.
                        // Since the bad connection is hit first on every subsequent tick too, that
                        // silently froze ALL badges for ALL plugins for the life of the circuit.
                        var secret = await Connections.GetSecretAsync(connection.Id, ct);
                        if (secret is null)
                        {
                            continue;
                        }

                        count = await plugin.GetNavBadgeAsync(navItem.Href, secret, ct);
                    }
                    catch (Exception ex)
                    {
                        Logger.LogDebug(ex, "Computing the {Href} badge for connection {ConnectionId} failed; skipping it for this tick.", navItem.Href, connection.Id);
                        continue;
                    }

                    if (count is { } c)
                    {
                        total = (total ?? 0) + c;
                    }
                }

                if (total is { } t)
                {
                    _badges[navItem.Href] = t;
                }
                else
                {
                    _badges.Remove(navItem.Href);
                }
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    // Dispose the CTS as well as cancelling it: the loop's own catch (OperationCanceledException)
    // { break; } guarantees it has stopped observing _cts.Token by the time this returns, so
    // disposing here can't race an in-flight token registration.
    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        _cts.Cancel();
        _cts.Dispose();
    }
}
