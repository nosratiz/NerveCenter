@inherits LayoutComponentBase
@using SbConsole.Web.Theming

<ThemedRoot>
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    <MudLayout>
        <MudAppBar Elevation="1">
            <MudText Typo="Typo.h6">SbConsole</MudText>
        </MudAppBar>
        <MudDrawer Open="true" Elevation="1">
            <NavMenu />
        </MudDrawer>
        <MudMainContent Class="page-content">
            @Body
        </MudMainContent>
    </MudLayout>
</ThemedRoot>
