@inherits LayoutComponentBase
@using SbConsole.Web.Theming

<ThemedRoot>
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    @* A plain flex shell rather than MudLayout/MudAppBar/MudDrawer: the icon-rail navigation
       (mockup "SbConsole Navigation" 1a) carries the logo and its own collapse toggle, so there is
       no top app bar, and NavMenu owns both of its columns' widths. *@
    <div class="app-shell">
        <NavMenu />
        <main class="page-content">
            @Body
        </main>
    </div>
</ThemedRoot>
