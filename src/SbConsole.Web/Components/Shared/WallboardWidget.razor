@* src/SbConsole.Web/Components/Shared/WallboardWidget.razor *@
@using System.Globalization
@using SbConsole.Web.Wallboard
@inject WallboardSnapshotLoader SnapshotLoader
@inject TimeProvider Clock

@* The Dashboard's "Backlog" card (mockup "SbConsole Dashboard" 1a): the full /wallboard page's
   tiles and 1h trend condensed into one side-column card, with the same outage rule. *@
<section class="dash-card wallboard-widget" aria-label="Backlog">
    <div class="dash-card-head">
        <h2 class="dash-section-title">Backlog</h2>
        <span class="dash-card-meta">1h</span>
    </div>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else
    {
        <div class="backlog-stats">
            <div class="backlog-stat tile-active">
                <span class="backlog-label">Active</span>
                <span class="backlog-value">@_activeCount.ToString("N0", CultureInfo.InvariantCulture)</span>
                <span class="backlog-sub">@(_activeDeltaLastMinute >= 0 ? "+" : "")@_activeDeltaLastMinute / min</span>
            </div>
            <div class="backlog-stat tile-dead-lettered">
                <span class="backlog-label">Dead-lettered</span>
                <span class="backlog-value @(_deadLetterTotal > 0 ? "bad" : null)">@_deadLetterTotal.ToString("N0", CultureInfo.InvariantCulture)</span>
                <span class="backlog-sub @(_deadLetterDeltaLastHour > 0 ? "warn" : null)">@DeadLetterDeltaLabel</span>
            </div>
            <div class="backlog-stat tile-oldest">
                <span class="backlog-label">Oldest</span>
                @if (_oldestDeadLetter is { } oldest)
                {
                    <span class="backlog-value">@FormatAge(Clock.GetUtcNow() - oldest.EnqueuedTime)</span>
                    <span class="backlog-sub" title="@oldest.ResourceName · @oldest.DeadLetterCount msgs">@oldest.ResourceName</span>
                }
                else
                {
                    <span class="backlog-value">—</span>
                }
            </div>
        </div>

        @if (_buckets1h.Count >= 2)
        {
            <svg class="backlog-spark" viewBox="0 0 @ChartWidth @ChartHeight" preserveAspectRatio="none" aria-hidden="true">
                <polyline class="spark-active" points="@Points(b => b.TotalActive)"></polyline>
                <polyline class="spark-dead" points="@Points(b => b.TotalDeadLetter)"></polyline>
                @foreach (var position in WallboardAggregator.OutageMarkerPositions(_outageEvents, _buckets1h))
                {
                    var x = Format(position * ChartWidth);
                    <line class="spark-outage" x1="@x" y1="0" x2="@x" y2="@ChartHeight"></line>
                }
            </svg>
            <div class="backlog-axis">
                <span>@_buckets1h[0].At.ToLocalTime().ToString("HH:mm")</span>
                <span>@_buckets1h[^1].At.ToLocalTime().ToString("HH:mm")</span>
            </div>
        }

        @if (!string.IsNullOrEmpty(_growthSummary))
        {
            <div class="backlog-summary">@_growthSummary</div>
        }
        <a href="/wallboard" class="dash-card-link open-full-wallboard">Open full wallboard →</a>
    }
</section>

@code {
    private const double ChartWidth = 292;
    private const double ChartHeight = 56;

    private bool _loading = true;
    private long _activeCount;
    private long _activeDeltaLastMinute;
    private long _deadLetterTotal;
    private long? _deadLetterDeltaLastHour;
    private OldestDeadLetterEntry? _oldestDeadLetter;
    private string _growthSummary = "";
    private IReadOnlyList<DateTimeOffset> _outageEvents = [];
    private IReadOnlyList<WallboardAggregator.Bucket> _buckets1h = [];

    private string DeadLetterDeltaLabel =>
        _deadLetterDeltaLastHour is { } delta ? $"{(delta >= 0 ? "+" : "")}{delta} / 1h" : "— / 1h";

    // Each series is scaled to its own range: active counts are typically orders of magnitude
    // above dead-lettered ones, and on a shared axis the dead-letter line would sit flat at zero.
    // This is a sparkline -- the shape matters, the exact numbers are in the stats above.
    private string Points(Func<WallboardAggregator.Bucket, long> value)
    {
        var values = _buckets1h.Select(value).ToList();
        var min = values.Min();
        var range = Math.Max(1, values.Max() - min);
        const double pad = 4;
        return string.Join(" ", values.Select((v, i) =>
            $"{Format(i * ChartWidth / (values.Count - 1))},{Format(ChartHeight - pad - (v - min) * (ChartHeight - 2 * pad) / range)}"));
    }

    private static string Format(double value) => value.ToString("0.#", CultureInfo.InvariantCulture);

    private static string FormatAge(TimeSpan age) =>
        age.TotalHours >= 1 ? $"{(int)age.TotalHours}h {age.Minutes}m" : $"{age.Minutes}m";

    protected override async Task OnInitializedAsync()
    {
        var snapshot = await SnapshotLoader.LoadAsync();
        _activeCount = snapshot.ActiveCount;
        _activeDeltaLastMinute = snapshot.ActiveDeltaLastMinute;
        _deadLetterTotal = snapshot.DeadLetterTotal;
        _deadLetterDeltaLastHour = snapshot.DeadLetterDeltaLastHour;
        _oldestDeadLetter = snapshot.OldestDeadLetter;
        _growthSummary = snapshot.GrowthSummary;
        _outageEvents = snapshot.OutageEvents;
        _buckets1h = snapshot.Buckets1h;
        _loading = false;
    }
}
