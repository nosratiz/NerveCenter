{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "http://localhost:5249",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "SBC_DATA_KEY": "<base64-encoded 32-byte key>",
        "SBC_DB_PATH": "sbconsole.dev.db",
        "SBC_ADMIN_PASSWORD": "<dev admin password>",
        "SBC_API_KEY": "<dev api key>",
        "SBC_BIND": "http://localhost:5249",
        "SBC_SQLITE_ROOTS": "<absolute dir(s) holding SQLite files, ';'-separated -- e.g. the .sqlite-demo dir from docker/README.md>"
      }
    },
    "https": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "https://localhost:7018;http://localhost:5249",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "SBC_DATA_KEY": "<base64-encoded 32-byte key>",
        "SBC_DB_PATH": "sbconsole.dev.db",
        "SBC_ADMIN_PASSWORD": "<dev admin password>",
        "SBC_API_KEY": "<dev api key>",
        "SBC_BIND": "https://localhost:7018;http://localhost:5249",
        "SBC_SQLITE_ROOTS": "<absolute dir(s) holding SQLite files, ';'-separated -- e.g. the .sqlite-demo dir from docker/README.md>"
      }
    }
  }
}
