<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\SbConsole.Core\SbConsole.Core.csproj" />
    <ProjectReference Include="..\SbConsole.Sdk\SbConsole.Sdk.csproj" />
    <ProjectReference Include="..\Plugins\SbConsole.Plugins.ServiceBus\SbConsole.Plugins.ServiceBus.csproj" />
    <ProjectReference Include="..\Plugins\SbConsole.Plugins.Kafka\SbConsole.Plugins.Kafka.csproj" />
    <ProjectReference Include="..\Plugins\SbConsole.Plugins.Aws\SbConsole.Plugins.Aws.csproj" />
    <ProjectReference Include="..\Plugins\SbConsole.Plugins.RabbitMq\SbConsole.Plugins.RabbitMq.csproj" />
    <ProjectReference Include="..\Plugins\SbConsole.Plugins.Redis\SbConsole.Plugins.Redis.csproj" />
    <ProjectReference Include="..\Plugins\SbConsole.Plugins.Postgres\SbConsole.Plugins.Postgres.csproj" />
    <ProjectReference Include="..\Plugins\SbConsole.Plugins.Sqlite\SbConsole.Plugins.Sqlite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="9.9.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- The Web SDK only infers this from .razor files it can see at restore time. The Dockerfile
         restores from project files alone (before COPY src/), so without it the image ships with no
         _framework/blazor.web.js and no page ever goes interactive. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

</Project>
