  "policies": [
    {
      "vhost": "/orders",
      "name": "orders-limits",
      "pattern": "^order-events",
      "apply-to": "queues",
      "priority": 10,
      "definition": {
        "max-length": 500000,
        "overflow": "reject-publish"
      }
    },
    {
      "vhost": "/orders",
      "name": "dlq-ttl",
      "pattern": "-dlq$",
      "apply-to": "queues",
      "priority": 5,
      "definition": {
        "message-ttl": 604800000
      }
    },
    {
      "vhost": "/orders",
      "name": "retry-shortttl",
      "pattern": "\\.retry$",
      "apply-to": "queues",
      "priority": 5,
      "definition": {
        "message-ttl": 30000,
        "dead-letter-exchange": "billing.direct"
      }
    }
  ],
  "parameters": [
    {
      "vhost": "/orders",
      "component": "shovel",
      "name": "legacy-migrate",
      "value": {
        "src-protocol": "amqp091",
        "src-uri": "amqp:///%2Forders",
        "src-queue": "legacy.import.q",
        "dest-protocol": "amqp091",
        "dest-uri": "amqp:///%2Forders",
        "dest-exchange": "order-events",
        "dest-exchange-key": "order.legacy.created",
        "ack-mode": "on-confirm",
        "src-delete-after": "never"
      }
    },
    {
      "vhost": "/orders",
      "component": "shovel",
      "name": "billing-retry-loop",
      "value": {
        "src-protocol": "amqp091",
        "src-uri": "amqp:///%2Forders",
        "src-queue": "billing.retry",
        "dest-protocol": "amqp091",
        "dest-uri": "amqp://rabbit-eu-dr.invalid:5672",
        "dest-exchange": "billing.direct",
        "ack-mode": "on-confirm",
        "src-delete-after": "never",
        "reconnect-delay": 30
      }
    }
