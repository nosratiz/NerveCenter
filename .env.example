# Copy to .env (git-ignored) and adjust. Only the `app` profile needs the SBC_* values.

# --- host ports -------------------------------------------------------------------------
KAFKA_HOST_PORT=9092
KAFKA_UI_PORT=8080
SERVICEBUS_AMQP_PORT=5672
# Management API. The Azure SDK's admin client uses port 80 when the connection string names
# no port, and the app's connection string must name no port for AMQP to work -- so moving
# this off 80 makes the Service Bus plugin's management pages fail against the emulator.
SERVICEBUS_HTTP_PORT=80
SBC_HOST_PORT=5249

# --- servicebus profile -----------------------------------------------------------------
# SQL Server complexity rules: 8+ chars, upper + lower + digit + symbol.
MSSQL_SA_PASSWORD=SbEmulator!Local1

# --- app profile (SbConsole in a container) ---------------------------------------------
# Generate a key with:  openssl rand -base64 32
SBC_DATA_KEY=
SBC_ADMIN_PASSWORD=
SBC_API_KEY=
